      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Single list of every remote. The server creates them; the client only waits.

export type RemoteName = "DroneAction" | "SetLoadout" | "Recall" | "Feedback" | "SelectSite"

local NAMES: { RemoteName } = { "DroneAction", "SetLoadout", "Recall", "Feedback", "SelectSite" }

return table.freeze({ Names = NAMES })
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions for the drone simulator.

-- "Sensor" | "Arm" | "DataJack" | "Payload"
export type ModuleId = string
-- "A" | "B"
export type Hardpoint = string
-- "Normal" | "Thermal" | "Night" | "Chem" | "Lidar"
export type CameraMode = string
-- "Primary" | "Secondary"
export type ActionKind = string

export type Severity = "info" | "warning" | "danger" | "success" | "data"

export type Feedback = {
	title: string,
	text: string,
	severity: Severity,
}

export type ModuleSpec = {
	label: string,
	short: string,
	description: string,
	color: Color3,
}

export type DeviceSpec = {
	label: string,
	prefix: string,
	category: string, -- Infrastructure | Network | Directorate | Medical | Life
}

export type GasSpec = {
	label: string,
	unit: string,
	danger: number, -- above this, lethal or harmful for humans
	color: Color3,
}

export type LinkSource = { position: Vector3, range: number }
export type JammerInfo = { position: Vector3, radius: number, factor: number }

export type GasCloud = {
	position: Vector3,
	gas: string,
	peak: number,
	radius: number,
	scale: number,
}

export type Objective = { key: string, label: string, total: number }
export type ObjectiveGroup = {
	site: string,
	zone: string,
	problems: { number },
	brief: string,
	items: { Objective },
}

export type SiteLighting = {
	brightness: number,
	clockTime: number,
	ambient: Color3,
	outdoorAmbient: Color3,
	density: number,
	haze: number,
	glare: number,
	atmosphereColor: Color3,
	decay: Color3,
	exposure: number,
}

export type SiteSpec = {
	name: string,
	subtitle: string,
	origin: Vector3,
	min: Vector3,
	max: Vector3,
	datum: number,
	lighting: SiteLighting,
}

export type PacketSpec = {
	name: string,
	destination: string,
	objective: string,
	event: string?,
}

export type AirReading = { O2: number, CO2: number, PM: number, Temp: number }

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Devices</string>
            <string name="Source"><![CDATA[--!strict
-- Device lookup and the action table. Shared so the HUD shows exactly the
-- action the server will run: the server resolves the same way, then
-- validates range, line of sight, link and module before acting.

local CollectionService = game:GetService("CollectionService")

local Devices = {}

-- Walks up from any part to the tagged device root (or nil).
function Devices.root(instance: Instance?): Instance?
	local current = instance
	local depth = 0
	while current and depth < 6 do
		if CollectionService:HasTag(current, "Device") then
			return current
		end
		current = current.Parent
		depth += 1
	end
	return nil
end

function Devices.typeOf(device: Instance?): string?
	if not device then
		return nil
	end
	local value = device:GetAttribute("DeviceType")
	return if typeof(value) == "string" then value else nil
end

function Devices.position(device: Instance): Vector3
	if device:IsA("BasePart") then
		return device.Position
	elseif device:IsA("Model") then
		return device:GetPivot().Position
	end
	return Vector3.zero
end

-- Rough radius of a device, used as range slack.
function Devices.extent(device: Instance): number
	if device:IsA("BasePart") then
		return math.min(device.Size.Magnitude / 2, 6)
	elseif device:IsA("Model") then
		return math.min(device:GetExtentsSize().Magnitude / 2, 6)
	end
	return 0
end

-- Returns (actionId, label) for a module action against an optional device.
-- `drone` carries state attributes: Holding, Payload, Relays.
function Devices.resolve(
	module: string?,
	kind: string,
	deviceType: string?,
	drone: Instance
): (string?, string?)
	local holding = drone:GetAttribute("Holding") == true
	local loaded = drone:GetAttribute("Payload") == true
	local relays = drone:GetAttribute("Relays")
	local relaysLeft = if typeof(relays) == "number" then relays else 0

	-- Guiding people uses the airframe's own beeper + light: any module
	if deviceType == "Civilian" and kind == "Primary" then
		return "Guide", "Guide (beep + light, follow me)"
	end

	if module == "Arm" and kind == "Primary" then
		if holding then
			return "Release", "Release debris"
		elseif deviceType == "Valve" then
			return "TurnValve", "Turn valve"
		elseif deviceType == "Debris" then
			return "Grab", "Grab debris"
		elseif deviceType == "Breaker" then
			return "FlipBreaker", "Flip breaker"
		elseif deviceType == "Jammer" then
			return "CutCable", "Cut power cable"
		end
	elseif module == "Sensor" and kind == "Primary" then
		if deviceType == "SamplePoint" then
			return "SampleWater", "Sample water"
		elseif deviceType == "Resident" or deviceType == "HeatSource" then
			return "ReadVitals", "Read vitals"
		elseif deviceType == "Equipment" then
			return "Inspect", "Run diagnostics"
		end
		return "SampleAir", "Sample air"
	elseif module == "DataJack" then
		if kind == "Primary" then
			if deviceType == "Terminal" then
				return "JackIn", "Jack in"
			elseif deviceType == "Beacon" then
				return "PingBeacon", "Ping beacon"
			end
		else
			if deviceType == "RelayNode" then
				return "RetrieveRelay", "Retrieve relay"
			elseif relaysLeft > 0 then
				return "DeployRelay", ("Deploy relay (%d left)"):format(relaysLeft)
			end
		end
	elseif module == "Payload" and kind == "Primary" then
		if deviceType == "MedRack" and not loaded then
			return "LoadMed", "Load med kit"
		elseif loaded then
			return "DropMed", "Drop med kit"
		end
	end
	return nil, nil
end

return Devices
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Gas</string>
            <string name="Source"><![CDATA[--!strict
-- Gas concentration at a point from the tagged gas clouds (linear falloff).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)

local Gas = {}

function Gas.gather(): { Types.GasCloud }
	local clouds: { Types.GasCloud } = {}
	for _, instance in CollectionService:GetTagged("GasCloud") do
		if instance:IsA("BasePart") then
			local gas = instance:GetAttribute("Gas")
			local peak = instance:GetAttribute("Peak")
			local radius = instance:GetAttribute("Radius")
			local scale = instance:GetAttribute("Scale")
			if
				typeof(gas) == "string"
				and typeof(peak) == "number"
				and typeof(radius) == "number"
			then
				table.insert(clouds, {
					position = instance.Position,
					gas = gas,
					peak = peak,
					radius = radius,
					scale = if typeof(scale) == "number" then scale else 1,
				})
			end
		end
	end
	return clouds
end

function Gas.at(position: Vector3, clouds: { Types.GasCloud }): { [string]: number }
	local readings: { [string]: number } = {}
	for _, cloud in clouds do
		local radius = cloud.radius * cloud.scale
		if radius > 0.1 then
			local distance = (position - cloud.position).Magnitude
			if distance < radius then
				local value = cloud.peak * cloud.scale * (1 - distance / radius)
				readings[cloud.gas] = (readings[cloud.gas] or 0) + value
			end
		end
	end
	return readings
end

return Gas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Link</string>
            <string name="Source"><![CDATA[--!strict
-- Command-link strength (0..1) from docks, mesh relays and active beacons,
-- crushed near an active Directorate jammer. Server and client run the same
-- math: the client draws static, the server refuses commands when the link is lost.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local Devices = require(script.Parent.Devices)

local Link = {}

function Link.gather(): ({ Types.LinkSource }, { Types.JammerInfo })
	local sources: { Types.LinkSource } = {}
	for _, instance in CollectionService:GetTagged("LinkSource") do
		local range = instance:GetAttribute("LinkRange")
		if typeof(range) == "number" and range > 0 and instance:IsDescendantOf(workspace) then
			table.insert(sources, { position = Devices.position(instance), range = range })
		end
	end
	local jammers: { Types.JammerInfo } = {}
	for _, instance in CollectionService:GetTagged("Jammer") do
		if instance:GetAttribute("Active") == true then
			local radius = instance:GetAttribute("JamRadius")
			local factor = instance:GetAttribute("JamFactor")
			table.insert(jammers, {
				position = Devices.position(instance),
				radius = if typeof(radius) == "number" then radius else Config.LINK.JAMMER_RADIUS,
				factor = if typeof(factor) == "number" then factor else Config.LINK.JAMMER_FACTOR,
			})
		end
	end
	return sources, jammers
end

local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
occlusionParams.RespectCanCollide = true

-- Radio through rock and concrete: the usable range drops when the direct
-- path is blocked. Only solid, collidable geometry counts.
local function blocked(from: Vector3, to: Vector3): boolean
	local drones = Workspace:FindFirstChild("Drones")
	occlusionParams.FilterDescendantsInstances = if drones then { drones } else {}
	local delta = to - from
	if delta.Magnitude < 4 then
		return false
	end
	local hit = Workspace:Raycast(from, delta, occlusionParams)
	return hit ~= nil and (hit.Position - to).Magnitude > 4
end

function Link.strength(
	position: Vector3,
	sources: { Types.LinkSource },
	jammers: { Types.JammerInfo },
	occlusion: boolean?
): number
	local best = 0
	for _, source in sources do
		local distance = (position - source.position).Magnitude
		if distance < source.range then
			local range = source.range
			if
				occlusion ~= false and blocked(position, source.position + Vector3.new(0, 1.5, 0))
			then
				range *= Config.LINK.OCCLUSION
			end
			best = math.max(best, 1 - distance / range)
		end
	end
	for _, jammer in jammers do
		if (position - jammer.position).Magnitude < jammer.radius then
			best *= jammer.factor
		end
	end
	return math.clamp(best, 0, 1)
end

function Link.at(position: Vector3): number
	local sources, jammers = Link.gather()
	return Link.strength(position, sources, jammers)
end

return Link
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal signal for cross-module events (no BindableEvent serialization cost).

export type Signal = {
	connect: (handler: (...any) -> ()) -> () -> (),
	fire: (...any) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { (...any) -> () } = {}

	local function connect(handler: (...any) -> ()): () -> ()
		table.insert(handlers, handler)
		return function()
			local index = table.find(handlers, handler)
			if index then
				table.remove(handlers, index)
			end
		end
	end

	local function fire(...: any)
		for _, handler in table.clone(handlers) do
			task.spawn(handler, ...)
		end
	end

	return { connect = connect, fire = fire }
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Sites</string>
            <string name="Source"><![CDATA[--!strict
-- Which site (Hollow showcase / test range) a point or instance belongs to.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Sites = {}

function Sites.at(position: Vector3): string
	for name, spec in Config.SITES do
		local min, max = spec.min, spec.max
		if
			position.X >= min.X
			and position.X <= max.X
			and position.Y >= min.Y
			and position.Y <= max.Y
			and position.Z >= min.Z
			and position.Z <= max.Z
		then
			return name
		end
	end
	return Config.DEFAULT_SITE
end

-- Walks up to the site folder (a Folder with a "Site" attribute).
function Sites.of(instance: Instance): string?
	local current: Instance? = instance
	while current do
		local site = current:GetAttribute("Site")
		if typeof(site) == "string" then
			return site
		end
		current = current.Parent
	end
	return nil
end

-- The groups of objectives that belong to a site, in display order.
function Sites.groups(site: string): { any }
	local out = {}
	for _, group in Config.OBJECTIVES do
		if group.site == site then
			table.insert(out, group)
		end
	end
	return out
end

return Sites
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Units</string>
            <string name="Source"><![CDATA[--!strict
-- Temperature formatting: the feed shows imperial first with metric beside it
-- ("101.3°F (38.5°C)") so judges and medics can both read it at a glance.

local Units = {}

function Units.fahrenheit(celsius: number): number
	return celsius * 9 / 5 + 32
end

-- "101.3°F (38.5°C)"
function Units.temp(celsius: number): string
	return ("%.1f°F (%.1f°C)"):format(Units.fahrenheit(celsius), celsius)
end

-- Whole degrees, for ambient air: "84°F (29°C)"
function Units.tempWhole(celsius: number): string
	return ("%d°F (%d°C)"):format(math.round(Units.fahrenheit(celsius)), math.round(celsius))
end

-- Compact form for small thermal tags: "101.3°F"
function Units.tempShort(celsius: number): string
	return ("%.1f°F"):format(Units.fahrenheit(celsius))
end

return table.freeze(Units)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Hollow Drone server entry point. Two-phase bootstrap: init() every system,
-- then start() every system, so no system starts running before all are wired.

local Systems = script:FindFirstChild("Systems")

local loaded: { [string]: any } = {}
if Systems then
	for _, child in Systems:GetChildren() do
		if child:IsA("ModuleScript") then
			loaded[child.Name] = require(child) :: any
		end
	end
end

for _, system in loaded do
	if typeof(system.init) == "function" then
		system.init()
	end
end

for _, system in loaded do
	if typeof(system.start) == "function" then
		task.spawn(system.start)
	end
end

print("[HollowDrone] server started")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Characters</string>
          <string name="Source"><![CDATA[--!strict
-- People in the world are real R15 Roblox characters (Humanoid rigs built from
-- a HumanoidDescription) playing Roblox's default animations: idle, walk and
-- sit. They replace the earlier block figures.
--
-- Builders run before their site folder is parented to Workspace, so spawn()
-- only creates the rig; settle() (called once every site is built) snaps each
-- standing person's feet onto the real floor with a raycast, starts their
-- animations and hands walkers to server physics.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Characters = {}

-- Roblox's default R15 animation set (the same ids the stock Animate script uses)
local ANIM = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	sit = "rbxassetid://2506281703",
}

-- Free Roblox-made hair; any that fails to load just gives a bald variant
local HAIR = { "63690008", "451220849", "376548738", "62724852" }

local SKIN = {
	Color3.fromRGB(234, 192, 160),
	Color3.fromRGB(198, 150, 118),
	Color3.fromRGB(160, 112, 80),
	Color3.fromRGB(120, 82, 58),
	Color3.fromRGB(86, 58, 42),
}
local PANTS = {
	Color3.fromRGB(46, 48, 54),
	Color3.fromRGB(58, 66, 84),
	Color3.fromRGB(72, 64, 52),
	Color3.fromRGB(38, 40, 36),
}
local SHOES = Color3.fromRGB(30, 28, 26)

export type Spec = {
	-- "Stand" | "Sit" | "Lie"
	pose: string,
	-- Stand: hip centre, facing (feet are snapped to the floor below it)
	-- Sit:   hip centre on the seat, facing
	-- Lie:   hip centre on the mattress; head toward the cframe's +Z (pillow)
	cf: CFrame,
	shirt: Color3,
	pants: Color3?,
	skin: Color3?,
	-- Walkers stay unanchored and are driven by Humanoid:MoveTo (Guides)
	mobile: boolean?,
}

type Entry = { model: Model, spec: Spec, settled: boolean }

local rng = Random.new(87)
local templates: { Model } = {}
local entries: { Entry } = {}

-- Hip centre to the bottom of the HumanoidRootPart's centre, for poses that
-- aren't snapped (seated / lying); tuned against the default R15 rig.
local SIT_LIFT = 0.9
local LIE_LIFT = 0.15

local function makeTemplate(hair: string?): Model?
	local description = Instance.new("HumanoidDescription")
	if hair then
		description.HairAccessory = hair
	end
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	description:Destroy()
	if not ok or not result then
		return nil
	end
	return result :: Model
end

local function ensureTemplates()
	if #templates > 0 then
		return
	end
	for _, hair in HAIR do
		local model = makeTemplate(hair)
		if model then
			table.insert(templates, model)
		end
	end
	if #templates == 0 then
		local bald = makeTemplate(nil)
		assert(bald, "could not build an R15 character template")
		table.insert(templates, bald)
	end
end

local SHIRT_PARTS = {
	UpperTorso = true,
	LeftUpperArm = true,
	RightUpperArm = true,
	LeftLowerArm = true,
	RightLowerArm = true,
}
local PANTS_PARTS = {
	LowerTorso = true,
	LeftUpperLeg = true,
	RightUpperLeg = true,
	LeftLowerLeg = true,
	RightLowerLeg = true,
}
local SHOE_PARTS = { LeftFoot = true, RightFoot = true }

local function paint(model: Model, spec: Spec)
	local skin = spec.skin or SKIN[rng:NextInteger(1, #SKIN)]
	local pants = spec.pants or PANTS[rng:NextInteger(1, #PANTS)]
	for _, part in model:GetDescendants() do
		if not part:IsA("BasePart") or part.Name == "HumanoidRootPart" then
			continue
		end
		if part.Parent ~= model then
			continue -- accessories keep their own texture
		end
		if SHIRT_PARTS[part.Name] then
			part.Color = spec.shirt
		elseif PANTS_PARTS[part.Name] then
			part.Color = pants
		elseif SHOE_PARTS[part.Name] then
			part.Color = SHOES
		else
			part.Color = skin -- head, hands
		end
	end
	local bodyColors = model:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors:Destroy()
	end
end

local function rootHeight(humanoid: Humanoid, root: BasePart): number
	return humanoid.HipHeight + root.Size.Y / 2
end

-- Creates a person. The model's PrimaryPart is its HumanoidRootPart, so
-- Devices.position / thermal / scanner treat it like any other device model.
function Characters.spawn(parent: Instance, name: string, spec: Spec): Model
	ensureTemplates()
	local model = templates[rng:NextInteger(1, #templates)]:Clone()
	model.Name = name
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	model.PrimaryPart = root

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameDisplayDistance = 0
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.WalkSpeed = Config.DRONE.GUIDE_SPEED
	for _, state in
		{
			Enum.HumanoidStateType.Dead,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.FallingDown,
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Jumping,
		}
	do
		humanoid:SetStateEnabled(state, false)
	end
	paint(model, spec)

	-- Static people are anchored statues that animate; only walkers simulate.
	-- Limbs don't collide (the drone shouldn't snag on fingers); the root box
	-- stands in for the body.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CastShadow = true
			if part ~= root then
				part.CanCollide = false
				part.Massless = true
			end
		end
	end
	root.Anchored = true
	root.CanCollide = spec.mobile == true

	local cf = spec.cf
	if spec.pose == "Lie" then
		-- On the back, head toward the caller's +Z (the pillow), face up
		model:PivotTo(
			cf
				* CFrame.new(0, LIE_LIFT + root.Size.Z / 2 - 0.4, 0)
				* CFrame.Angles(math.pi / 2, 0, 0)
		)
	elseif spec.pose == "Sit" then
		model:PivotTo(cf * CFrame.new(0, SIT_LIFT, 0))
	else
		-- Provisional: hips 1.95 above the feet (the old figure convention)
		local feet = cf.Position - Vector3.new(0, 1.95, 0)
		local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if look.Magnitude < 0.01 then
			look = Vector3.new(0, 0, -1)
		end
		local center = feet + Vector3.new(0, rootHeight(humanoid, root), 0)
		model:PivotTo(CFrame.lookAt(center, center + look.Unit))
	end

	CollectionService:AddTag(model, "NPC")
	model:SetAttribute("Pose", spec.pose)
	model.Parent = parent
	table.insert(entries, { model = model, spec = spec, settled = false })
	return model
end

-- A body temperature (°C) inside the band for a condition, one decimal
function Characters.temperature(condition: string): number
	local band = (Config.VITALS :: any)[condition] or Config.VITALS.Healthy
	return math.round(rng:NextNumber(band[1], band[2]) * 10) / 10
end

-- The part thermal should outline and tag (the chest)
function Characters.chest(model: Model): BasePart
	return (model:FindFirstChild("UpperTorso") or model.PrimaryPart) :: BasePart
end

local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Exclude
floorParams.RespectCanCollide = true

local function load(
	animator: Animator,
	id: string,
	priority: Enum.AnimationPriority
): AnimationTrack
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local track = animator:LoadAnimation(animation)
	track.Priority = priority
	track.Looped = true
	return track
end

local function animate(model: Model, spec: Spec)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local existing = humanoid:FindFirstChildOfClass("Animator")
	local animator: Animator
	if existing then
		animator = existing
	else
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local ok = pcall(function()
		local a = animator
		if spec.pose == "Sit" then
			load(a, ANIM.sit, Enum.AnimationPriority.Core):Play(0)
			return
		end
		local idle = load(a, ANIM.idle, Enum.AnimationPriority.Idle)
		-- Desynchronise the crowd so nobody breathes in unison
		idle:Play(0, 1, if spec.pose == "Lie" then 0.55 else rng:NextNumber(0.85, 1.1))
		idle.TimePosition = rng:NextNumber(0, 2)
		if spec.mobile then
			local walk = load(a, ANIM.walk, Enum.AnimationPriority.Movement)
			humanoid.Running:Connect(function(speed: number)
				if speed > 0.6 then
					if not walk.IsPlaying then
						walk:Play(0.2)
					end
					walk:AdjustSpeed(math.clamp(speed / 10, 0.5, 1.4))
				elseif walk.IsPlaying then
					walk:Stop(0.25)
				end
			end)
		end
	end)
	if not ok then
		warn("[Characters] could not start animations for " .. model:GetFullName())
	end
end

-- Call once every site is parented to Workspace.
function Characters.settle()
	local exclude: { Instance } = {}
	for _, entry in entries do
		table.insert(exclude, entry.model)
	end
	local drones = Workspace:FindFirstChild("Drones")
	if drones then
		table.insert(exclude, drones)
	end
	floorParams.FilterDescendantsInstances = exclude

	for _, entry in entries do
		if entry.settled or not entry.model:IsDescendantOf(Workspace) then
			continue
		end
		entry.settled = true
		local model = entry.model
		local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
		local root = model.PrimaryPart :: BasePart
		if entry.spec.pose == "Stand" then
			local pivot = model:GetPivot()
			local guess = pivot.Position - Vector3.new(0, rootHeight(humanoid, root), 0)
			local hit = Workspace:Raycast(
				guess + Vector3.new(0, 2.5, 0),
				Vector3.new(0, -6, 0),
				floorParams
			)
			if hit then
				local center = hit.Position + Vector3.new(0, rootHeight(humanoid, root), 0)
				model:PivotTo(pivot.Rotation + center)
			end
		end
		animate(model, entry.spec)
		if entry.spec.mobile then
			root.Anchored = false
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end
	end
end

-- Feet position of a standing person (for pathfinding)
function Characters.feet(model: Model): Vector3
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart
	if not humanoid or not root then
		return model:GetPivot().Position
	end
	return root.Position - Vector3.new(0, rootHeight(humanoid, root), 0)
end

return Characters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Feedback</string>
          <string name="Source"><![CDATA[--!strict
-- Sends result cards (readings, confirmations, warnings) to pilots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local Net = require(script.Parent.Net)

local Feedback = {}

function Feedback.send(player: Player, title: string, text: string, severity: Types.Severity)
	local payload: Types.Feedback = { title = title, text = text, severity = severity }
	Net.fireClient("Feedback", player, payload)
end

function Feedback.all(title: string, text: string, severity: Types.Severity)
	local payload: Types.Feedback = { title = title, text = text, severity = severity }
	Net.fireAll("Feedback", payload)
end

return Feedback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Kit</string>
          <string name="Source"><![CDATA[--!strict
-- Construction kit shared by the site builders: primitives (parts, walls
-- with holes, lights, signs) and the standard tagged devices.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Characters = require(script.Parent.Characters)

-- Palette
local CONCRETE = Color3.fromRGB(52, 52, 58)
local CONCRETE_DARK = Color3.fromRGB(34, 34, 38)
local SEWER = Color3.fromRGB(44, 48, 40)
local METAL = Color3.fromRGB(96, 100, 108)
local METAL_DARK = Color3.fromRGB(48, 50, 56)
local HAZARD = Color3.fromRGB(240, 180, 20)
local CYAN = Color3.fromRGB(0, 230, 255)
local MAGENTA = Color3.fromRGB(255, 40, 140)
local RED = Color3.fromRGB(255, 50, 50)
local WHITE = Color3.fromRGB(225, 225, 220)

---------------------------------------------------------------------------
-- Primitives
---------------------------------------------------------------------------

local function newPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Axis-aligned box from two corners.
local function box(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	local min = a:Min(b)
	local max = a:Max(b)
	return newPart(parent, name, max - min, CFrame.new((min + max) / 2), color, material)
end

-- Cylinder whose axis points along `axis` ("X", "Y" or "Z").
local function cylinder(
	parent: Instance,
	name: string,
	length: number,
	diameter: number,
	center: Vector3,
	axis: string,
	color: Color3,
	material: Enum.Material?
): Part
	local rotation = if axis == "Y"
		then CFrame.Angles(0, 0, math.pi / 2)
		elseif axis == "Z" then CFrame.Angles(0, math.pi / 2, 0)
		else CFrame.identity
	local part = newPart(
		parent,
		name,
		Vector3.new(length, diameter, diameter),
		CFrame.new(center) * rotation,
		color,
		material
	)
	part.Shape = Enum.PartType.Cylinder
	return part
end

local function ball(
	parent: Instance,
	name: string,
	diameter: number,
	center: Vector3,
	color: Color3,
	material: Enum.Material?
): Part
	local part = newPart(parent, name, Vector3.one * diameter, CFrame.new(center), color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

local function decor(part: BasePart): BasePart
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	return part
end

local function light(part: BasePart, color: Color3, range: number, brightness: number): PointLight
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range
	pointLight.Brightness = brightness
	pointLight.Shadows = range > 20
	pointLight.Parent = part
	return pointLight
end

local function lamp(
	parent: Instance,
	position: Vector3,
	color: Color3,
	range: number,
	brightness: number
)
	local head = newPart(
		parent,
		"Lamp",
		Vector3.new(2.4, 0.4, 2.4),
		CFrame.new(position),
		color,
		Enum.Material.Neon
	)
	decor(head)
	light(head, color, range, brightness)
end

local function sign(
	parent: Instance,
	cframe: CFrame,
	size: Vector2,
	text: string,
	color: Color3,
	font: Enum.Font?
): Part
	local board = newPart(parent, "Sign", Vector3.new(size.X, size.Y, 0.2), cframe, CONCRETE_DARK)
	board.Transparency = 1
	decor(board)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.Parent = gui
	return board
end

-- Facing helpers for signs: a sign at `position` readable from `toward`.
local function facing(position: Vector3, toward: Vector3): CFrame
	return CFrame.lookAt(position, toward)
end

---------------------------------------------------------------------------
-- Walls with holes
---------------------------------------------------------------------------

export type Rect = { a0: number, a1: number, b0: number, b1: number }

local function rect(a0: number, a1: number, b0: number, b1: number): Rect
	return { a0 = a0, a1 = a1, b0 = b0, b1 = b1 }
end

-- Splits the rectangle [a0,a1] x [b0,b1] into solid pieces around the holes.
local function solids(a0: number, a1: number, b0: number, b1: number, holes: { Rect }): { Rect }
	local cuts = { a0, a1 }
	for _, hole in holes do
		table.insert(cuts, math.clamp(hole.a0, a0, a1))
		table.insert(cuts, math.clamp(hole.a1, a0, a1))
	end
	table.sort(cuts)

	local out: { Rect } = {}
	for i = 1, #cuts - 1 do
		local x0, x1 = cuts[i], cuts[i + 1]
		if x1 - x0 > 0.01 then
			local mid = (x0 + x1) / 2
			local spans: { { number } } = {}
			for _, hole in holes do
				if hole.a0 < mid and hole.a1 > mid then
					table.insert(spans, { hole.b0, hole.b1 })
				end
			end
			table.sort(spans, function(p, q)
				return p[1] < q[1]
			end)
			local cursor = b0
			for _, span in spans do
				if span[1] > cursor then
					table.insert(out, rect(x0, x1, cursor, math.min(span[1], b1)))
				end
				cursor = math.max(cursor, span[2])
			end
			if cursor < b1 then
				table.insert(out, rect(x0, x1, cursor, b1))
			end
		end
	end
	return out
end

-- Wall in the plane x = const. Holes are rects in (z, y).
local function wallX(
	parent: Instance,
	x: number,
	z0: number,
	z1: number,
	y0: number,
	y1: number,
	holes: { Rect },
	color: Color3,
	material: Enum.Material?
)
	for _, piece in solids(z0, z1, y0, y1, holes) do
		box(
			parent,
			"Wall",
			Vector3.new(x - 0.5, piece.b0, piece.a0),
			Vector3.new(x + 0.5, piece.b1, piece.a1),
			color,
			material
		)
	end
end

-- Wall in the plane z = const. Holes are rects in (x, y).
local function wallZ(
	parent: Instance,
	z: number,
	x0: number,
	x1: number,
	y0: number,
	y1: number,
	holes: { Rect },
	color: Color3,
	material: Enum.Material?
)
	for _, piece in solids(x0, x1, y0, y1, holes) do
		box(
			parent,
			"Wall",
			Vector3.new(piece.a0, piece.b0, z - 0.5),
			Vector3.new(piece.a1, piece.b1, z + 0.5),
			color,
			material
		)
	end
end

-- Horizontal slab at height y (thickness 2). Holes are rects in (x, z).
local function slabY(
	parent: Instance,
	y: number,
	x0: number,
	x1: number,
	z0: number,
	z1: number,
	holes: { Rect },
	color: Color3,
	material: Enum.Material?
)
	for _, piece in solids(x0, x1, z0, z1, holes) do
		box(
			parent,
			"Slab",
			Vector3.new(piece.a0, y - 1, piece.b0),
			Vector3.new(piece.a1, y + 1, piece.b1),
			color,
			material
		)
	end
end

---------------------------------------------------------------------------
-- Devices
---------------------------------------------------------------------------

local idCounter = 0

local function device(
	instance: Instance,
	deviceType: string,
	label: string,
	attributes: { [string]: any }?
)
	local spec = Config.DEVICES[deviceType]
	assert(spec, "unknown device type " .. deviceType)
	idCounter += 1
	local hex = string.format("%04X", (idCounter * 7919 + 4099) % 65536)
	instance:SetAttribute("DeviceType", deviceType)
	instance:SetAttribute("DeviceId", spec.prefix .. "-" .. hex)
	instance:SetAttribute("Label", label)
	if attributes then
		for key, value in attributes do
			instance:SetAttribute(key, value)
		end
	end
	CollectionService:AddTag(instance, "Device")
end

local function newModel(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

local function buildDock(parent: Instance, refs: any?, label: string, floor: Vector3)
	local model = newModel(parent, "Dock")
	local base = newPart(
		model,
		"Base",
		Vector3.new(7, 0.4, 7),
		CFrame.new(floor + Vector3.new(0, 0.2, 0)),
		METAL_DARK,
		Enum.Material.DiamondPlate
	)
	for _, offset in { Vector3.new(0, 0, 3.35), Vector3.new(0, 0, -3.35) } do
		decor(
			newPart(
				model,
				"Ring",
				Vector3.new(7, 0.1, 0.3),
				CFrame.new(floor + offset + Vector3.new(0, 0.45, 0)),
				CYAN,
				Enum.Material.Neon
			)
		)
	end
	for _, offset in { Vector3.new(3.35, 0, 0), Vector3.new(-3.35, 0, 0) } do
		decor(
			newPart(
				model,
				"Ring",
				Vector3.new(0.3, 0.1, 7),
				CFrame.new(floor + offset + Vector3.new(0, 0.45, 0)),
				CYAN,
				Enum.Material.Neon
			)
		)
	end
	decor(
		cylinder(
			model,
			"Mark",
			0.05,
			3,
			floor + Vector3.new(0, 0.43, 0),
			"Y",
			CYAN,
			Enum.Material.Neon
		)
	)
	light(base, CYAN, 14, 0.8)
	model.PrimaryPart = base
	device(
		model,
		"Dock",
		label,
		{ LinkRange = Config.LINK.DOCK_RANGE, Status = "CHARGING / MODULE SWAP", Temperature = 31 }
	)
	CollectionService:AddTag(model, "LinkSource")
	if refs then
		table.insert(refs.docks, model)
	end
	return model
end

local function buildJunctionBox(parent: Instance, position: Vector3, normal: Vector3, label: string)
	local model = newModel(parent, "JunctionBox")
	local cf = CFrame.lookAt(position, position + normal)
	local body =
		newPart(model, "Body", Vector3.new(2.4, 3, 0.8), cf, METAL_DARK, Enum.Material.Metal)
	decor(
		newPart(
			model,
			"Led",
			Vector3.new(0.3, 0.3, 0.1),
			cf * CFrame.new(0.8, 1.1, -0.45),
			Color3.fromRGB(80, 255, 120),
			Enum.Material.Neon
		)
	)
	model.PrimaryPart = body
	device(model, "Junction", label, { Status = "LIVE 400V", Temperature = 36 })
	return model
end

local function buildCamera(parent: Instance, position: Vector3, lookAt: Vector3, label: string)
	local model = newModel(parent, "SurveillanceCam")
	local cf = CFrame.lookAt(position, lookAt)
	local body = newPart(
		model,
		"Body",
		Vector3.new(1, 1, 2),
		cf,
		Color3.fromRGB(30, 30, 34),
		Enum.Material.Metal
	)
	decor(
		cylinder(
			model,
			"Lens",
			0.2,
			0.7,
			(cf * CFrame.new(0, 0, -1.05)).Position,
			"Z",
			Color3.fromRGB(20, 20, 30),
			Enum.Material.Glass
		)
	)
	local led = decor(
		newPart(
			model,
			"Led",
			Vector3.new(0.2, 0.2, 0.2),
			cf * CFrame.new(0.35, 0.35, -0.9),
			RED,
			Enum.Material.Neon
		)
	)
	light(led, RED, 4, 0.6)
	model.PrimaryPart = body
	device(model, "Surveillance", label, { Status = "RECORDING // DIRECTORATE", Temperature = 33 })
	CollectionService:AddTag(model, "SweepCam")
	return model
end

local function buildGas(
	parent: Instance,
	refs: any?,
	gas: string,
	center: Vector3,
	radius: number,
	peak: number,
	zone: string
)
	local spec = Config.GASES[gas]
	local cloud =
		ball(parent, "GasCloud_" .. gas, radius * 2, center, spec.color, Enum.Material.Neon)
	decor(cloud)
	cloud.CanTouch = false
	cloud.Transparency = 1
	cloud:SetAttribute("Gas", gas)
	cloud:SetAttribute("Peak", peak)
	cloud:SetAttribute("Radius", radius)
	cloud:SetAttribute("Scale", 1)
	cloud:SetAttribute("Zone", zone)
	CollectionService:AddTag(cloud, "GasCloud")
	if refs and zone == "Sewer" then
		table.insert(refs.sewerGas, cloud)
	end
	return cloud
end

local function buildDebris(
	parent: Instance,
	center: Vector3,
	size: Vector3,
	objective: string,
	label: string
)
	local rng = Random.new(math.floor(center.X * 13 + center.Z * 7))
	local chunk = newPart(
		parent,
		"Debris",
		size,
		CFrame.new(center)
			* CFrame.Angles(
				rng:NextNumber(-0.15, 0.15),
				rng:NextNumber(0, math.pi),
				rng:NextNumber(-0.15, 0.15)
			),
		Color3.fromRGB(70, 66, 58),
		Enum.Material.Concrete
	)
	device(
		chunk,
		"Debris",
		label,
		{ Objective = objective, Home = center, Cleared = false, Status = "BLOCKING" }
	)
	return chunk
end

local function buildTerminal(
	parent: Instance,
	refs: any?,
	floor: Vector3,
	yaw: number,
	label: string,
	offers: string,
	accepts: string
)
	local model = newModel(parent, "Terminal")
	local cf = CFrame.new(floor) * CFrame.Angles(0, yaw, 0)
	newPart(
		model,
		"Pedestal",
		Vector3.new(3, 3.2, 2),
		cf * CFrame.new(0, 1.6, 0),
		METAL_DARK,
		Enum.Material.Metal
	)
	local screen = newPart(
		model,
		"Screen",
		Vector3.new(3.4, 2.4, 0.3),
		cf * CFrame.new(0, 4.2, 0.2) * CFrame.Angles(math.rad(20), 0, 0),
		Color3.fromRGB(5, 25, 30),
		Enum.Material.Glass
	)
	light(screen, CYAN, 10, 0.8)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = screen
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextColor3 = CYAN
	text.Font = Enum.Font.Code
	text.TextScaled = true
	text.Text = label .. "\nOFFLINE NETWORK\nAWAITING DATA JACK"
	text.Parent = gui
	model.PrimaryPart = screen
	device(model, "Terminal", label, {
		Offers = offers,
		Accepts = accepts,
		Status = "NETWORK DOWN - JACK IN",
		Temperature = 34,
	})
	if refs then
		table.insert(refs.terminals, model)
	end
	return model
end

local function buildBeacon(
	parent: Instance,
	refs: any?,
	position: Vector3,
	normal: Vector3,
	label: string
)
	local model = newModel(parent, "Beacon")
	local cf = CFrame.lookAt(position, position + normal)
	local base =
		newPart(model, "Base", Vector3.new(2.4, 2.4, 0.6), cf, METAL_DARK, Enum.Material.Metal)
	local dome = ball(
		model,
		"Dome",
		1.8,
		(cf * CFrame.new(0, 0, -0.6)).Position,
		Color3.fromRGB(90, 30, 20),
		Enum.Material.Glass
	)
	local strobe = light(dome, Color3.fromRGB(255, 120, 40), 26, 0)
	strobe.Name = "Strobe"
	model.PrimaryPart = base
	device(
		model,
		"Beacon",
		label,
		{ Active = false, Status = "DORMANT", LinkRange = 0, Temperature = 29 }
	)
	CollectionService:AddTag(model, "LinkSource")
	if refs then
		table.insert(refs.beacons, model)
	end
	return model
end

-- A simple figure built from blocks. `cf` is the torso centre and orientation.
export type ResidentSpec = {
	name: string,
	condition: string, -- Fever | Healthy | Dehydrated
	cf: CFrame, -- hip centre
	pose: string, -- Stand | Sit | Lie
	shirt: Color3,
}

-- A person the drone can find, assess and treat (an R15 character)
local function buildResident(parent: Instance, refs: any?, spec: ResidentSpec): Model
	local model =
		Characters.spawn(parent, "Resident", { pose = spec.pose, cf = spec.cf, shirt = spec.shirt })
	local temperature = Characters.temperature(spec.condition)
	device(model, "Resident", spec.name, {
		Condition = spec.condition,
		Temperature = temperature,
		BaseTemperature = temperature,
		NeedsAid = spec.condition ~= "Healthy",
		Located = false,
		Status = "UNIDENTIFIED",
	})
	if refs then
		table.insert(refs.residents, model)
	end
	return model
end

local function buildValve(
	parent: Instance,
	refs: any?,
	position: Vector3,
	normal: number,
	label: string,
	correctOpen: boolean,
	startOpen: boolean
)
	local model = newModel(parent, "Valve")
	local wheel = cylinder(
		model,
		"Wheel",
		0.5,
		4,
		position,
		"Z",
		Color3.fromRGB(170, 40, 30),
		Enum.Material.Metal
	)
	decor(
		cylinder(
			model,
			"Stem",
			1.6,
			0.6,
			position - Vector3.new(0, 0, normal * 0.9),
			"Z",
			METAL,
			Enum.Material.Metal
		)
	)
	decor(
		newPart(
			model,
			"SpokeA",
			Vector3.new(3.6, 0.35, 0.35),
			CFrame.new(position),
			METAL,
			Enum.Material.Metal
		)
	)
	decor(
		newPart(
			model,
			"SpokeB",
			Vector3.new(0.35, 3.6, 0.35),
			CFrame.new(position),
			METAL,
			Enum.Material.Metal
		)
	)
	model.PrimaryPart = wheel
	device(model, "Valve", label, {
		Open = startOpen,
		CorrectOpen = correctOpen,
		Status = if startOpen then "OPEN" else "CLOSED",
	})
	if refs then
		table.insert(refs.valves, model)
	end
	return model
end

local function buildSamplePoint(
	parent: Instance,
	position: Vector3,
	normal: Vector3,
	label: string,
	readings: { [string]: any }
)
	local pipe = cylinder(
		parent,
		"Outflow",
		2,
		1.6,
		position,
		if math.abs(normal.Z) > 0 then "Z" else "X",
		Color3.fromRGB(80, 84, 70),
		Enum.Material.CorrodedMetal
	)
	local slime = decor(
		newPart(
			parent,
			"Slime",
			Vector3.new(1, 3, 1),
			CFrame.new(position + normal * 1.1 - Vector3.new(0, 1.6, 0)),
			Color3.fromRGB(110, 140, 50),
			Enum.Material.Glass
		)
	)
	slime.Transparency = 0.3
	local attributes: { [string]: any } = { Status = "UNTESTED", Sampled = false }
	for key, value in readings do
		attributes[key] = value
	end
	device(pipe, "SamplePoint", label, attributes)
	return pipe
end

local Kit = {
	newPart = newPart,
	box = box,
	cylinder = cylinder,
	ball = ball,
	decor = decor,
	light = light,
	lamp = lamp,
	sign = sign,
	facing = facing,
	rect = rect,
	solids = solids,
	wallX = wallX,
	wallZ = wallZ,
	slabY = slabY,
	device = device,
	newModel = newModel,
	buildDock = buildDock,
	buildJunctionBox = buildJunctionBox,
	buildCamera = buildCamera,
	buildGas = buildGas,
	buildDebris = buildDebris,
	buildTerminal = buildTerminal,
	buildBeacon = buildBeacon,
	buildResident = buildResident,
	buildValve = buildValve,
	buildSamplePoint = buildSamplePoint,
	colors = {
		CONCRETE = CONCRETE,
		CONCRETE_DARK = CONCRETE_DARK,
		SEWER = SEWER,
		METAL = METAL,
		METAL_DARK = METAL_DARK,
		HAZARD = HAZARD,
		CYAN = CYAN,
		MAGENTA = MAGENTA,
		RED = RED,
		WHITE = WHITE,
	},
}

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Mission</string>
          <string name="Source"><![CDATA[--!strict
-- Shared operation progress. Counters live as attributes on
-- ReplicatedStorage.Mission so every pilot's ops log updates live.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Feedback = require(script.Parent.Feedback)

local folder = Instance.new("Folder")
folder.Name = "Mission"
for _, group in Config.OBJECTIVES do
	for _, item in group.items do
		folder:SetAttribute(item.key, 0)
	end
end
folder.Parent = ReplicatedStorage

local completed: { [string]: boolean } = {}

local Mission = {}

function Mission.get(key: string): number
	local value = folder:GetAttribute(key)
	return if typeof(value) == "number" then value else 0
end

local function checkZones()
	for _, group in Config.OBJECTIVES do
		if not completed[group.zone] then
			local done = true
			for _, item in group.items do
				if Mission.get(item.key) < item.total then
					done = false
					break
				end
			end
			if done then
				completed[group.zone] = true
				Feedback.all("OPERATION COMPLETE", group.zone, "success")
			end
		end
	end
end

function Mission.set(key: string, value: number)
	if folder:GetAttribute(key) == nil then
		warn(("[Mission] unknown objective %s"):format(key))
		return
	end
	if Mission.get(key) ~= value then
		folder:SetAttribute(key, value)
		checkZones()
	end
end

function Mission.add(key: string, delta: number)
	Mission.set(key, Mission.get(key) + delta)
end

return Mission
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Server side of the remote API. Remotes are created here, once, from the
-- shared list. Every inbound handler goes through a per-player rate limit;
-- handlers receive `unknown` args and must validate them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

type RemoteName = Remotes.RemoteName

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local events: { [string]: RemoteEvent } = {}
for _, name in Remotes.Names do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	events[name] = remote
end
folder.Parent = ReplicatedStorage

local lastCall: { [Player]: { [string]: number } } = {}
Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)

local Net = {}

function Net.on(name: RemoteName, minInterval: number, handler: (Player, ...unknown) -> ())
	events[name].OnServerEvent:Connect(function(player: Player, ...: unknown)
		local now = os.clock()
		local calls = lastCall[player]
		if not calls then
			calls = {}
			lastCall[player] = calls
		end
		local last = calls[name]
		if last and now - last < minInterval then
			return
		end
		calls[name] = now
		handler(player, ...)
	end)
end

function Net.fireClient(name: RemoteName, player: Player, ...: any)
	events[name]:FireClient(player, ...)
end

function Net.fireAll(name: RemoteName, ...: any)
	events[name]:FireAllClients(...)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
-- Site builders register their simulated systems here; Environment and
-- Actions drive them generically. Devices point at their group with
-- attributes (FloodGroup, VentGroup), so one rule set runs both sites.

export type FloodSpec = {
	valves: { Instance },
	valveObjective: string,
	debrisObjective: string,
	debrisTotal: number,
	-- progress 0 (flooded) .. 1 (drained) -> sets the water, returns a level in studs
	apply: (progress: number) -> number,
	-- human-readable effect of a level, e.g. "Underpass: 0.8m of water"
	describe: (level: number) -> string,
}

export type VentSpec = {
	breaker: Instance,
	objective: string,
	onText: string,
	offText: string,
}

local Registry = {
	floods = {} :: { [string]: FloodSpec },
	vents = {} :: { [string]: VentSpec },
	spawns = {} :: { [string]: CFrame },
	roots = {} :: { [string]: Folder },
}

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[--!strict
-- Every drone action goes through here. The client only says "Primary or
-- Secondary, on hardpoint A or B, at this thing". The server resolves the
-- action from the module that is actually installed, then checks range,
-- line of sight and command link before anything happens.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Gas = require(ReplicatedStorage.Shared.Util.Gas)
local Link = require(ReplicatedStorage.Shared.Util.Link)

local Sites = require(ReplicatedStorage.Shared.Util.Sites)
local Units = require(ReplicatedStorage.Shared.Util.Units)

local Feedback = require(script.Parent.Parent.Feedback)
local Mission = require(script.Parent.Parent.Mission)
local Net = require(script.Parent.Parent.Net)
local Registry = require(script.Parent.Parent.Registry)
local DroneService = require(script.Parent.DroneService)
local Environment = require(script.Parent.Environment)
local Guides = require(script.Parent.Guides)

local Actions = {}

type Context = {
	player: Player,
	drone: Model,
	hull: BasePart,
	device: Instance?,
}

local PACKETS = Config.PACKETS

local function attr(instance: Instance, key: string): any
	return instance:GetAttribute(key)
end

local function tagOf(device: Instance): string
	return ("%s"):format(tostring(attr(device, "DeviceId") or "UNKNOWN"))
end

local function labelOf(device: Instance): string
	return tostring(attr(device, "Label") or device.Name)
end

local function meters(studs: number): string
	return ("%.1fm"):format(studs * Config.STUDS_TO_METERS)
end

local function setTerminalText(terminal: Instance, text: string)
	local screen = terminal:FindFirstChild("Screen")
	local display = screen and screen:FindFirstChild("Display")
	local label = display and display:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

-- Site folder for things the drone leaves behind (relays, med kits).
local function siteRoot(position: Vector3): Instance
	local root = Registry.roots[Sites.at(position)]
	return root or Workspace
end

local function objective(device: Instance, key: string): string?
	local value = device:GetAttribute(key)
	return if typeof(value) == "string" and value ~= "" then value else nil
end

local function totalOf(key: string): number
	for _, group in Config.OBJECTIVES do
		for _, item in group.items do
			if item.key == key then
				return item.total
			end
		end
	end
	return 0
end

---------------------------------------------------------------------------
-- Handlers
---------------------------------------------------------------------------

local HANDLERS: { [string]: (Context) -> () } = {}

HANDLERS.TurnValve = function(ctx)
	local valve = ctx.device
	if not valve or not valve:IsA("Model") then
		return
	end
	local open = attr(valve, "Open") ~= true
	valve:SetAttribute("Open", open)
	valve:SetAttribute("Status", if open then "OPEN" else "CLOSED")
	task.spawn(function()
		for _ = 1, 12 do
			valve:PivotTo(
				valve:GetPivot() * CFrame.Angles((if open then 1 else -1) * math.pi / 12, 0, 0)
			)
			task.wait(0.04)
		end
	end)
	local group = tostring(attr(valve, "FloodGroup") or "")
	local _, correct, effect = Environment.updateFlood(group)
	local spec = Registry.floods[group]
	local right = open == (attr(valve, "CorrectOpen") == true)
	Feedback.send(
		ctx.player,
		tagOf(valve),
		("%s\n-> %s. %s\n%s (%d/%d gates set)."):format(
			labelOf(valve),
			if open then "OPEN" else "CLOSED",
			if right then "Flow corrected." else "That works against drainage.",
			effect,
			correct,
			if spec then #spec.valves else 0
		),
		if right then "success" else "warning"
	)
end

HANDLERS.Grab = function(ctx)
	local debris = ctx.device
	if not debris or not debris:IsA("BasePart") or attr(debris, "Carried") == true then
		return
	end
	if DroneService.grab(ctx.player, debris) then
		local kg = math.floor(debris.Size.X * debris.Size.Y * debris.Size.Z * 6)
		Feedback.send(
			ctx.player,
			tagOf(debris),
			("Gripping %s (~%d kg). Carry it away from where it was stuck."):format(
				labelOf(debris),
				kg
			),
			"info"
		)
	end
end

HANDLERS.Release = function(ctx)
	DroneService.release(ctx.player)
end

HANDLERS.FlipBreaker = function(ctx)
	local breaker = ctx.device
	if not breaker then
		return
	end
	local on = attr(breaker, "On") ~= true
	local text = Environment.setVent(tostring(attr(breaker, "VentGroup") or ""), on)
	Feedback.send(ctx.player, tagOf(breaker), text, if on then "success" else "warning")
end

HANDLERS.CutCable = function(ctx)
	local jammer = ctx.device
	if not jammer or attr(jammer, "Active") ~= true then
		if jammer then
			Feedback.send(ctx.player, tagOf(jammer), "Jammer is already dead.", "info")
		end
		return
	end
	Environment.disableJammer(jammer)
	local key = objective(jammer, "Objective")
	if key then
		Mission.set(key, 1)
	end
	Feedback.send(
		ctx.player,
		tagOf(jammer),
		"Power cable cut. " .. tostring(attr(jammer, "CutText") or "Jammer offline."),
		"success"
	)
end

HANDLERS.SampleWater = function(ctx)
	local point = ctx.device
	if not point then
		return
	end
	local contaminated = attr(point, "Contaminated") == true
	local verdict = if contaminated then "CONTAMINATED - DO NOT DRINK" else "SAFE FOR RECYCLING"
	if attr(point, "Sampled") ~= true then
		point:SetAttribute("Sampled", true)
		local key = objective(point, "Objective")
		if key then
			Mission.add(key, 1)
		end
	end
	point:SetAttribute("Status", verdict)
	Feedback.send(
		ctx.player,
		"WATER SAMPLE // " .. tagOf(point),
		("%s\npH %.1f   Coliform %d CFU/100mL   Lead %d ug/L\nVERDICT: %s"):format(
			labelOf(point),
			attr(point, "PH") or 7,
			attr(point, "Coliform") or 0,
			attr(point, "Lead") or 0,
			verdict
		),
		if contaminated then "danger" else "data"
	)
end

HANDLERS.ReadVitals = function(ctx)
	local subject = ctx.device
	if not subject then
		return
	end
	if attr(subject, "DeviceType") == "HeatSource" then
		subject:SetAttribute("Status", "SPACE HEATER - NOT A PERSON")
		Feedback.send(
			ctx.player,
			"VITALS // " .. tagOf(subject),
			"No lifesign. Electric space heater at "
				.. Units.tempWhole(61)
				.. ".\nFire risk in a sealed block, but nobody here.",
			"data"
		)
		return
	end

	local condition = tostring(attr(subject, "Condition"))
	local temperature = attr(subject, "Temperature") or 37
	local treated = attr(subject, "Treated") == true
	if attr(subject, "Located") ~= true then
		subject:SetAttribute("Located", true)
		local key = objective(subject, "LocateObjective")
		if key then
			Mission.add(key, 1)
		end
	end

	-- Heart rate climbs ~10 bpm per °C of fever; SpO2 drops with lung sickness
	local fever = math.max(0, temperature - 37)
	local seed = #tostring(attr(subject, "Label") or "")
	local spo2, heartRate, assessment
	if treated then
		spo2 = 95 + seed % 3
		heartRate = math.floor(76 + fever * 10)
		assessment = if temperature >= Config.VITALS.FEVER_LINE
			then "TREATED - fever coming down"
			else "TREATED - recovered, temperature normal"
	elseif condition == "Fever" then
		spo2 = 89 + seed % 4
		heartRate = math.floor(82 + fever * 11 + seed % 6)
		assessment = "FEVER + coughing, lung sickness suspected -> NEEDS MED KIT"
	elseif condition == "Dehydrated" then
		spo2 = 96 + seed % 2
		heartRate = math.floor(98 + seed % 9)
		assessment = "TRAPPED, dehydrated -> NEEDS SUPPLIES"
	else
		spo2 = 97 + seed % 3
		heartRate = 64 + seed % 14
		assessment = "Stable, temperature in the healthy range. No aid needed."
	end
	if not treated then
		subject:SetAttribute(
			"Status",
			if condition == "Healthy"
				then "STABLE " .. Units.temp(temperature)
				else Units.temp(temperature) .. " - NEEDS AID"
		)
	end
	Feedback.send(
		ctx.player,
		"VITALS // " .. tagOf(subject),
		("%s\nTemp %s   SpO2 %d%%   HR %d\n%s"):format(
			labelOf(subject),
			Units.temp(temperature),
			spo2,
			heartRate,
			assessment
		),
		if condition == "Healthy" or treated then "data" else "warning"
	)
end

local function airZone(position: Vector3): Instance?
	for _, zone in CollectionService:GetTagged("AirZone") do
		if zone:IsA("BasePart") then
			local localPos = zone.CFrame:PointToObjectSpace(position)
			local half = zone.Size / 2
			if
				math.abs(localPos.X) <= half.X
				and math.abs(localPos.Y) <= half.Y
				and math.abs(localPos.Z) <= half.Z
			then
				return zone
			end
		end
	end
	return nil
end

HANDLERS.SampleAir = function(ctx)
	local readings = Gas.at(ctx.hull.Position, Gas.gather())
	local lines = {}
	local danger = false

	-- Bulk air composition (O2 / CO2 / particulates) from the zone the drone is in
	local zone = airZone(ctx.hull.Position)
	local base = Config.AIR_DEFAULT
	local function num(key: string, fallback: number): number
		local value = zone and zone:GetAttribute(key)
		return if typeof(value) == "number" then value else fallback
	end
	local o2 = num("O2", base.O2)
	local co2 = num("CO2", base.CO2) + (readings.CO2 or 0)
	local pm = num("PM", base.PM)
	local temp = num("Temp", base.Temp)
	local toxic: { [string]: number } = {}
	for gas, value in readings do
		if gas ~= "CO2" then
			toxic[gas] = value
		end
	end
	readings = toxic
	local o2Low = o2 < 19.5
	local co2High = co2 >= 5000
	danger = o2Low or co2High
	table.insert(
		lines,
		("O2 %.1f%%%s   CO2 %d ppm%s"):format(
			o2,
			if o2Low then " LOW" else "",
			math.floor(co2),
			if co2High then " HIGH" elseif co2 > 2000 then " (stuffy)" else ""
		)
	)
	table.insert(lines, ("PM2.5 %d µg/m³   AIR %s"):format(math.floor(pm), Units.tempWhole(temp)))
	for _, gas in { "H2S", "CH4", "Spores" } do
		local value = readings[gas]
		if value and value >= 0.5 then
			local spec = Config.GASES[gas]
			local harmful = value >= spec.danger
			danger = danger or harmful
			table.insert(
				lines,
				("%s %d %s%s"):format(
					spec.label,
					math.floor(value),
					spec.unit,
					if harmful then "  << DANGEROUS FOR HUMANS" else ""
				)
			)
		end
	end
	if #lines == 2 then
		table.insert(lines, "No toxic gas detected.")
	end
	local title = "AIR SAMPLE"
	if zone then
		title ..= " // " .. tostring(zone:GetAttribute("Label") or "ZONE")
		local verdict = zone:GetAttribute("Verdict")
		if typeof(verdict) == "string" then
			table.insert(lines, verdict)
		end
		local key = objective(zone, "Objective")
		if key and Mission.get(key) < 1 then
			Mission.set(key, 1)
			Workspace:SetAttribute(
				"SurfaceAir",
				("O2 %.1f%% · CO2 %d ppm · PM2.5 %d µg/m³ (drone sample)"):format(o2, co2, pm)
			)
		end
	else
		title ..= " // " .. meters(ctx.hull.Position.Y - 0) .. " ALT"
	end
	Feedback.send(ctx.player, title, table.concat(lines, "\n"), if danger then "danger" else "data")
end

HANDLERS.Inspect = function(ctx)
	local equipment = ctx.device
	if not equipment then
		return
	end
	if attr(equipment, "Inspected") ~= true then
		equipment:SetAttribute("Inspected", true)
		local key = objective(equipment, "Objective")
		if key then
			Mission.add(key, 1)
		end
		local verdict = attr(equipment, "Verdict")
		if typeof(verdict) == "string" then
			equipment:SetAttribute("Status", verdict)
		end
	end
	Feedback.send(
		ctx.player,
		"DIAGNOSTIC // " .. tagOf(equipment),
		labelOf(equipment) .. "\n" .. tostring(attr(equipment, "Diagnostic") or "Nominal."),
		if attr(equipment, "Severity") == "danger" then "danger" else "warning"
	)
end

HANDLERS.Guide = function(ctx)
	if ctx.device then
		Guides.toggle(ctx.player, ctx.device)
	end
end

HANDLERS.JackIn = function(ctx)
	local terminal = ctx.device
	if not terminal then
		return
	end
	local packet = tostring(attr(ctx.drone, "Packet") or "")
	local accepts = tostring(attr(terminal, "Accepts") or "")
	local offers = tostring(attr(terminal, "Offers") or "")

	if packet ~= "" and packet == accepts then
		local info = PACKETS[packet]
		ctx.drone:SetAttribute("Packet", "")
		terminal:SetAttribute("Accepts", "")
		Mission.set(info.objective, 1)
		setTerminalText(terminal, labelOf(terminal) .. "\nRECEIVED\n" .. packet)
		if info.event == "Broadcast" then
			task.defer(Environment.broadcast, ctx.player)
		end
		terminal:SetAttribute(
			"Status",
			if offers ~= "" then "DATA RECEIVED - HAS OUTBOUND PACKET" else "DATA RECEIVED"
		)
		Feedback.send(
			ctx.player,
			"UPLOAD // " .. tagOf(terminal),
			("Delivered %s to %s.%s"):format(
				info.name,
				labelOf(terminal),
				if offers ~= ""
					then "\nThis terminal has an outbound packet. Jack in again."
					else ""
			),
			"success"
		)
	elseif offers ~= "" then
		if packet ~= "" then
			Feedback.send(
				ctx.player,
				"DATA JACK",
				("Storage full: carrying %s. Deliver it first."):format(packet),
				"warning"
			)
			return
		end
		local info = PACKETS[offers]
		ctx.drone:SetAttribute("Packet", offers)
		local downloadKey = objective(terminal, "Objective")
		if downloadKey then
			Mission.set(downloadKey, 1)
		end
		terminal:SetAttribute("Offers", "")
		terminal:SetAttribute(
			"Status",
			if accepts ~= "" then "PACKET SENT - AWAITING INBOUND" else "PACKET SENT"
		)
		setTerminalText(terminal, labelOf(terminal) .. "\nPACKET COPIED\nTO COURIER DRONE")
		Feedback.send(
			ctx.player,
			"DOWNLOAD // " .. tagOf(terminal),
			("Copied %s (%s).\nDeliver to: %s"):format(info.name, offers, info.destination),
			"success"
		)
	elseif accepts ~= "" then
		Feedback.send(
			ctx.player,
			"DATA JACK",
			("%s is waiting for %s."):format(labelOf(terminal), accepts),
			"info"
		)
	else
		Feedback.send(
			ctx.player,
			"DATA JACK",
			("%s synced. Nothing left to transfer."):format(labelOf(terminal)),
			"info"
		)
	end
end

HANDLERS.PingBeacon = function(ctx)
	local beacon = ctx.device
	if not beacon then
		return
	end
	if attr(beacon, "Active") == true then
		Feedback.send(ctx.player, tagOf(beacon), "Beacon already broadcasting.", "info")
		return
	end
	Environment.activateBeacon(beacon)
	local key = objective(beacon, "Objective")
	if key then
		Mission.add(key, 1)
	end
	local message = attr(beacon, "Message")
	Feedback.send(
		ctx.player,
		tagOf(beacon),
		labelOf(beacon)
			.. " is broadcasting on the emergency band and extends the mesh."
			.. (if typeof(message) == "string" then "\nMESSAGE: " .. message else ""),
		"success"
	)
end

HANDLERS.DeployRelay = function(ctx)
	local relays = attr(ctx.drone, "Relays")
	if typeof(relays) ~= "number" or relays <= 0 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { ctx.drone }
	local held = DroneService.carried(ctx.player)
	if held then
		table.insert(exclude, held)
	end
	params.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(ctx.hull.Position, Vector3.new(0, -14, 0), params)
	local base = if hit then hit.Position else ctx.hull.Position - Vector3.new(0, 1.5, 0)

	local model = Instance.new("Model")
	model.Name = "RelayNode"
	local function part(
		name: string,
		size: Vector3,
		cf: CFrame,
		color: Color3,
		material: Enum.Material,
		shape: Enum.PartType?
	): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.Parent = model
		return p
	end
	local foot = part(
		"Foot",
		Vector3.new(0.3, 1.6, 1.6),
		CFrame.new(base + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(40, 42, 48),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	part(
		"Mast",
		Vector3.new(3, 0.25, 0.25),
		CFrame.new(base + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(110, 114, 122),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	local tip = part(
		"Tip",
		Vector3.one * 0.7,
		CFrame.new(base + Vector3.new(0, 3.4, 0)),
		Config.MODULES.DataJack.color,
		Enum.Material.Neon,
		Enum.PartType.Ball
	)
	local glow = Instance.new("PointLight")
	glow.Color = tip.Color
	glow.Range = 10
	glow.Brightness = 1
	glow.Parent = tip
	model.PrimaryPart = foot

	local spec = Config.DEVICES.RelayNode
	model:SetAttribute("DeviceType", "RelayNode")
	model:SetAttribute("DeviceId", ("%s-%04X"):format(spec.prefix, math.random(0, 65535)))
	model:SetAttribute("Label", "Mesh relay (" .. ctx.player.DisplayName .. ")")
	model:SetAttribute("Status", "MESH NODE ONLINE")
	model:SetAttribute("LinkRange", Config.LINK.RELAY_RANGE)
	model:SetAttribute("Temperature", 35)
	model:SetAttribute("Owner", ctx.player.UserId)
	CollectionService:AddTag(model, "Device")
	CollectionService:AddTag(model, "LinkSource")
	local root = siteRoot(base)
	model.Parent = root:FindFirstChild("Relays") or root

	ctx.drone:SetAttribute("Relays", relays - 1)
	Environment.countRelays()
	Feedback.send(
		ctx.player,
		"MESH // " .. tostring(model:GetAttribute("DeviceId")),
		("Relay node deployed (%d left). Link here: %d%%."):format(
			relays - 1,
			math.floor(Link.at(ctx.hull.Position) * 100)
		),
		"success"
	)
end

HANDLERS.RetrieveRelay = function(ctx)
	local relay = ctx.device
	if not relay then
		return
	end
	local relays = attr(ctx.drone, "Relays")
	local count = if typeof(relays) == "number" then relays else 0
	if count >= Config.DRONE.MAX_RELAYS then
		Feedback.send(ctx.player, "MESH", "Relay rack is full.", "info")
		return
	end
	relay:Destroy()
	ctx.drone:SetAttribute("Relays", count + 1)
	Environment.countRelays()
	Feedback.send(
		ctx.player,
		"MESH",
		("Relay node recovered (%d carried)."):format(count + 1),
		"info"
	)
end

HANDLERS.LoadMed = function(ctx)
	DroneService.setCargo(ctx.drone, true)
	Feedback.send(
		ctx.player,
		"PAYLOAD",
		"Med kit loaded: antipyretics, antivirals, oral rehydration. Drop it within 3m of a patient.",
		"info"
	)
end

HANDLERS.DropMed = function(ctx)
	DroneService.setCargo(ctx.drone, false)
	local crate = Instance.new("Part")
	crate.Name = "MedKit"
	crate.Size = Vector3.new(1.1, 0.9, 1.1)
	crate.Color = Color3.fromRGB(230, 230, 225)
	crate.CFrame = ctx.hull.CFrame * CFrame.new(0, -1.8, 0)
	crate.Parent = siteRoot(ctx.hull.Position)
	local cross = Instance.new("Part")
	cross.Name = "Cross"
	cross.Size = Vector3.new(0.6, 0.15, 0.02)
	cross.Color = Color3.fromRGB(255, 50, 50)
	cross.Material = Enum.Material.Neon
	cross.CanCollide = false
	cross.Massless = true
	cross.CFrame = crate.CFrame * CFrame.new(0, 0.1, -0.56)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = crate
	weld.Part1 = cross
	weld.Parent = cross
	cross.Parent = crate
	Debris:AddItem(crate, 120)

	local player = ctx.player
	task.delay(1.5, function()
		if not crate.Parent then
			return
		end
		local best: Model? = nil
		local bestDistance = Config.MED_DROP_RADIUS
		for _, resident in CollectionService:GetTagged("Device") do
			if resident:GetAttribute("DeviceType") ~= "Resident" or not resident:IsA("Model") then
				continue
			end
			local distance = (Devices.position(resident) - crate.Position).Magnitude
			if distance <= bestDistance then
				best = resident
				bestDistance = distance
			end
		end
		if not best then
			Feedback.send(
				player,
				"PAYLOAD",
				"Med kit dropped, but no patient is within reach of it.",
				"warning"
			)
		elseif best:GetAttribute("NeedsAid") == true then
			best:SetAttribute("NeedsAid", false)
			best:SetAttribute("Treated", true)
			best:SetAttribute("Status", "TREATED")
			local key = objective(best, "TreatObjective")
			if key then
				Mission.add(key, 1)
			end
			Feedback.send(
				player,
				"PAYLOAD",
				("Med kit reached %s. Treatment started."):format(labelOf(best)),
				"success"
			)
		else
			Feedback.send(
				player,
				"PAYLOAD",
				("Med kit reached %s, who doesn't need it."):format(labelOf(best)),
				"info"
			)
		end
	end)
end

---------------------------------------------------------------------------
-- Validation + dispatch
---------------------------------------------------------------------------

local function lineOfSight(ctx: Context, device: Instance): boolean
	local target = Devices.position(device)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { ctx.drone, device }
	local held = DroneService.carried(ctx.player)
	if held then
		table.insert(exclude, held)
	end
	params.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(ctx.hull.Position, target - ctx.hull.Position, params)
	return hit == nil or (hit.Position - target).Magnitude < 2.5
end

local function onDebrisReleased(player: Player, debris: BasePart)
	task.wait(1.5)
	if not debris.Parent or debris:GetAttribute("Cleared") == true then
		return
	end
	local home = debris:GetAttribute("Home")
	local key = debris:GetAttribute("Objective")
	if typeof(home) ~= "Vector3" or typeof(key) ~= "string" then
		return
	end
	if (debris.Position - home).Magnitude >= Config.DEBRIS_CLEAR_DISTANCE then
		debris:SetAttribute("Cleared", true)
		debris:SetAttribute("Status", "CLEARED")
		Mission.add(key, 1)
		local group = debris:GetAttribute("FloodGroup")
		local effect = ""
		if typeof(group) == "string" then
			local _, _, text = Environment.updateFlood(group)
			effect = "\n" .. text
		end
		Feedback.send(
			player,
			tagOf(debris),
			("%s cleared (%d/%d).%s"):format(
				labelOf(debris),
				Mission.get(key),
				totalOf(key),
				effect
			),
			"success"
		)
	else
		Feedback.send(
			player,
			tagOf(debris),
			"Dropped too close. Move it further away to clear the blockage.",
			"info"
		)
	end
end

function Actions.init()
	DroneService.Released.connect(onDebrisReleased)

	Net.on(
		"DroneAction",
		0.25,
		function(player: Player, rawKind: unknown, rawHardpoint: unknown, rawTarget: unknown)
			if rawKind ~= "Primary" and rawKind ~= "Secondary" then
				return
			end
			if rawHardpoint ~= "A" and rawHardpoint ~= "B" then
				return
			end
			local drone = DroneService.get(player)
			local hull = DroneService.hull(player)
			if not drone or not hull then
				return
			end
			local kind = rawKind :: string
			local module = drone:GetAttribute("Hardpoint" .. (rawHardpoint :: string))
			if typeof(module) ~= "string" then
				return
			end
			local ctx: Context = { player = player, drone = drone, hull = hull, device = nil }

			-- Resolve the target (untrusted): must be a real, tagged device in range and in sight
			local device: Instance? = nil
			if typeof(rawTarget) == "Instance" then
				local root = Devices.root(rawTarget)
				if root and root:IsDescendantOf(Workspace) then
					local distance = (Devices.position(root) - hull.Position).Magnitude
					if distance <= Config.DRONE.INTERACT_RANGE + Devices.extent(root) then
						device = root
					end
				end
			end
			if device and not lineOfSight(ctx, device) then
				Feedback.send(
					player,
					"NO LINE OF SIGHT",
					"Something is between the drone and the target. Get closer.",
					"warning"
				)
				return
			end

			local action = Devices.resolve(module, kind, Devices.typeOf(device), drone)
			if not action then
				return
			end

			-- Without a command link only the onboard failsafe (auto-deploy a relay) works
			if action ~= "DeployRelay" and Link.at(hull.Position) < Config.LINK.LOST then
				Feedback.send(
					player,
					"LINK LOST",
					"Command uplink down. Deploy a mesh relay, or fly back toward a dock.",
					"danger"
				)
				return
			end
			ctx.device = device
			local handler = HANDLERS[action]
			if handler then
				handler(ctx)
			end
		end
	)
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">DroneService</string>
            <string name="Source"><![CDATA[--!strict
-- One drone per pilot. There is no character (CharacterAutoLoads = false):
-- the drone IS the player. The drone is an unanchored assembly whose physics
-- is owned by the pilot's client for smooth, lag-free flight; the server owns
-- its *state* (installed modules, cargo, data packet, relays, grabbed debris).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Sites = require(ReplicatedStorage.Shared.Util.Sites)

local Feedback = require(script.Parent.Parent.Feedback)
local Net = require(script.Parent.Parent.Net)
local Registry = require(script.Parent.Parent.Registry)
local HollowBuilder = require(script.Parent.HollowBuilder)
local WorldBuilder = require(script.Parent.WorldBuilder)

local HULL = Color3.fromRGB(38, 40, 46)
local METAL = Color3.fromRGB(110, 114, 122)
local METAL_DARK = Color3.fromRGB(52, 54, 60)
local CYAN = Color3.fromRGB(0, 230, 255)
local RED = Color3.fromRGB(255, 50, 50)
local WHITE = Color3.fromRGB(230, 230, 225)

local ROTOR_OFFSETS = {
	Vector3.new(-1.7, 0.35, -1.7),
	Vector3.new(1.7, 0.35, -1.7),
	Vector3.new(-1.7, 0.35, 1.7),
	Vector3.new(1.7, 0.35, 1.7),
}

local DroneService = {
	-- fired(player, debris) whenever a pilot lets go of debris for any reason
	Released = Signal.new(),
}

local drones: { [Player]: Model } = {}
local carried: { [Player]: BasePart } = {}
local spawnIndex = 0

-- Welding parts on or off an assembly can reset manual network ownership,
-- which would hand physics back to the server and freeze the pilot's controls.
-- Re-assert ownership after every assembly change (and periodically).
local function reclaim(player: Player)
	local drone = drones[player]
	local hull = drone and drone.PrimaryPart
	if not hull or not hull:IsDescendantOf(Workspace) then
		return
	end
	pcall(function()
		if hull:GetNetworkOwner() ~= player then
			hull:SetNetworkOwner(player)
		end
	end)
end

local function weldTo(hull: BasePart, part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hull
	weld.Part1 = part
	weld.Parent = part
end

local function newPiece(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Metal
	-- The drone carries its own headlight: no self-shadowing of the lens
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Builds the physical module hanging from hardpoint A (left) or B (right).
local function buildModule(drone: Model, hull: BasePart, hardpoint: string, module: string)
	local existing = drone:FindFirstChild("Module" .. hardpoint)
	if existing then
		existing:Destroy()
	end
	local spec = Config.MODULES[module]
	if not spec then
		return
	end
	local holder = Instance.new("Model")
	holder.Name = "Module" .. hardpoint
	holder:SetAttribute("Module", module)
	local side = if hardpoint == "A" then -1 else 1
	local mount = hull.CFrame * CFrame.new(side * 0.75, -0.55, 0)
	local color = spec.color

	local function piece(
		name: string,
		size: Vector3,
		offset: CFrame,
		partColor: Color3,
		material: Enum.Material?
	): Part
		local part = newPiece(holder, name, size, mount * offset, partColor, material)
		weldTo(hull, part)
		return part
	end

	if module == "Sensor" then
		piece("Pod", Vector3.new(0.6, 0.5, 1), CFrame.identity, METAL_DARK)
		piece("Probe", Vector3.new(0.12, 0.12, 1.2), CFrame.new(0, -0.05, -0.9), METAL)
		piece(
			"Tip",
			Vector3.new(0.24, 0.24, 0.24),
			CFrame.new(0, -0.05, -1.5),
			color,
			Enum.Material.Neon
		)
		piece(
			"Intake",
			Vector3.new(0.5, 0.15, 0.4),
			CFrame.new(0, -0.3, 0.2),
			color,
			Enum.Material.Neon
		)
	elseif module == "Arm" then
		piece("Shoulder", Vector3.new(0.5, 0.5, 0.5), CFrame.identity, METAL_DARK)
		piece(
			"Upper",
			Vector3.new(0.25, 0.25, 1.2),
			CFrame.new(0, -0.35, -0.5) * CFrame.Angles(math.rad(35), 0, 0),
			color
		)
		piece(
			"Fore",
			Vector3.new(0.22, 0.22, 1),
			CFrame.new(0, -0.85, -1.1) * CFrame.Angles(math.rad(-25), 0, 0),
			color
		)
		piece("Claw", Vector3.new(0.6, 0.3, 0.5), CFrame.new(0, -1.25, -1.4), METAL)
		piece("FingerL", Vector3.new(0.1, 0.5, 0.15), CFrame.new(-0.22, -1.55, -1.4), METAL)
		piece("FingerR", Vector3.new(0.1, 0.5, 0.15), CFrame.new(0.22, -1.55, -1.4), METAL)
	elseif module == "DataJack" then
		piece("Housing", Vector3.new(0.6, 0.5, 0.8), CFrame.identity, METAL_DARK)
		piece(
			"Spike",
			Vector3.new(0.12, 0.12, 1),
			CFrame.new(0, 0, -0.85),
			color,
			Enum.Material.Neon
		)
		piece("RelayStack", Vector3.new(0.5, 0.35, 0.5), CFrame.new(0, -0.4, 0.15), color)
	elseif module == "Payload" then
		piece("CageTop", Vector3.new(1.4, 0.12, 1.4), CFrame.new(0, -0.05, 0), METAL_DARK)
		for _, corner in
			{
				Vector3.new(-0.65, 0, -0.65),
				Vector3.new(0.65, 0, -0.65),
				Vector3.new(-0.65, 0, 0.65),
				Vector3.new(0.65, 0, 0.65),
			}
		do
			piece(
				"Post",
				Vector3.new(0.1, 1.1, 0.1),
				CFrame.new(corner + Vector3.new(0, -0.6, 0)),
				METAL_DARK
			)
		end
		local loaded = drone:GetAttribute("Payload") == true
		local cargo = piece(
			"Cargo",
			Vector3.new(1.1, 0.9, 1.1),
			CFrame.new(0, -0.65, 0),
			WHITE,
			Enum.Material.SmoothPlastic
		)
		cargo.Transparency = if loaded then 0 else 1
		local cross = piece(
			"CargoCross",
			Vector3.new(0.6, 0.15, 0.02),
			CFrame.new(0, -0.6, -0.56),
			RED,
			Enum.Material.Neon
		)
		cross.Transparency = if loaded then 0 else 1
	end
	holder.Parent = drone
end

local function buildDrone(player: Player, spawn: CFrame): Model
	local drone = Instance.new("Model")
	drone.Name = "Drone_" .. player.UserId

	local hull =
		newPiece(drone, "Hull", Vector3.new(2.6, 0.7, 2.6), spawn, HULL, Enum.Material.Metal)
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.1, 1, 1)

	local function piece(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		material: Enum.Material?
	): Part
		local part = newPiece(drone, name, size, spawn * offset, color, material)
		weldTo(hull, part)
		return part
	end

	piece("Shell", Vector3.new(2.1, 0.35, 2.1), CFrame.new(0, 0.5, 0.1), Color3.fromRGB(28, 30, 34))
	piece(
		"Stripe",
		Vector3.new(1.4, 0.06, 0.15),
		CFrame.new(0, 0.7, -0.8),
		CYAN,
		Enum.Material.Neon
	)
	local lens = piece(
		"Lens",
		Vector3.new(0.3, 0.55, 0.55),
		CFrame.new(0, -0.05, -1.35) * CFrame.Angles(0, math.pi / 2, 0),
		Color3.fromRGB(10, 20, 30),
		Enum.Material.Glass
	)
	lens.Shape = Enum.PartType.Cylinder
	piece(
		"LensRing",
		Vector3.new(0.1, 0.1, 0.1),
		CFrame.new(0, 0.25, -1.32),
		CYAN,
		Enum.Material.Neon
	)
	piece(
		"TailLight",
		Vector3.new(0.5, 0.1, 0.1),
		CFrame.new(0, 0.1, 1.33),
		RED,
		Enum.Material.Neon
	)
	-- Aviation-style nav lights (red port / green starboard) and an anti-collision strobe
	local port = piece(
		"NavPort",
		Vector3.new(0.16, 0.16, 0.16),
		CFrame.new(-2.6, 0.35, -1.7),
		Color3.fromRGB(255, 30, 30),
		Enum.Material.Neon
	)
	local starboard = piece(
		"NavStarboard",
		Vector3.new(0.16, 0.16, 0.16),
		CFrame.new(2.6, 0.35, -1.7),
		Color3.fromRGB(30, 255, 80),
		Enum.Material.Neon
	)
	for _, nav in { port, starboard } do
		local glow = Instance.new("PointLight")
		glow.Color = nav.Color
		glow.Range = 5
		glow.Brightness = 0.6
		glow.Parent = nav
	end
	local strobe = piece(
		"Strobe",
		Vector3.new(0.2, 0.12, 0.2),
		CFrame.new(0, 0.55, 1.1),
		WHITE,
		Enum.Material.Neon
	)
	local flash = Instance.new("PointLight")
	flash.Name = "Flash"
	flash.Color = WHITE
	flash.Range = 9
	flash.Brightness = 0
	flash.Parent = strobe
	-- LiDAR puck on top (spins on clients)
	local puck = piece(
		"Lidar",
		Vector3.new(0.45, 0.7, 0.7),
		CFrame.new(0, 0.9, -0.2) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(24, 24, 28),
		Enum.Material.Metal
	)
	puck.Shape = Enum.PartType.Cylinder
	piece(
		"LidarWindow",
		Vector3.new(0.12, 0.74, 0.74),
		CFrame.new(0, 0.95, -0.2) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(30, 10, 10),
		Enum.Material.Glass
	).Shape =
		Enum.PartType.Cylinder

	for index, offset in ROTOR_OFFSETS do
		local armCenter = offset * Vector3.new(0.5, 0, 0.5)
		piece(
			"Arm",
			Vector3.new(0.25, 0.2, offset.Magnitude),
			CFrame.lookAt(armCenter, offset * Vector3.new(1, 0, 1)),
			METAL_DARK
		)
		local motor = piece(
			"Motor",
			Vector3.new(0.45, 0.4, 0.4),
			CFrame.new(offset) * CFrame.Angles(0, 0, math.pi / 2),
			METAL
		)
		motor.Shape = Enum.PartType.Cylinder
		local guard = piece(
			"Guard",
			Vector3.new(0.1, 2.1, 2.1),
			CFrame.new(offset + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color3.fromRGB(60, 62, 70)
		)
		guard.Shape = Enum.PartType.Cylinder
		guard.Transparency = 0.7

		-- Rotor blade on a Weld so clients can spin it by animating C0
		local blade = newPiece(
			drone,
			"Rotor",
			Vector3.new(1.8, 0.05, 0.22),
			spawn * CFrame.new(offset + Vector3.new(0, 0.25, 0)),
			Color3.fromRGB(20, 20, 22)
		)
		blade.Anchored = false
		blade.CanCollide = false
		blade.CanQuery = false
		blade.CanTouch = false
		blade.Massless = true
		blade:SetAttribute("Spin", if index % 2 == 0 then 1 else -1)
		local weld = Instance.new("Weld")
		weld.Name = "RotorWeld"
		weld.Part0 = hull
		weld.Part1 = blade
		weld.C0 = CFrame.new(offset + Vector3.new(0, 0.25, 0))
		weld.Parent = blade
	end

	local headlight = Instance.new("SpotLight")
	headlight.Name = "Headlight"
	headlight.Face = Enum.NormalId.Front
	headlight.Range = 60
	headlight.Angle = 70
	headlight.Brightness = 2.6
	headlight.Color = Color3.fromRGB(235, 245, 255)
	headlight.Shadows = true
	headlight.Parent = hull

	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = hull

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "Thrust"
	velocity.Attachment0 = center
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = Config.DRONE.MAX_FORCE
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = hull

	local gyro = Instance.new("AlignOrientation")
	gyro.Name = "Gyro"
	gyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
	gyro.Attachment0 = center
	gyro.MaxTorque = 1e6
	gyro.Responsiveness = 30
	gyro.CFrame = spawn.Rotation
	gyro.Parent = hull

	drone.PrimaryPart = hull
	CollectionService:AddTag(drone, "Drone")
	drone:SetAttribute("Owner", player.UserId)
	drone:SetAttribute("Pilot", player.DisplayName)
	drone:SetAttribute("HardpointA", Config.DEFAULT_LOADOUT.A)
	drone:SetAttribute("HardpointB", Config.DEFAULT_LOADOUT.B)
	drone:SetAttribute("Holding", false)
	drone:SetAttribute("Payload", false)
	drone:SetAttribute("Packet", "")
	drone:SetAttribute("Relays", Config.DRONE.MAX_RELAYS)
	drone:SetAttribute("Temperature", Config.DRONE.TEMPERATURE)
	buildModule(drone, hull, "A", Config.DEFAULT_LOADOUT.A)
	buildModule(drone, hull, "B", Config.DEFAULT_LOADOUT.B)
	return drone
end

function DroneService.get(player: Player): Model?
	return drones[player]
end

function DroneService.hull(player: Player): BasePart?
	local drone = drones[player]
	local hull = drone and drone.PrimaryPart
	return hull
end

function DroneService.carried(player: Player): BasePart?
	return carried[player]
end

local function findPart(drone: Model, moduleName: string, partName: string): BasePart?
	for _, hardpoint in { "A", "B" } do
		local holder = drone:FindFirstChild("Module" .. hardpoint)
		if holder and holder:GetAttribute("Module") == moduleName then
			local part = holder:FindFirstChild(partName)
			if part and part:IsA("BasePart") then
				return part
			end
		end
	end
	return nil
end

function DroneService.setCargo(drone: Model, loaded: boolean)
	drone:SetAttribute("Payload", loaded)
	for _, name in { "Cargo", "CargoCross" } do
		local part = findPart(drone, "Payload", name)
		if part then
			part.Transparency = if loaded then 0 else 1
		end
	end
end

function DroneService.grab(player: Player, debris: BasePart): boolean
	local drone = drones[player]
	local hull = DroneService.hull(player)
	if not drone or not hull or carried[player] then
		return false
	end
	local claw = findPart(drone, "Arm", "Claw")
	if not claw then
		return false
	end
	debris.Anchored = false
	debris.CFrame = claw.CFrame * CFrame.new(0, -(debris.Size.Y / 2 + 0.45), 0)
	debris.CanCollide = false
	debris.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Name = "GrabWeld"
	weld.Part0 = claw
	weld.Part1 = debris
	weld.Parent = debris
	debris:SetAttribute("Carried", true)
	drone:SetAttribute("Holding", true)
	carried[player] = debris
	reclaim(player)
	return true
end

function DroneService.release(player: Player)
	local debris = carried[player]
	if not debris then
		return
	end
	carried[player] = nil
	local weld = debris:FindFirstChild("GrabWeld")
	if weld then
		weld:Destroy()
	end
	debris.CanCollide = true
	debris.Massless = false
	debris:SetAttribute("Carried", false)
	local drone = drones[player]
	if drone then
		drone:SetAttribute("Holding", false)
	end
	reclaim(player)
	DroneService.Released.fire(player, debris)
end

function DroneService.nearDock(player: Player): boolean
	local hull = DroneService.hull(player)
	if not hull then
		return false
	end
	for _, dock in CollectionService:GetTagged("Device") do
		if
			dock:GetAttribute("DeviceType") == "Dock"
			and (Devices.position(dock) - hull.Position).Magnitude
				<= Config.DRONE.DOCK_RANGE + 2
		then
			return true
		end
	end
	return false
end

local function spawnFor(player: Player)
	if drones[player] then
		return
	end
	spawnIndex += 1
	local offset = ((spawnIndex - 1) % 4 - 1.5) * 4
	local drone = buildDrone(player, DroneService.spawnPoint(Config.DEFAULT_SITE, offset))
	local folder = Workspace:FindFirstChild("Drones") or Workspace
	drone.Parent = folder
	drones[player] = drone
	local hull = drone.PrimaryPart
	if hull then
		hull:SetNetworkOwner(player)
	end
end

local function despawn(player: Player)
	DroneService.release(player)
	local drone = drones[player]
	if drone then
		drone:Destroy()
	end
	drones[player] = nil
end

function DroneService.spawnPoint(site: string, offset: number?): CFrame
	local spawn = Registry.spawns[site]
		or Registry.spawns[Config.DEFAULT_SITE]
		or CFrame.new(0, 10, 0)
	return spawn * CFrame.new(offset or 0, 0, 0)
end

local function moveTo(player: Player, cframe: CFrame)
	local drone = drones[player]
	if not drone then
		return
	end
	DroneService.release(player)
	drone:PivotTo(cframe)
	local hull = drone.PrimaryPart
	if hull then
		hull.AssemblyLinearVelocity = Vector3.zero
		hull.AssemblyAngularVelocity = Vector3.zero
	end
	reclaim(player)
end

function DroneService.init()
	WorldBuilder.get()
	HollowBuilder.get()

	Players.PlayerAdded:Connect(spawnFor)
	for _, player in Players:GetPlayers() do
		spawnFor(player)
	end
	Players.PlayerRemoving:Connect(despawn)

	Net.on("SetLoadout", 1, function(player: Player, raw: unknown)
		local drone = drones[player]
		local hull = DroneService.hull(player)
		if not drone or not hull or typeof(raw) ~= "table" then
			return
		end
		local loadout = raw :: { [unknown]: unknown }
		local a, b = loadout.A, loadout.B
		if typeof(a) ~= "string" or typeof(b) ~= "string" or a == b then
			return
		end
		if not Config.MODULES[a] or not Config.MODULES[b] then
			return
		end
		if not DroneService.nearDock(player) then
			Feedback.send(
				player,
				"LOADOUT",
				"Module swap needs a dock. Fly onto a dock pad first.",
				"warning"
			)
			return
		end
		if a ~= "Arm" and b ~= "Arm" then
			DroneService.release(player)
		end
		if a ~= "Payload" and b ~= "Payload" then
			drone:SetAttribute("Payload", false)
		end
		drone:SetAttribute("HardpointA", a)
		drone:SetAttribute("HardpointB", b)
		buildModule(drone, hull, "A", a)
		buildModule(drone, hull, "B", b)
		reclaim(player)
		-- Docks restock relay nodes
		drone:SetAttribute("Relays", Config.DRONE.MAX_RELAYS)
		Feedback.send(
			player,
			"LOADOUT",
			("A: %s\nB: %s"):format(Config.MODULES[a].label, Config.MODULES[b].label),
			"success"
		)
	end)

	Net.on("Recall", 3, function(player: Player)
		local hull = DroneService.hull(player)
		if not hull then
			return
		end
		local site = Sites.at(hull.Position)
		moveTo(player, DroneService.spawnPoint(site))
		Feedback.send(player, "RECALL", "Drone returned to the home dock.", "info")
	end)

	Net.on("SelectSite", 2, function(player: Player, raw: unknown)
		if typeof(raw) ~= "string" or not Config.SITES[raw] then
			return
		end
		moveTo(player, DroneService.spawnPoint(raw))
		player:SetAttribute("Site", raw)
		Feedback.send(player, "DEPLOYED", Config.SITES[raw].name, "info")
	end)
end

function DroneService.start()
	while true do
		task.wait(2)
		for player in drones do
			reclaim(player)
		end
	end
end

return DroneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Environment</string>
            <string name="Source"><![CDATA[--!strict
-- The world simulation, generic across sites. Builders register flood and
-- vent groups in Registry; devices point at them with attributes.
--   floods   valves + cleared debris drive a water level
--   vents    a breaker runs fans that clear gas clouds in its group
--   jammers  cut the cable and the Directorate jammer dies
--   beacons  pinged beacons broadcast SOS and extend the mesh
--   patients treated residents recover over time
--   truth    the Hollow's propaganda screens can be taken over
-- Pure visuals (fan spin, strobes, flicker) run on clients in Ambience.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Units = require(ReplicatedStorage.Shared.Util.Units)

local Characters = require(script.Parent.Parent.Characters)
local Feedback = require(script.Parent.Parent.Feedback)
local Mission = require(script.Parent.Parent.Mission)
local Registry = require(script.Parent.Parent.Registry)
local HollowBuilder = require(script.Parent.HollowBuilder)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Environment = {}

local ventOn: { [string]: boolean } = {}

local function devices(deviceType: string): { Instance }
	local out = {}
	for _, instance in CollectionService:GetTagged("Device") do
		if
			instance:GetAttribute("DeviceType") == deviceType and instance:IsDescendantOf(Workspace)
		then
			table.insert(out, instance)
		end
	end
	return out
end

local function setLamp(model: Instance, name: string, color: Color3)
	local lamp = model:FindFirstChild(name, true)
	if lamp and lamp:IsA("BasePart") then
		lamp.Color = color
		local pointLight = lamp:FindFirstChildOfClass("PointLight")
		if pointLight then
			pointLight.Color = color
		end
	end
end

---------------------------------------------------------------------------
-- Floods
---------------------------------------------------------------------------

-- Recomputes a flood group's water from its valves and cleared debris.
-- Returns (level, valves set correctly, description of the effect).
function Environment.updateFlood(group: string): (number, number, string)
	local spec = Registry.floods[group]
	if not spec then
		return 0, 0, ""
	end
	local correct = 0
	for _, valve in spec.valves do
		if (valve:GetAttribute("Open") == true) == (valve:GetAttribute("CorrectOpen") == true) then
			correct += 1
		end
	end
	local cleared = 0
	for _, debris in devices("Debris") do
		if
			debris:GetAttribute("Objective") == spec.debrisObjective
			and debris:GetAttribute("Cleared") == true
		then
			cleared += 1
		end
	end
	local progress = correct / math.max(1, #spec.valves) * 0.55
		+ math.min(cleared, spec.debrisTotal) / math.max(1, spec.debrisTotal) * 0.45
	local level = spec.apply(progress)
	Mission.set(spec.valveObjective, correct)
	return level, correct, spec.describe(level)
end

---------------------------------------------------------------------------
-- Ventilation
---------------------------------------------------------------------------

function Environment.setVent(group: string, on: boolean): string
	local spec = Registry.vents[group]
	if not spec then
		return ""
	end
	ventOn[group] = on
	local breaker = spec.breaker
	breaker:SetAttribute("On", on)
	breaker:SetAttribute("Status", if on then "FANS RUNNING" else "OFF")
	setLamp(
		breaker,
		"StatusLamp",
		if on then Color3.fromRGB(80, 255, 120) else Color3.fromRGB(255, 50, 50)
	)
	for _, fan in CollectionService:GetTagged("Fan") do
		if fan:GetAttribute("VentGroup") == group then
			fan:SetAttribute("Running", on)
		end
	end
	Mission.set(spec.objective, if on then 1 else 0)
	return if on then spec.onText else spec.offText
end

local function gasStep()
	for _, cloud in CollectionService:GetTagged("GasCloud") do
		if cloud:IsA("BasePart") then
			local group = cloud:GetAttribute("VentGroup")
			local scale = cloud:GetAttribute("Scale")
			local radius = cloud:GetAttribute("Radius")
			if
				typeof(group) == "string"
				and typeof(scale) == "number"
				and typeof(radius) == "number"
			then
				local on = ventOn[group] == true
				local target = if on then Config.GAS_VENTED_SCALE else 1
				local rate = if on then Config.GAS_VENT_RATE else 0.01
				local nextScale = if scale > target
					then math.max(target, scale - rate)
					else math.min(target, scale + rate)
				if nextScale ~= scale then
					cloud:SetAttribute("Scale", nextScale)
					cloud.Size = Vector3.one * math.max(0.2, radius * 2 * nextScale)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Network
---------------------------------------------------------------------------

function Environment.activateBeacon(beacon: Instance)
	beacon:SetAttribute("Active", true)
	beacon:SetAttribute("Status", "BROADCASTING SOS")
	beacon:SetAttribute("LinkRange", Config.LINK.BEACON_RANGE)
	beacon:SetAttribute("Temperature", 40)
end

function Environment.disableJammer(jammer: Instance)
	jammer:SetAttribute("Active", false)
	jammer:SetAttribute("Status", "DISABLED (cable cut)")
	jammer:SetAttribute("Temperature", 30)
	for _, glow in jammer:GetDescendants() do
		if glow:IsA("BasePart") and glow.Name == "Glow" then
			glow.Color = Color3.fromRGB(40, 20, 30)
			glow.Material = Enum.Material.SmoothPlastic
			local pointLight = glow:FindFirstChildOfClass("PointLight")
			if pointLight then
				pointLight.Enabled = false
			end
			-- A short shower of sparks from the cut
			local sparks = Instance.new("ParticleEmitter")
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Color =
				ColorSequence.new(Color3.fromRGB(255, 210, 120), Color3.fromRGB(255, 90, 20))
			sparks.LightEmission = 1
			sparks.Size = NumberSequence.new(0.18, 0.02)
			sparks.Lifetime = NumberRange.new(0.4, 0.9)
			sparks.Speed = NumberRange.new(8, 18)
			sparks.SpreadAngle = Vector2.new(60, 60)
			sparks.Acceleration = Vector3.new(0, -60, 0)
			sparks.Drag = 1
			sparks.Rate = 0
			sparks.Parent = glow
			sparks:Emit(60)
			task.delay(3, function()
				sparks:Destroy()
			end)
		end
	end
	local cable = jammer:FindFirstChild("Cable", true)
	if cable and cable:IsA("BasePart") then
		cable.Size = Vector3.new(cable.Size.X, cable.Size.Y * 0.5, cable.Size.Z)
		cable.CFrame = cable.CFrame * CFrame.new(0, -cable.Size.Y / 2, 0)
	end
end

local function inside(zone: BasePart, position: Vector3): boolean
	local localPos = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(localPos.X) <= half.X
		and math.abs(localPos.Y) <= half.Y
		and math.abs(localPos.Z) <= half.Z
end

-- Recounts deployed relays inside every RelayZone (one objective per zone).
function Environment.countRelays()
	local relays = devices("RelayNode")
	for _, zone in CollectionService:GetTagged("RelayZone") do
		local objective = zone:GetAttribute("Objective")
		if zone:IsA("BasePart") and typeof(objective) == "string" then
			local count = 0
			for _, relay in relays do
				if inside(zone, Devices.position(relay)) then
					count += 1
				end
			end
			Mission.set(objective, count)
		end
	end
end

---------------------------------------------------------------------------
-- The truth broadcast (Hollow, OP-5)
---------------------------------------------------------------------------

local function countWhere(predicate: (Instance) -> boolean): number
	local count = 0
	for _, resident in devices("Resident") do
		if Devices.position(resident).Z > 1000 and predicate(resident) then
			count += 1
		end
	end
	return count
end

function Environment.broadcast(player: Player)
	local located = countWhere(function(r)
		return r:GetAttribute("Located") == true and r:GetAttribute("Condition") ~= "Healthy"
	end)
	local treated = countWhere(function(r)
		return r:GetAttribute("Treated") == true
	end)
	local surface = Workspace:GetAttribute("SurfaceAir")
	local air = if typeof(surface) == "string"
		then surface
		else "O2 20.8% · CO2 428 ppm · PM2.5 9 µg/m³ (Met Station 4 archive)"
	local cases = math.max(located, 4)
	local truth = ("INDEPENDENT DRONE SURVEY · 2087\n\nSURFACE AIR: %s\nVERDICT: BREATHABLE\n\nLEVEL 9 LUNG SICKNESS: %d+ CASES FOUND (Directorate says 3)\nMED KITS DELIVERED: %d\n\nTHE MESH IS OPEN. PASS IT ON."):format(
		air,
		cases,
		treated
	)
	for _, screen in CollectionService:GetTagged("PublicScreen") do
		screen:SetAttribute("Broadcast", true)
		screen:SetAttribute("Status", "RESISTANCE BROADCAST")
		local label = screen:FindFirstChild("Text", true)
		if label and label:IsA("TextLabel") then
			label.Text = truth
			label.TextColor3 = Color3.fromRGB(150, 245, 255)
		end
		local panel = screen:FindFirstChild("Panel", true)
		if panel and panel:IsA("BasePart") then
			panel.Color = Color3.fromRGB(4, 30, 40)
			local glow = panel:FindFirstChildOfClass("SurfaceLight")
			if glow then
				glow.Color = Color3.fromRGB(80, 220, 255)
			end
		end
	end
	Workspace:SetAttribute("TruthBroadcast", true)
	Feedback.all(
		"HOLLOW-WIDE BROADCAST",
		("%s pushed the surface logs through the mesh. Every public screen in Sector 9 now shows the real air data and outbreak count."):format(
			player.DisplayName
		),
		"success"
	)
end

---------------------------------------------------------------------------
-- Patients
---------------------------------------------------------------------------

-- Every person has their own body temperature (BaseTemperature, rolled at
-- build time inside the band for their condition) and wobbles a little
-- around it. Treated patients cool back into the healthy band. Untreated
-- fever patients cough every few seconds (clients play the cough).
local VITALS = Config.VITALS
local vitalsRng = Random.new()
local nextCough: { [Instance]: number } = {}
local phases: { [Instance]: number } = {}

local function wobble(instance: Instance, base: number, t: number): number
	local phase = phases[instance]
	if not phase then
		phase = vitalsRng:NextNumber(0, 100)
		phases[instance] = phase
	end
	local value = base
		+ VITALS.DRIFT
			* (0.6 * math.sin(t * 0.21 + phase) + 0.4 * math.sin(t * 0.53 + phase * 2))
	return math.round(value * 10) / 10
end

local function residentStep(dt: number)
	local t = os.clock()
	for _, person in devices("Resident") do
		local base = person:GetAttribute("BaseTemperature")
		if typeof(base) ~= "number" then
			continue
		end
		local treated = person:GetAttribute("Treated") == true
		if treated then
			local target = person:GetAttribute("RecoveredTemperature")
			if typeof(target) ~= "number" then
				local band = VITALS.Healthy
				target = math.round(vitalsRng:NextNumber(band[1] + 0.3, band[2]) * 10) / 10
				person:SetAttribute("RecoveredTemperature", target)
			end
			if base > (target :: number) then
				base = math.max(target :: number, base - VITALS.RECOVERY_RATE * dt)
				person:SetAttribute("BaseTemperature", base)
			end
		end
		local temperature = wobble(person, base, t)
		if person:GetAttribute("Temperature") ~= temperature then
			person:SetAttribute("Temperature", temperature)
			if treated then
				person:SetAttribute(
					"Status",
					(if temperature >= VITALS.FEVER_LINE then "RECOVERING " else "RECOVERED ")
						.. Units.temp(temperature)
				)
			end
		end
		-- Coughing (fever, untreated)
		if person:GetAttribute("Condition") == "Fever" and not treated then
			local due = nextCough[person]
			if not due then
				nextCough[person] = t + vitalsRng:NextNumber(0, VITALS.COUGH_INTERVAL[2])
			elseif t >= due then
				local interval = VITALS.COUGH_INTERVAL
				nextCough[person] = t + vitalsRng:NextNumber(interval[1], interval[2])
				person:SetAttribute("Cough", ((person:GetAttribute("Cough") or 0) :: number) + 1)
			end
		end
	end
	-- Walkers and background people drift too
	for _, person in CollectionService:GetTagged("Walker") do
		local base = person:GetAttribute("BaseTemperature")
		if typeof(base) == "number" then
			person:SetAttribute("Temperature", wobble(person, base, t))
		end
	end
	for _, part in CollectionService:GetTagged("Heat") do
		local base = part:GetAttribute("BaseTemperature")
		if typeof(base) == "number" then
			part:SetAttribute("Temperature", wobble(part, base, t))
		end
	end
end

function Environment.init()
	WorldBuilder.get()
	HollowBuilder.get()
	Characters.settle()
	for group in Registry.floods do
		Environment.updateFlood(group)
	end
	for group in Registry.vents do
		Environment.setVent(group, false)
	end
end

function Environment.start()
	while true do
		local dt = task.wait(0.5)
		gasStep()
		residentStep(dt)
	end
end

return Environment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Guides</string>
            <string name="Source"><![CDATA[--!strict
-- Guide mode: in a blackout people can't see, but they can follow a sound.
-- A pilot targets a lost resident and turns on the drone's guide beacon (a
-- beep and a pulsing green light). The person then walks after the drone:
-- the server pathfinds over the real geometry (decks, ramps, stairs) toward
-- the floor under the drone, keeps a few metres back, stops if the beeping
-- gets too far away, and is reunited when they reach their family.
--
-- People are R15 humanoids: the server walks them with Humanoid:MoveTo from
-- waypoint to waypoint, and Characters plays the default walk animation
-- from their speed.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local Characters = require(script.Parent.Parent.Characters)
local Feedback = require(script.Parent.Parent.Feedback)
local Mission = require(script.Parent.Parent.Mission)
local DroneService = require(script.Parent.DroneService)

local DRONE = Config.DRONE

type Walker = {
	model: Model,
	humanoid: Humanoid,
	guide: Player?,
	waypoints: { Vector3 },
	index: number,
	lastGoal: Vector3?,
	lastPathAt: number,
	lostSince: number?,
	thread: thread?,
}

local Guides = {}

local walkers: { [Model]: Walker } = {}

local function walkerFor(model: Model): Walker
	local existing = walkers[model]
	if existing then
		return existing
	end
	local walker: Walker = {
		model = model,
		humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid,
		guide = nil,
		waypoints = {},
		index = 1,
		lastGoal = nil,
		lastPathAt = 0,
		lostSince = nil,
		thread = nil,
	}
	walkers[model] = walker
	return walker
end

local function feetOf(walker: Walker): Vector3
	return Characters.feet(walker.model)
end

-- Stop walking where they stand
local function halt(walker: Walker)
	local root = walker.model.PrimaryPart
	if root then
		walker.humanoid:MoveTo(root.Position)
	end
end

-- Turn in place toward a point (only while standing still)
local function face(walker: Walker, point: Vector3)
	local root = walker.model.PrimaryPart
	if not root then
		return
	end
	local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
	if flat.Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
	end
end

local downParams = RaycastParams.new()
downParams.FilterType = Enum.RaycastFilterType.Exclude
downParams.RespectCanCollide = true

-- The walkable floor under the drone (where the person should head).
local function floorUnder(position: Vector3, walker: Walker): Vector3?
	local exclude: { Instance } = { walker.model }
	local drones = Workspace:FindFirstChild("Drones")
	if drones then
		table.insert(exclude, drones)
	end
	downParams.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(position, Vector3.new(0, -60, 0), downParams)
	return if hit then hit.Position else nil
end

local function family(walker: Walker): Model?
	local name = walker.model:GetAttribute("ReuniteWith")
	if typeof(name) ~= "string" then
		return nil
	end
	for _, model in CollectionService:GetTagged("Walker") do
		if model:IsA("Model") and model:GetAttribute("Family") == name then
			return model
		end
	end
	return nil
end

local function stop(walker: Walker, status: string)
	local player = walker.guide
	walker.guide = nil
	walker.waypoints = {}
	walker.model:SetAttribute("FollowerOf", 0)
	walker.model:SetAttribute("Status", status)
	halt(walker)
	if player then
		local drone = DroneService.get(player)
		if drone then
			drone:SetAttribute("Guiding", "")
		end
	end
end

local function reunite(walker: Walker, relative: Model)
	local player = walker.guide
	local name = tostring(walker.model:GetAttribute("Label") or "Resident")
	stop(walker, "REUNITED WITH FAMILY")
	face(walker, relative:GetPivot().Position)
	walker.model:SetAttribute("Lost", false)
	relative:SetAttribute("Status", "REUNITED")
	local objective = walker.model:GetAttribute("Objective")
	if typeof(objective) == "string" then
		Mission.add(objective, 1)
	end
	Feedback.all(
		"FAMILY REUNITED",
		("%s followed %s's drone %s and found %s at %s."):format(
			name,
			if player then player.DisplayName else "a",
			tostring(walker.model:GetAttribute("Route") or "through the blackout"),
			tostring(relative:GetAttribute("Label") or "their family"),
			tostring(relative:GetAttribute("Place") or "the meeting point")
		),
		"success"
	)
end

local function computePath(walker: Walker, goal: Vector3): boolean
	local path = PathfindingService:CreatePath({
		AgentRadius = 1.4,
		AgentHeight = 5.5,
		AgentCanJump = false,
		WaypointSpacing = 4,
	})
	local ok = pcall(function()
		path:ComputeAsync(feetOf(walker) + Vector3.new(0, 0.5, 0), goal)
	end)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		return false
	end
	walker.waypoints = {}
	for _, waypoint in path:GetWaypoints() do
		table.insert(walker.waypoints, waypoint.Position)
	end
	walker.index = 2
	return true
end

-- One walker's behaviour loop while it is being guided.
local function follow(walker: Walker)
	local unreachableSince: number? = nil
	local lastProgress = os.clock()
	local lastFeet = feetOf(walker)
	while walker.guide do
		task.wait(0.1)
		local player = walker.guide :: Player
		local hull = DroneService.hull(player)
		local drone = DroneService.get(player)
		if
			not hull
			or not drone
			or drone:GetAttribute("Guiding") ~= walker.model:GetAttribute("Label")
		then
			stop(walker, "STOPPED · NO BEACON")
			break
		end

		local feet = feetOf(walker)
		local toDrone = hull.Position - feet
		if toDrone.Magnitude > DRONE.GUIDE_RANGE then
			-- Out of earshot: wait where they are
			if not walker.lostSince then
				walker.lostSince = os.clock()
				halt(walker)
				walker.waypoints = {}
				walker.model:SetAttribute("Status", "WAITING · CAN'T HEAR THE DRONE")
				Feedback.send(
					player,
					"GUIDE",
					"Lost contact: they can't hear the beacon. Come back closer.",
					"warning"
				)
			end
		else
			walker.lostSince = nil
			local goal = floorUnder(hull.Position, walker)
			local flat = Vector3.new(toDrone.X, 0, toDrone.Z)
			local now = os.clock()
			if goal and (flat.Magnitude > 6 or math.abs(toDrone.Y) > 9) then
				-- Stuck against something for 2 s: plan again from here
				if (feet - lastFeet).Magnitude > 0.5 then
					lastFeet = feet
					lastProgress = now
				end
				local stuck = #walker.waypoints > 0 and now - lastProgress > 2
				local moved = walker.lastGoal == nil
					or (goal - (walker.lastGoal :: Vector3)).Magnitude > 4
				if
					(moved or stuck or walker.index > #walker.waypoints)
					and now - walker.lastPathAt > 0.8
				then
					walker.lastPathAt = now
					walker.lastGoal = goal
					lastProgress = now
					if computePath(walker, goal) then
						unreachableSince = nil
						walker.model:SetAttribute("Status", "FOLLOWING THE BEEPING")
					elseif not unreachableSince then
						unreachableSince = now
					elseif now - (unreachableSince :: number) > 3 then
						unreachableSince = math.huge
						Feedback.send(
							player,
							"GUIDE",
							"No walkable route to where you're hovering. Hover over a floor they can reach.",
							"warning"
						)
					end
				end
				-- Walk the path, stopping a few metres short of the drone
				local nearGoal = (Vector3.new(goal.X, 0, goal.Z) - Vector3.new(feet.X, 0, feet.Z)).Magnitude
					< 4.5
				if nearGoal then
					walker.waypoints = {}
					halt(walker)
				else
					-- Skip waypoints already reached
					while walker.index <= #walker.waypoints do
						local target = walker.waypoints[walker.index]
						local delta = target - feet
						if
							Vector3.new(delta.X, 0, delta.Z).Magnitude < 1.6
							and math.abs(delta.Y) < 3
						then
							walker.index += 1
						else
							break
						end
					end
					local target = walker.waypoints[walker.index]
					if target then
						walker.humanoid:MoveTo(target)
					else
						halt(walker)
					end
				end
			else
				halt(walker)
				walker.waypoints = {}
				if walker.humanoid.MoveDirection.Magnitude < 0.1 then
					face(walker, hull.Position)
				end
			end
		end

		local relative = family(walker)
		if
			relative
			and (relative:GetPivot().Position - walker.model:GetPivot().Position).Magnitude
				<= DRONE.REUNITE_RANGE
		then
			reunite(walker, relative)
			break
		end
	end
	walker.thread = nil
end

-- Called from Actions when a pilot targets a resident with Primary.
function Guides.toggle(player: Player, model: Instance)
	if not model:IsA("Model") or not CollectionService:HasTag(model, "Walker") then
		return
	end
	local walker = walkerFor(model)
	local drone = DroneService.get(player)
	if not drone then
		return
	end
	local name = tostring(model:GetAttribute("Label") or "Resident")
	if walker.guide == player then
		stop(walker, "WAITING")
		Feedback.send(player, "GUIDE", "Beacon off. " .. name .. " will wait here.", "info")
		return
	end
	if model:GetAttribute("Lost") ~= true then
		Feedback.send(player, "GUIDE", name .. " isn't lost: they know where they are.", "info")
		return
	end
	if walker.guide then
		Feedback.send(player, "GUIDE", name .. " is already following another drone.", "info")
		return
	end
	-- One person per drone
	for _, other in walkers do
		if other.guide == player then
			stop(other, "WAITING")
		end
	end
	walker.guide = player
	walker.waypoints = {}
	walker.lastGoal = nil
	walker.lostSince = nil
	model:SetAttribute("FollowerOf", player.UserId)
	model:SetAttribute("Status", "FOLLOWING THE BEEPING")
	drone:SetAttribute("Guiding", name)
	local relative = family(walker)
	Feedback.send(
		player,
		"GUIDE BEACON ON",
		("Beeping + green guide light. %s is following.\nFly slowly: they walk at ~2 m/s and stop if you get more than %d m away.%s"):format(
			name,
			math.floor(DRONE.GUIDE_RANGE * Config.STUDS_TO_METERS),
			if relative and relative:GetAttribute("Place")
				then " Their family is at " .. tostring(relative:GetAttribute("Place")) .. "."
				else ""
		),
		"success"
	)
	walker.thread = task.spawn(follow, walker)
end

function Guides.init()
	Players.PlayerRemoving:Connect(function(player)
		for _, walker in walkers do
			if walker.guide == player then
				stop(walker, "WAITING")
			end
		end
	end)
end

return Guides
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">HollowBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds THE HOLLOW // SECTOR 9: the showcase district. A deep-level city
-- carved into rock, built procedurally at runtime from Terrain (the rock
-- shell, the brick-lined sewer, the flood water, the surface) and parts
-- (everything people built).
--
-- Side section (local coordinates, the site origin is Config.SITES.Hollow.origin):
--
--   y 430  ── surface: grass returning, Met Station 4, the open hatch ──
--          │ LIFT SHAFT ZERO (sealed grate at 246, stuck lift car ~300)
--   y 242  ╭──────── dome: Directorate sodium "sun lamps" ────────╮
--   y 120  │ L6  gallery · hydroponic farm (W)                    │
--   y  80  │ L7  gallery · clinic (N) · CO2 scrubber hall (S)     │  THE WELL
--          │      bridge E -> the Spire (jammer, propaganda)      │  r = 92
--   y  40  │ L8  the DECK: steel plate sealing L9 · Ops Hub (E)   │
--   y   0  │ L9  the Pit: blackout, shelters, quarantine Q-9 (W)  │
--   y  -8  │ Underpass Market (floods)                            │
--   y -26  ╰── COLLECTOR C-2: brick sewer along x, pump room ─────╯

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Characters = require(script.Parent.Parent.Characters)
local Kit = require(script.Parent.Parent.Kit)
local Registry = require(script.Parent.Parent.Registry)

local newPart = Kit.newPart
local cylinder = Kit.cylinder
local ball = Kit.ball
local decor = Kit.decor
local light = Kit.light
local device = Kit.device
local newModel = Kit.newModel

local SITE = Config.SITES.Hollow
local O = SITE.origin
local Terrain = Workspace.Terrain

local WELL_RADIUS = 92
local VOXEL_PAD = 4
local DECK_Y = 40
local LEVELS = { 0, 40, 80, 120 } -- L9, L8, L7, L6 floor heights
local LEVEL_NAMES = { "LEVEL 9", "LEVEL 8", "LEVEL 7", "LEVEL 6" }

-- Palette: weathered, desaturated, lit by practical lights
local CONCRETE = Color3.fromRGB(108, 104, 98)
local CONCRETE_DARK = Color3.fromRGB(70, 68, 64)
local STEEL = Color3.fromRGB(88, 92, 96)
local STEEL_DARK = Color3.fromRGB(44, 46, 50)
local RUST = Color3.fromRGB(110, 70, 48)
local HAZARD = Color3.fromRGB(214, 168, 30)
local SODIUM = Color3.fromRGB(255, 176, 90)
local FLUORESCENT = Color3.fromRGB(214, 236, 255)
local WARM = Color3.fromRGB(255, 196, 140)
local EMERGENCY = Color3.fromRGB(255, 40, 30)
local DIRECTORATE = Color3.fromRGB(220, 30, 40)
local CYAN = Color3.fromRGB(80, 220, 255)
local GLASS_DARK = Color3.fromRGB(20, 24, 28)

local FACADE_TINTS = {
	Color3.fromRGB(122, 112, 98),
	Color3.fromRGB(96, 104, 108),
	Color3.fromRGB(118, 96, 84),
	Color3.fromRGB(86, 92, 82),
	Color3.fromRGB(130, 124, 112),
	Color3.fromRGB(104, 90, 92),
}
local CLOTH = {
	Color3.fromRGB(150, 60, 50),
	Color3.fromRGB(40, 90, 120),
	Color3.fromRGB(170, 140, 70),
	Color3.fromRGB(70, 110, 70),
	Color3.fromRGB(120, 120, 128),
	Color3.fromRGB(150, 100, 60),
}

local rng = Random.new(2087)

local function at(x: number, y: number, z: number): Vector3
	return O + Vector3.new(x, y, z)
end

-- Frame on the Well wall: origin at radius r, angle a (radians), height y.
-- X runs along the wall, Y up, and the front (-Z, LookVector) faces the
-- Well centre: things in front of a wall sit at negative local Z.
local function wallFrame(angle: number, radius: number, y: number): CFrame
	local position = at(math.cos(angle) * radius, y, math.sin(angle) * radius)
	local inward = Vector3.new(-math.cos(angle), 0, -math.sin(angle))
	return CFrame.lookAt(position, position + inward)
end

-- Yaw for Kit terminals so their screen faces from `from` toward `to`.
local function yawToward(from: Vector3, to: Vector3): number
	local d = to - from
	return math.atan2(-d.X, -d.Z)
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	return newPart(parent, name, size, cf, color, material)
end

local function prop(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = newPart(parent, name, size, cf, color, material)
	decor(p)
	return p
end

local function heat(p: BasePart, temperature: number)
	p:SetAttribute("Temperature", temperature)
	CollectionService:AddTag(p, "Heat")
end

local function flicker(p: BasePart, mode: string?)
	p:SetAttribute("FlickerMode", mode or "Fault")
	CollectionService:AddTag(p, "Flicker")
end

-- A ceiling fixture: thin lit tube + SurfaceLight pointing down.
local function tube(
	parent: Instance,
	position: Vector3,
	yaw: number,
	color: Color3,
	on: boolean
): Part
	local fixture = prop(
		parent,
		"Tube",
		Vector3.new(4, 0.25, 0.5),
		CFrame.new(position) * CFrame.Angles(0, yaw, 0),
		if on then color else Color3.fromRGB(60, 62, 64),
		if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	)
	if on then
		local glow = Instance.new("SurfaceLight")
		glow.Face = Enum.NormalId.Bottom
		glow.Color = color
		glow.Range = 18
		glow.Angle = 120
		glow.Brightness = 1.4
		glow.Shadows = false
		glow.Parent = fixture
	end
	return fixture
end

-- High-bay sodium lamp hanging on a cable.
local function highBay(
	parent: Instance,
	position: Vector3,
	range: number,
	brightness: number,
	shadows: boolean
)
	-- Hang the lamp from the dome: cable runs up to the rock overhead
	local horizontal = (position - O) * Vector3.new(1, 0, 1)
	local ceiling = 150 + math.sqrt(math.max(0, WELL_RADIUS ^ 2 - horizontal.Magnitude ^ 2))
	local length = math.max(8, ceiling - (position.Y - O.Y))
	local cable = prop(
		parent,
		"Cable",
		Vector3.new(0.12, length, 0.12),
		CFrame.new(position + Vector3.new(0, 0.6 + length / 2, 0)),
		STEEL_DARK,
		Enum.Material.Metal
	)
	cable.CastShadow = false
	local shade = prop(
		parent,
		"Shade",
		Vector3.new(2.6, 1, 2.6),
		CFrame.new(position + Vector3.new(0, 0.5, 0)),
		STEEL_DARK,
		Enum.Material.Metal
	)
	shade.Shape = Enum.PartType.Cylinder
	shade.CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local bulb = prop(
		parent,
		"Bulb",
		Vector3.new(1.4, 0.4, 1.4),
		CFrame.new(position),
		SODIUM,
		Enum.Material.Neon
	)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Angle = 100
	spot.Range = range
	spot.Brightness = brightness
	spot.Color = SODIUM
	spot.Shadows = shadows
	spot.Parent = bulb
	return bulb
end

local function signage(
	parent: Instance,
	cf: CFrame,
	size: Vector2,
	text: string,
	textColor: Color3,
	backColor: Color3?,
	font: Enum.Font?
): Part
	local board = prop(
		parent,
		"Sign",
		Vector3.new(size.X, size.Y, 0.15),
		cf,
		backColor or Color3.fromRGB(28, 28, 30),
		Enum.Material.SmoothPlastic
	)
	if not backColor then
		board.Transparency = 1
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.6
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.new(1, -16, 1, -8)
	label.Position = UDim2.fromOffset(8, 4)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Font = font or Enum.Font.SourceSansBold
	label.Parent = gui
	return board
end

local function particles(parentPart: BasePart, kind: string): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	if kind == "Steam" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 196))
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.75),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2),
			NumberSequenceKeypoint.new(1, 9),
		})
		emitter.Lifetime = NumberRange.new(4, 7)
		emitter.Rate = 6
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(12, 12)
		emitter.LightInfluence = 0.9
		emitter.RotSpeed = NumberRange.new(-20, 20)
		emitter.Rotation = NumberRange.new(0, 360)
	elseif kind == "Drip" then
		emitter.Color = ColorSequence.new(Color3.fromRGB(150, 160, 150))
		emitter.Transparency = NumberSequence.new(0.35)
		emitter.Size = NumberSequence.new(0.08)
		emitter.Lifetime = NumberRange.new(1.2, 1.8)
		emitter.Rate = 1.5
		emitter.Speed = NumberRange.new(0)
		emitter.Acceleration = Vector3.new(0, -50, 0)
		emitter.LightInfluence = 1
		emitter.EmissionDirection = Enum.NormalId.Bottom
	elseif kind == "Dust" then
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 240, 220))
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Size = NumberSequence.new(0.12)
		emitter.Lifetime = NumberRange.new(8, 14)
		emitter.Rate = 14
		emitter.Speed = NumberRange.new(0.2, 0.8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -0.05, 0)
		emitter.LightInfluence = 1
		emitter.Shape = Enum.ParticleEmitterShape.Box
	elseif kind == "Spores" then
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 220, 190))
		emitter.Transparency = NumberSequence.new(0.8)
		emitter.Size = NumberSequence.new(0.07)
		emitter.Lifetime = NumberRange.new(6, 10)
		emitter.Rate = 10
		emitter.Speed = NumberRange.new(0.1, 0.4)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.LightInfluence = 1
		emitter.Shape = Enum.ParticleEmitterShape.Box
	end
	emitter.Parent = parentPart
	return emitter
end

-- An invisible volume used as an emitter shape, air zone, relay zone...
local function volume(parent: Instance, name: string, center: Vector3, size: Vector3): Part
	local v =
		newPart(parent, name, size, CFrame.new(center), Color3.new(), Enum.Material.SmoothPlastic)
	v.Transparency = 1
	v.CanCollide = false
	v.CanQuery = false
	v.CanTouch = false
	v.CastShadow = false
	return v
end

---------------------------------------------------------------------------
-- People. Proportioned figures; the sick lie in bed under blankets.
---------------------------------------------------------------------------

-- People are R15 Roblox characters (Characters.luau). `cf` is the hip centre.
-- pose: "Stand" | "Sit" | "Lie"
local function person(
	parent: Instance,
	name: string,
	cf: CFrame,
	shirt: Color3,
	pose: string,
	mobile: boolean?
): Model
	return Characters.spawn(parent, name, { pose = pose, cf = cf, shirt = shirt, mobile = mobile })
end

local function bed(parent: Instance, cf: CFrame, blanket: Color3?): CFrame
	part(
		parent,
		"BedFrame",
		Vector3.new(3.4, 1.4, 7),
		cf * CFrame.new(0, 0.7, 0),
		STEEL_DARK,
		Enum.Material.Metal
	)
	part(
		parent,
		"Mattress",
		Vector3.new(3.2, 0.6, 6.8),
		cf * CFrame.new(0, 1.7, 0),
		Color3.fromRGB(150, 146, 136),
		Enum.Material.Fabric
	)
	prop(
		parent,
		"Pillow",
		Vector3.new(2.2, 0.4, 1.1),
		cf * CFrame.new(0, 2.1, 2.7),
		Color3.fromRGB(196, 192, 182),
		Enum.Material.Fabric
	)
	if blanket then
		prop(
			parent,
			"Blanket",
			Vector3.new(3.3, 0.5, 4.4),
			cf * CFrame.new(0, 2.3, -1.1),
			blanket,
			Enum.Material.Fabric
		)
	end
	-- Where a lying figure's hips go (head toward the pillow)
	return cf * CFrame.new(0, 2.4, 0.4)
end

local function bunk(parent: Instance, cf: CFrame)
	for _, x in { -1.6, 1.6 } do
		for _, z in { -3.3, 3.3 } do
			part(
				parent,
				"Post",
				Vector3.new(0.25, 7, 0.25),
				cf * CFrame.new(x, 3.5, z),
				STEEL_DARK,
				Enum.Material.Metal
			)
		end
	end
	for _, y in { 1.4, 4.6 } do
		part(
			parent,
			"Bunk",
			Vector3.new(3.4, 0.5, 6.8),
			cf * CFrame.new(0, y, 0),
			Color3.fromRGB(130, 124, 114),
			Enum.Material.Fabric
		)
		prop(
			parent,
			"Blanket",
			Vector3.new(3.2, 0.3, 3.4),
			cf * CFrame.new(0, y + 0.4, -1.4),
			CLOTH[rng:NextInteger(1, #CLOTH)],
			Enum.Material.Fabric
		)
	end
end

local function crate(parent: Instance, cf: CFrame, size: Vector3?)
	local s = size or Vector3.new(3, 2.4, 3)
	local c = part(
		parent,
		"Crate",
		s,
		cf * CFrame.new(0, s.Y / 2, 0),
		Color3.fromRGB(96, 82, 60),
		Enum.Material.WoodPlanks
	)
	return c
end

local function barrel(parent: Instance, position: Vector3, color: Color3, fire: boolean)
	local b = cylinder(
		parent,
		"Barrel",
		3,
		2.2,
		position + Vector3.new(0, 1.5, 0),
		"Y",
		color,
		Enum.Material.CorrodedMetal
	)
	if fire then
		local flame = Instance.new("Fire")
		flame.Heat = 6
		flame.Size = 3
		flame.Color = Color3.fromRGB(255, 140, 50)
		flame.SecondaryColor = Color3.fromRGB(200, 40, 10)
		flame.Parent = b
		local glow = light(b, Color3.fromRGB(255, 130, 60), 22, 1.6)
		glow.Shadows = true
		glow.Name = "FireLight"
		flicker(b, "Fire")
		heat(b, 180)
	end
	return b
end

---------------------------------------------------------------------------
-- Terrain: rock shell, the Well, rooms, sewer, surface
---------------------------------------------------------------------------

-- Terrain edits are split into <=128-stud blocks: very large single
-- FillBlock regions can be rejected by the engine.
local function carveBlock(center: Vector3, size: Vector3, material: Enum.Material?)
	local fill = material or Enum.Material.Air
	local chunk = 128
	local counts =
		Vector3.new(math.ceil(size.X / chunk), math.ceil(size.Y / chunk), math.ceil(size.Z / chunk))
	local step = Vector3.new(size.X / counts.X, size.Y / counts.Y, size.Z / counts.Z)
	local min = O + center - size / 2
	for ix = 0, counts.X - 1 do
		for iy = 0, counts.Y - 1 do
			for iz = 0, counts.Z - 1 do
				local cellCenter = min
					+ Vector3.new((ix + 0.5) * step.X, (iy + 0.5) * step.Y, (iz + 0.5) * step.Z)
				Terrain:FillBlock(CFrame.new(cellCenter), step, fill)
			end
		end
	end
end

local function buildTerrain()
	Terrain.WaterColor = Color3.fromRGB(46, 52, 34)
	Terrain.WaterTransparency = 0.12
	Terrain.WaterReflectance = 0.35
	Terrain.WaterWaveSize = 0.04
	Terrain.WaterWaveSpeed = 6

	-- Solid shell from the sewer up to the surface
	carveBlock(Vector3.new(0, 175, 10), Vector3.new(500, 510, 520), Enum.Material.Rock)
	-- Strata near the deep levels
	carveBlock(Vector3.new(0, -20, 10), Vector3.new(500, 60, 520), Enum.Material.Slate)
	-- Surface soil, grass coming back
	carveBlock(Vector3.new(0, 418, 10), Vector3.new(500, 8, 520), Enum.Material.Ground)
	carveBlock(Vector3.new(0, 426, 10), Vector3.new(500, 8, 520), Enum.Material.Grass)
	for _ = 1, 18 do
		local x, z = rng:NextNumber(-220, 220), rng:NextNumber(-220, 240)
		if math.abs(x) > 30 or math.abs(z) > 30 then
			Terrain:FillBall(at(x, 430, z), rng:NextNumber(8, 22), Enum.Material.LeafyGrass)
		end
	end
	for _ = 1, 8 do
		Terrain:FillBall(
			at(rng:NextNumber(-200, 200), 431, rng:NextNumber(-200, 220)),
			rng:NextNumber(6, 14),
			Enum.Material.Mud
		)
	end

	-- The Well and its dome
	-- Smooth terrain carves come out about one voxel (4 studs) tighter than the
	-- requested radius, so round carves are padded by VOXEL_PAD
	Terrain:FillCylinder(CFrame.new(at(0, 80, 0)), 160, WELL_RADIUS + VOXEL_PAD, Enum.Material.Air)
	Terrain:FillBall(at(0, 150, 0), WELL_RADIUS + VOXEL_PAD, Enum.Material.Air)
	-- Lift Shaft Zero up to the surface
	carveBlock(Vector3.new(0, 336, 0), Vector3.new(26, 196, 26))

	-- Rooms cut into the walls
	carveBlock(Vector3.new(123, 52, 0), Vector3.new(74, 24, 52)) -- Ops Hub (L8 east)
	carveBlock(Vector3.new(-133, 15, 0), Vector3.new(86, 30, 80)) -- Quarantine Q-9 (L9 west)
	carveBlock(Vector3.new(0, 94, 112), Vector3.new(60, 28, 50)) -- Scrubber hall (L7 south)
	carveBlock(Vector3.new(0, 92, -106), Vector3.new(50, 24, 36)) -- Clinic (L7 north)
	carveBlock(Vector3.new(-112, 132, 0), Vector3.new(50, 24, 70)) -- Farm (L6 west)

	-- Collector C-2: a brick-lined tunnel along x under the Pit
	local tunnelCf = CFrame.new(at(0, -26, 60)) * CFrame.Angles(0, 0, math.pi / 2)
	Terrain:FillCylinder(tunnelCf, 400, 19 + VOXEL_PAD, Enum.Material.Brick)
	Terrain:FillCylinder(tunnelCf, 400, 16 + VOXEL_PAD, Enum.Material.Air)
	carveBlock(Vector3.new(-60, -22, 60), Vector3.new(30, 30, 44)) -- pump room
	carveBlock(Vector3.new(-60, -4, 60), Vector3.new(10, 10, 10)) -- exhaust shaft to the Pit
	carveBlock(Vector3.new(0, -4, 64), Vector3.new(80, 8, 48)) -- Underpass Market
	carveBlock(Vector3.new(0, -9, 64), Vector3.new(12, 8, 12)) -- breach into the sewer
end

---------------------------------------------------------------------------
-- Flood water (terrain) for Collector C-2 + the Underpass
---------------------------------------------------------------------------

type WaterBody = {
	min: Vector2, -- x, z
	max: Vector2,
	bottom: number,
	high: number,
	low: number,
	level: number,
	target: number,
	running: boolean,
}

-- Collector C-2 is surcharged (half full); the Underpass Market is flooded
-- by backflow through the breach. Both drain as the operation progresses.
local TUNNEL: WaterBody = {
	min = Vector2.new(-204, 40),
	max = Vector2.new(204, 84),
	bottom = -44,
	high = -28,
	low = -40,
	level = -44,
	target = -28,
	running = false,
}
local UNDERPASS: WaterBody = {
	min = Vector2.new(-40, 40),
	max = Vector2.new(40, 88),
	bottom = -8,
	high = -4,
	low = -8,
	level = -8,
	target = -4,
	running = false,
}

local function waterSlab(body: WaterBody, y0: number, y1: number): Region3
	local min = at(body.min.X, y0, body.min.Y)
	local max = at(body.max.X, y1, body.max.Y)
	return Region3.new(min, max):ExpandToGrid(4)
end

local function runWater(body: WaterBody)
	if body.running then
		return
	end
	body.running = true
	task.spawn(function()
		while body.level ~= body.target do
			if body.level < body.target then
				Terrain:ReplaceMaterial(
					waterSlab(body, body.level, body.level + 4),
					4,
					Enum.Material.Air,
					Enum.Material.Water
				)
				body.level += 4
			else
				Terrain:ReplaceMaterial(
					waterSlab(body, body.level - 4, body.level),
					4,
					Enum.Material.Water,
					Enum.Material.Air
				)
				body.level -= 4
			end
			task.wait(1.2)
		end
		body.running = false
	end)
end

local function fillNow(body: WaterBody)
	Terrain:ReplaceMaterial(
		waterSlab(body, body.bottom, body.high),
		4,
		Enum.Material.Air,
		Enum.Material.Water
	)
	body.level = body.high
	body.target = body.high
end

-- progress 0 (flooded) .. 1 (drained). Returns the tunnel level.
local function setWater(progress: number): number
	for _, body in { TUNNEL, UNDERPASS } do
		local level = body.high + (body.low - body.high) * progress
		body.target = math.clamp(math.floor((level + 2) / 4) * 4, body.low, body.high)
		runWater(body)
	end
	Workspace:SetAttribute("UnderpassFlooded", UNDERPASS.target > UNDERPASS.low)
	return TUNNEL.target
end

---------------------------------------------------------------------------
-- Floors: the Pit floor (L9) and the Deck (L8) as plate grids
---------------------------------------------------------------------------

type Cell = { x: number, z: number }

local function plateGrid(
	parent: Instance,
	name: string,
	y: number,
	color: Color3,
	material: Enum.Material,
	skip: (number, number) -> boolean,
	vents: { Cell }?
)
	local isVent: { [string]: boolean } = {}
	for _, cell in (vents or {}) :: { Cell } do
		isVent[cell.x .. "," .. cell.z] = true
	end
	for ix = -6, 5 do
		for iz = -6, 5 do
			local x, z = ix * 16 + 8, iz * 16 + 8
			if math.sqrt(x * x + z * z) <= WELL_RADIUS + 10 and not skip(x, z) then
				if isVent[x .. "," .. z] then
					-- Plate with a 7x7 hole, hazard frame and a half-broken grate
					for _, piece in Kit.solids(-8, 8, -8, 8, { Kit.rect(-3.5, 3.5, -3.5, 3.5) }) do
						part(
							parent,
							name,
							Vector3.new(piece.a1 - piece.a0, 1.5, piece.b1 - piece.b0),
							CFrame.new(
								at(
									x + (piece.a0 + piece.a1) / 2,
									y - 0.75,
									z + (piece.b0 + piece.b1) / 2
								)
							),
							color,
							material
						)
					end
					for _, edge in
						{
							{ 0, -3.7, 7.6, 0.4 },
							{ 0, 3.7, 7.6, 0.4 },
							{ -3.7, 0, 0.4, 7.6 },
							{ 3.7, 0, 0.4, 7.6 },
						}
					do
						prop(
							parent,
							"VentFrame",
							Vector3.new(edge[3], 0.1, edge[4]),
							CFrame.new(at(x + edge[1], y + 0.02, z + edge[2])),
							HAZARD,
							Enum.Material.SmoothPlastic
						)
					end
					for i = 0, 1 do
						part(
							parent,
							"GrateBar",
							Vector3.new(0.3, 0.3, 7),
							CFrame.new(at(x - 3 + i * 0.9, y - 0.4, z))
								* CFrame.Angles(0.25 * i, 0, 0),
							RUST,
							Enum.Material.CorrodedMetal
						)
					end
					signage(
						parent,
						CFrame.new(at(x, y + 0.03, z + 5.9)) * CFrame.Angles(math.pi / 2, 0, 0),
						Vector2.new(9, 1.5),
						"SERVICE VENT · DRONE ACCESS",
						HAZARD,
						nil,
						Enum.Font.Code
					)
				else
					part(
						parent,
						name,
						Vector3.new(16, 1.5, 16),
						CFrame.new(at(x, y - 0.75, z)),
						color,
						material
					)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Facades around the Well: apartments stacked into the rock
---------------------------------------------------------------------------

local SEGMENTS = 20

type FacadeOptions = {
	lit: number, -- 0..1 share of windows lit
	opening: { number }?, -- {width, height} of a big central opening (room entrance)
	dark: boolean?,
}

local function facade(
	parent: Instance,
	angle: number,
	y: number,
	height: number,
	options: FacadeOptions
)
	local width = 2 * WELL_RADIUS * math.sin(math.pi / SEGMENTS) + 1.2
	local frame = wallFrame(angle, WELL_RADIUS - 1.4, y)
	local tint = FACADE_TINTS[rng:NextInteger(1, #FACADE_TINTS)]

	local holes = {}
	local windows = {}
	local floors = math.floor(height / 12)
	if options.opening then
		local w, h = options.opening[1], options.opening[2]
		table.insert(holes, Kit.rect(-w / 2, w / 2, 0.5, h))
	end
	for storey = 0, floors - 1 do
		local base = storey * 12
		for slot = -2, 2 do
			local cx = slot * (width / 5)
			local blocked = false
			if options.opening then
				local w, h = options.opening[1], options.opening[2]
				blocked = math.abs(cx) < w / 2 + 3 and base < h
			end
			if not blocked then
				if slot == 0 and storey == 0 then
					table.insert(holes, Kit.rect(cx - 1.6, cx + 1.6, 0.5, 7.5)) -- door
					table.insert(windows, { cx, 4, 3.2, 7, 1 })
				else
					table.insert(holes, Kit.rect(cx - 2, cx + 2, base + 4, base + 8))
					table.insert(windows, { cx, base + 6, 4, 4, 0 })
				end
			end
		end
	end

	for _, piece in Kit.solids(-width / 2, width / 2, 0, height, holes) do
		part(
			parent,
			"Facade",
			Vector3.new(piece.a1 - piece.a0, piece.b1 - piece.b0, 1.2),
			frame * CFrame.new((piece.a0 + piece.a1) / 2, (piece.b0 + piece.b1) / 2, 0),
			tint,
			Enum.Material.Concrete
		)
	end
	-- Floor slabs/ledges between storeys, with a darker band
	for storey = 1, floors - 1 do
		prop(
			parent,
			"Ledge",
			Vector3.new(width, 0.8, 1.8),
			frame * CFrame.new(0, storey * 12, -0.6),
			CONCRETE_DARK,
			Enum.Material.Concrete
		)
	end

	for _, w in windows do
		local isDoor = w[5] == 1
		local lit = not options.dark and rng:NextNumber() < options.lit
		local pane = prop(
			parent,
			if isDoor then "Door" else "Window",
			Vector3.new(w[3], w[4], 0.3),
			frame * CFrame.new(w[1], w[2], 0.45),
			if isDoor then Color3.fromRGB(58, 52, 46) elseif lit then WARM else GLASS_DARK,
			if isDoor then Enum.Material.Metal else Enum.Material.Glass
		)
		if lit and not isDoor then
			pane.Material = Enum.Material.Neon
			pane.Transparency = 0.55
			local glow = Instance.new("SurfaceLight")
			glow.Face = Enum.NormalId.Front
			glow.Color = if rng:NextNumber() < 0.3 then FLUORESCENT else WARM
			glow.Range = 10
			glow.Angle = 80
			glow.Brightness = 0.8
			glow.Parent = pane
			if rng:NextNumber() < 0.12 then
				flicker(pane, "Fault")
			end
			-- Curtains and clutter visible through the glass
			if rng:NextNumber() < 0.6 then
				prop(
					parent,
					"Curtain",
					Vector3.new(w[3] * 0.45, w[4], 0.1),
					frame * CFrame.new(w[1] + w[3] * 0.28, w[2], 0.75),
					CLOTH[rng:NextInteger(1, #CLOTH)],
					Enum.Material.Fabric
				)
			end
		end
		if not isDoor and rng:NextNumber() < 0.25 then
			-- AC unit / vent box under the window
			local ac = prop(
				parent,
				"ACUnit",
				Vector3.new(2.4, 1.6, 1.4),
				frame * CFrame.new(w[1] + 0.6, w[2] - 3, -0.9),
				Color3.fromRGB(150, 148, 140),
				Enum.Material.Metal
			)
			heat(ac, 41)
		end
		if not isDoor and rng:NextNumber() < 0.2 then
			-- laundry line
			prop(
				parent,
				"Line",
				Vector3.new(5, 0.05, 0.05),
				frame * CFrame.new(w[1], w[2] - 2.4, -2.5),
				STEEL_DARK
			)
			for i = 1, 3 do
				prop(
					parent,
					"Laundry",
					Vector3.new(0.9, 1.4, 0.06),
					frame * CFrame.new(w[1] - 2 + i * 1.1, w[2] - 3.2, -2.5),
					CLOTH[rng:NextInteger(1, #CLOTH)],
					Enum.Material.Fabric
				)
			end
		end
	end

	-- Utilities: a drain pipe and a cable bundle per segment
	local pipe = cylinder(
		parent,
		"Downpipe",
		height,
		0.8,
		(frame * CFrame.new(width / 2 - 1.2, height / 2, -0.8)).Position,
		"Y",
		RUST,
		Enum.Material.CorrodedMetal
	)
	decor(pipe)
	local conduit = prop(
		parent,
		"Conduit",
		Vector3.new(width, 0.5, 0.5),
		frame * CFrame.new(0, height - 1.5, -0.9),
		STEEL_DARK,
		Enum.Material.Metal
	)
	conduit.Shape = Enum.PartType.Cylinder
	conduit.CFrame = frame * CFrame.new(0, height - 1.5, -0.9)
end

local function gallery(parent: Instance, y: number, skipAngles: { number }?)
	local width = 2 * 83 * math.sin(math.pi / SEGMENTS) + 0.8
	for i = 0, SEGMENTS - 1 do
		local angle = (i + 0.5) / SEGMENTS * math.pi * 2
		local frame = wallFrame(angle, 83, y)
		part(
			parent,
			"Walkway",
			Vector3.new(width, 1.2, 18),
			frame * CFrame.new(0, -0.6, 0),
			CONCRETE_DARK,
			Enum.Material.Concrete
		)
		-- Underside beams
		prop(
			parent,
			"Beam",
			Vector3.new(0.8, 1.6, 18),
			frame * CFrame.new(width / 2 - 0.4, -2, 0),
			STEEL_DARK,
			Enum.Material.Metal
		)
		local skip = false
		for _, a in (skipAngles or {}) :: { number } do
			local d = math.abs(((angle - a + math.pi) % (2 * math.pi)) - math.pi)
			if d < 0.18 then
				skip = true
			end
		end
		if not skip then
			-- Railing at the inner edge
			local edge = frame * CFrame.new(0, 0, -8.6)
			part(
				parent,
				"Rail",
				Vector3.new(width, 0.2, 0.2),
				edge * CFrame.new(0, 3.4, 0),
				RUST,
				Enum.Material.Metal
			)
			prop(
				parent,
				"Rail",
				Vector3.new(width, 0.12, 0.12),
				edge * CFrame.new(0, 1.8, 0),
				RUST,
				Enum.Material.Metal
			)
			for p = -1, 1 do
				prop(
					parent,
					"Post",
					Vector3.new(0.2, 3.4, 0.2),
					edge * CFrame.new(p * width / 3, 1.7, 0),
					RUST,
					Enum.Material.Metal
				)
			end
		end
		if i % 2 == 0 then
			-- Ceiling tubes on the underside of the next gallery up
			tube(
				parent,
				(frame * CFrame.new(0, 33.5, 2)).Position,
				angle,
				FLUORESCENT,
				rng:NextNumber() < 0.8
			)
		end
	end
end

---------------------------------------------------------------------------
-- Devices specific to the Hollow
---------------------------------------------------------------------------

local function breaker(parent: Instance, cf: CFrame, label: string, group: string): Model
	local model = newModel(parent, "Breaker")
	local body = part(
		model,
		"Body",
		Vector3.new(3, 4, 1),
		cf,
		Color3.fromRGB(70, 74, 64),
		Enum.Material.Metal
	)
	prop(model, "Stripe", Vector3.new(3.05, 0.4, 1.05), cf * CFrame.new(0, 1.6, 0), HAZARD)
	prop(
		model,
		"Handle",
		Vector3.new(0.4, 1.4, 0.4),
		cf * CFrame.new(0.8, -0.2, -0.7),
		Color3.fromRGB(30, 30, 30),
		Enum.Material.Metal
	)
	local lamp = ball(
		model,
		"StatusLamp",
		0.5,
		(cf * CFrame.new(-0.9, 0.8, -0.55)).Position,
		Color3.fromRGB(255, 50, 50),
		Enum.Material.Neon
	)
	decor(lamp)
	light(lamp, Color3.fromRGB(255, 50, 50), 6, 0.8)
	signage(
		model,
		cf * CFrame.new(0, 2.6, -0.55),
		Vector2.new(3, 0.9),
		label,
		Color3.fromRGB(230, 230, 220),
		Color3.fromRGB(30, 32, 30),
		Enum.Font.Code
	)
	model.PrimaryPart = body
	device(
		model,
		"Breaker",
		label,
		{ On = false, Status = "OFF", VentGroup = group, Temperature = 31 }
	)
	return model
end

local function fan(
	parent: Instance,
	center: Vector3,
	diameter: number,
	axisUp: boolean,
	group: string
)
	local housing = cylinder(
		parent,
		"FanHousing",
		1.6,
		diameter + 1.2,
		center,
		if axisUp then "Y" else "Z",
		STEEL_DARK,
		Enum.Material.Metal
	)
	housing.Transparency = 0
	local hub = cylinder(
		parent,
		"FanHub",
		1.8,
		diameter * 0.2,
		center,
		if axisUp then "Y" else "Z",
		STEEL,
		Enum.Material.Metal
	)
	decor(hub)
	-- Blades on a single part rotating about its local Y
	local orient = if axisUp then CFrame.identity else CFrame.Angles(math.pi / 2, 0, 0)
	local blades = prop(
		parent,
		"FanBlades",
		Vector3.new(diameter * 0.95, 0.2, diameter * 0.18),
		CFrame.new(center) * orient,
		Color3.fromRGB(64, 66, 70),
		Enum.Material.Metal
	)
	local blades2 = prop(
		parent,
		"FanBlades",
		Vector3.new(diameter * 0.18, 0.2, diameter * 0.95),
		CFrame.new(center) * orient,
		Color3.fromRGB(64, 66, 70),
		Enum.Material.Metal
	)
	for _, b in { blades, blades2 } do
		b:SetAttribute("VentGroup", group)
		b:SetAttribute("Running", false)
		CollectionService:AddTag(b, "Fan")
	end
	-- Grille
	for i = -2, 2 do
		prop(
			parent,
			"Grille",
			if axisUp then Vector3.new(diameter, 0.1, 0.12) else Vector3.new(diameter, 0.12, 0.1),
			CFrame.new(center) * orient * CFrame.new(0, 1, i * diameter / 5),
			STEEL,
			Enum.Material.Metal
		)
	end
end

local function equipment(
	model: Model,
	label: string,
	temperature: number,
	diagnostic: string,
	verdict: string,
	severity: string
)
	device(model, "Equipment", label, {
		Temperature = temperature,
		Diagnostic = diagnostic,
		Verdict = verdict,
		Severity = severity,
		Objective = "HSurvey",
		Status = "NOT SURVEYED",
	})
end

local function publicScreen(parent: Instance, cf: CFrame, size: Vector2, label: string)
	local model = newModel(parent, "PublicScreen")
	local frameColor = Color3.fromRGB(26, 26, 28)
	part(
		model,
		"Bezel",
		Vector3.new(size.X + 0.8, size.Y + 0.8, 0.8),
		cf * CFrame.new(0, 0, 0.45),
		frameColor,
		Enum.Material.Metal
	)
	local panel = part(
		model,
		"Panel",
		Vector3.new(size.X, size.Y, 0.2),
		cf,
		Color3.fromRGB(40, 6, 8),
		Enum.Material.SmoothPlastic
	)
	local glow = Instance.new("SurfaceLight")
	glow.Face = Enum.NormalId.Front
	glow.Color = Color3.fromRGB(255, 70, 60)
	glow.Range = 24
	glow.Angle = 90
	glow.Brightness = 1.2
	glow.Parent = panel
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = panel
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.BackgroundColor3 = DIRECTORATE
	header.BorderSizePixel = 0
	header.Size = UDim2.fromScale(1, 0.14)
	header.Text = "◆ THE DIRECTORATE OF THE HOLLOW ◆"
	header.TextColor3 = Color3.new(1, 1, 1)
	header.TextScaled = true
	header.Font = Enum.Font.SourceSansBold
	header.Parent = gui
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Position = UDim2.fromScale(0.04, 0.17)
	text.Size = UDim2.fromScale(0.92, 0.8)
	text.TextColor3 = Color3.fromRGB(255, 210, 200)
	text.TextScaled = true
	text.Font = Enum.Font.SourceSansSemibold
	text.Text =
		"SURFACE AIR IS LETHAL WITHIN MINUTES\n\nLUNG SICKNESS: 3 CASES — CONTAINED\n\nLEVEL 9 SEALED FOR YOUR SAFETY\n\nCOMPLIANCE IS SURVIVAL"
	text.Parent = gui
	model.PrimaryPart = panel
	device(model, "PublicScreen", label, { Status = "DIRECTORATE FEED", Temperature = 38 })
	CollectionService:AddTag(model, "PublicScreen")
	return model
end

local function airZone(
	parent: Instance,
	center: Vector3,
	size: Vector3,
	attributes: { [string]: any }
)
	local zone = volume(parent, "AirZone", center, size)
	for key, value in attributes do
		zone:SetAttribute(key, value)
	end
	CollectionService:AddTag(zone, "AirZone")
end

local function resident(
	parent: Instance,
	name: string,
	condition: string,
	_legacyTemperature: number,
	cf: CFrame,
	pose: string,
	shirt: Color3
): Model
	local model = person(parent, "Resident", cf, shirt, pose)
	local sampled = Characters.temperature(condition)
	device(model, "Resident", name, {
		Condition = condition,
		Temperature = sampled,
		BaseTemperature = sampled,
		NeedsAid = condition ~= "Healthy",
		Located = false,
		Status = "UNIDENTIFIED",
		LocateObjective = "HLocated",
		TreatObjective = "HTreated",
	})
	return model
end

-- Background people (not devices): warm on thermal, no interaction
local function bystander(parent: Instance, cf: CFrame, pose: string)
	local model = person(parent, "Bystander", cf, CLOTH[rng:NextInteger(1, #CLOTH)], pose)
	local chest = Characters.chest(model)
	heat(chest, Characters.temperature("Healthy"))
	chest:SetAttribute("BaseTemperature", chest:GetAttribute("Temperature"))
end

---------------------------------------------------------------------------
-- Zones
---------------------------------------------------------------------------

local function buildWell(root: Folder)
	local folder = newModel(root, "TheWell")

	-- L9 floor (the Pit) and the Deck (L8)
	plateGrid(folder, "PitFloor", 0, CONCRETE_DARK, Enum.Material.Concrete, function(x, z)
		local underpass = x > -40 and x < 40 and z > 40 and z < 88
		local exhaust = x == -56 and z == 56
		return underpass or exhaust
	end)
	plateGrid(folder, "Deck", DECK_Y, STEEL, Enum.Material.DiamondPlate, function(x, z)
		local stairwell = x == 24 and (z == -72 or z == -56 or z == -40)
		return math.sqrt(x * x + z * z) < 14 or stairwell
	end, { { x = 8, z = -56 }, { x = -72, z = 8 }, { x = 56, z = 40 } })

	-- Deck underside: heavy girders and dead/emergency lights over the Pit
	for i = -5, 5 do
		local x = i * 16
		local half = math.sqrt(math.max(0, (WELL_RADIUS + 6) ^ 2 - x * x))
		part(
			folder,
			"Girder",
			Vector3.new(1.4, 3, half * 2),
			CFrame.new(at(x, DECK_Y - 3, 0)),
			STEEL_DARK,
			Enum.Material.Metal
		)
	end
	for _, p in { { -40, -30 }, { 30, -50 }, { 60, 10 }, { -20, 30 }, { -70, -40 }, { 20, 60 } } do
		local emergency = prop(
			folder,
			"EmergencyLamp",
			Vector3.new(1.2, 0.6, 1.2),
			CFrame.new(at(p[1], DECK_Y - 4.8, p[2])),
			EMERGENCY,
			Enum.Material.Neon
		)
		local glow = light(emergency, EMERGENCY, 34, 0.9)
		glow.Shadows = true
		flicker(emergency, "Pulse")
	end
	for _, p in { { 10, -20 }, { -50, 20 }, { 50, -30 } } do
		local t = tube(
			folder,
			at(p[1], DECK_Y - 4.6, p[2]),
			rng:NextNumber(0, math.pi),
			FLUORESCENT,
			true
		)
		flicker(t, "Fault")
	end
	local dripVolume = volume(folder, "Drips", at(0, DECK_Y - 5, 0), Vector3.new(150, 1, 150))
	particles(dripVolume, "Drip").Rate = 6

	-- Facades: L9 (dark, blackout) under the deck, lit levels above
	for i = 0, SEGMENTS - 1 do
		local angle = (i + 0.5) / SEGMENTS * math.pi * 2
		local deg = math.deg(angle)
		local westL9 = deg > 165 and deg < 195
		if not westL9 then
			facade(folder, angle, 0, 36, { lit = 0.08, dark = false })
		end
		local eastL8 = deg < 15 or deg > 345
		if not eastL8 then
			facade(folder, angle, DECK_Y, 36, { lit = 0.55 })
		end
		local northL7 = deg > 255 and deg < 285
		local southL7 = deg > 75 and deg < 105
		facade(
			folder,
			angle,
			80,
			36,
			{ lit = 0.65, opening = if northL7 or southL7 then { 20, 16 } else nil }
		)
		local westL6 = deg > 165 and deg < 195
		facade(folder, angle, 120, 36, { lit = 0.75, opening = if westL6 then { 22, 14 } else nil })
	end
	gallery(folder, 80, { 0 })
	gallery(folder, 120, { math.rad(270) })

	-- Level markers stencilled on the rock
	for index, y in LEVELS do
		for _, angle in { math.rad(45), math.rad(225) } do
			signage(
				folder,
				wallFrame(angle, WELL_RADIUS - 2.3, y + 31),
				Vector2.new(12, 3),
				LEVEL_NAMES[index],
				Color3.fromRGB(230, 222, 200),
				nil,
				Enum.Font.SourceSansBold
			)
		end
	end

	-- The Spire: Directorate tower up the middle of the Well
	local spire = newModel(folder, "Spire")
	cylinder(
		spire,
		"Core",
		212,
		20,
		at(0, 106, 0),
		"Y",
		Color3.fromRGB(58, 58, 62),
		Enum.Material.Concrete
	)
	for y = 20, 200, 30 do
		decor(cylinder(spire, "Band", 1.2, 21.2, at(0, y, 0), "Y", STEEL_DARK, Enum.Material.Metal))
		for k = 0, 3 do
			local a = k * math.pi / 2 + math.pi / 4
			local beaconLamp = prop(
				spire,
				"AviationLight",
				Vector3.new(0.7, 0.7, 0.7),
				CFrame.new(at(math.cos(a) * 10.6, y + 1.2, math.sin(a) * 10.6)),
				DIRECTORATE,
				Enum.Material.Neon
			)
			if y >= 140 then
				light(beaconLamp, DIRECTORATE, 10, 0.8)
			end
			flicker(beaconLamp, "Blink")
		end
	end
	for k = 0, 3 do
		local a = k * math.pi / 2 + math.pi / 4
		local position = at(math.cos(a) * 10.8, 96, math.sin(a) * 10.8)
		publicScreen(
			spire,
			CFrame.lookAt(position, position + Vector3.new(math.cos(a), 0, math.sin(a))),
			Vector2.new(15, 9),
			"Directorate screen S-" .. k
		)
		Kit.buildCamera(
			spire,
			at(math.cos(a + 0.4) * 11, 112, math.sin(a + 0.4) * 11),
			at(math.cos(a + 0.4) * 60, 60, math.sin(a + 0.4) * 60),
			"Spire camera " .. k
		)
	end

	-- Jammer array on the Spire facing the L7 east bridge
	local jammer = newModel(spire, "Jammer")
	local box = part(
		jammer,
		"Cabinet",
		Vector3.new(3, 5, 4),
		CFrame.new(at(11.6, 85.5, 0)),
		Color3.fromRGB(40, 36, 40),
		Enum.Material.Metal
	)
	heat(box, 72)
	local glow = prop(
		jammer,
		"Glow",
		Vector3.new(0.2, 3.6, 0.5),
		CFrame.new(at(13.15, 85.8, -1)),
		DIRECTORATE,
		Enum.Material.Neon
	)
	light(glow, DIRECTORATE, 14, 1.2)
	prop(
		jammer,
		"Glow",
		Vector3.new(0.2, 3.6, 0.5),
		CFrame.new(at(13.15, 85.8, 1)),
		DIRECTORATE,
		Enum.Material.Neon
	)
	part(
		jammer,
		"Cable",
		Vector3.new(0.7, 14, 0.7),
		CFrame.new(at(11.2, 95, 1.6)),
		Color3.fromRGB(20, 20, 20),
		Enum.Material.Rubber
	)
	signage(
		jammer,
		CFrame.new(at(13.2, 89, 0)) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(4, 1),
		"DIR · SIGNAL DENIAL",
		Color3.fromRGB(255, 200, 200),
		DIRECTORATE,
		Enum.Font.Code
	)
	for k = 0, 5 do
		local a = k * math.pi / 3
		local mast = prop(
			spire,
			"Antenna",
			Vector3.new(0.3, 12, 0.3),
			CFrame.new(at(math.cos(a) * 9, 108, math.sin(a) * 9))
				* CFrame.Angles(math.cos(a) * 0.3, 0, -math.sin(a) * 0.3),
			STEEL,
			Enum.Material.Metal
		)
		mast.CastShadow = true
	end
	jammer.PrimaryPart = box
	device(jammer, "Jammer", "Directorate jammer array J-9", {
		Active = true,
		Status = "JAMMING ALL BANDS",
		Temperature = 72,
		JamRadius = 120,
		JamFactor = 0.4,
		Objective = "HJammer",
		CutText = "Jammer J-9 on the Spire is dark. The Well can talk again.",
	})
	CollectionService:AddTag(jammer, "Jammer")

	-- Bridges: L7 east to the Spire (to reach the jammer) and L6 north
	part(
		folder,
		"Bridge",
		Vector3.new(64, 1, 6),
		CFrame.new(at(42, 79.5, 0)),
		STEEL,
		Enum.Material.DiamondPlate
	)
	for side = -1, 1, 2 do
		prop(
			folder,
			"BridgeRail",
			Vector3.new(64, 0.2, 0.2),
			CFrame.new(at(42, 83, side * 3)),
			RUST,
			Enum.Material.Metal
		)
	end
	part(
		folder,
		"Bridge",
		Vector3.new(6, 1, 64),
		CFrame.new(at(0, 119.5, -42)),
		STEEL,
		Enum.Material.DiamondPlate
	)
	for side = -1, 1, 2 do
		prop(
			folder,
			"BridgeRail",
			Vector3.new(0.2, 0.2, 64),
			CFrame.new(at(side * 3, 123, -42)),
			RUST,
			Enum.Material.Metal
		)
	end

	-- Directorate "sun lamps": rings of sodium high-bays hung from the dome.
	-- (Roblox lights reach 60 studs, so they hang low over the upper levels.)
	for k = 0, 7 do
		local a = k * math.pi / 4
		highBay(folder, at(math.cos(a) * 52, 170, math.sin(a) * 52), 60, 3, k % 2 == 0)
	end
	for k = 0, 5 do
		local a = k * math.pi / 3 + 0.3
		highBay(folder, at(math.cos(a) * 62, 132, math.sin(a) * 62), 60, 2, false)
	end
	highBay(folder, at(0, 222, 26), 60, 1.6, false)
	local dust = volume(folder, "DustMotes", at(0, 120, 0), Vector3.new(150, 150, 150))
	particles(dust, "Dust").Rate = 40

	-- Hanging cables across the Well (catenaries as a few straight spans)
	for k = 0, 7 do
		local a = k * math.pi / 4 + 0.2
		local p1 = at(math.cos(a) * 88, 150 + (k % 3) * 8, math.sin(a) * 88)
		local mid = at(math.cos(a) * 44, 138 + (k % 3) * 8, math.sin(a) * 44)
		for _, pair in { { p1, mid }, { mid, at(0, 150, 0) } } do
			local length = (pair[2] - pair[1]).Magnitude
			local cable = prop(
				folder,
				"Cable",
				Vector3.new(0.25, 0.25, length),
				CFrame.lookAt((pair[1] + pair[2]) / 2, pair[2]),
				Color3.fromRGB(20, 20, 22),
				Enum.Material.Rubber
			)
			cable.CastShadow = true
		end
	end

	-- Deck checkpoint: the sealed lift to L9
	local checkpoint = newModel(folder, "Checkpoint")
	part(
		checkpoint,
		"LiftKiosk",
		Vector3.new(10, 14, 10),
		CFrame.new(at(-40, 47, -40)),
		Color3.fromRGB(64, 64, 68),
		Enum.Material.Metal
	)
	signage(
		checkpoint,
		CFrame.new(at(-34.9, 50, -40)) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(9, 4),
		"LIFT TO LEVEL 9\nSEALED · QUARANTINE ORDER 2087-114",
		Color3.fromRGB(255, 220, 220),
		DIRECTORATE
	)
	for k = 0, 6 do
		part(
			checkpoint,
			"Barrier",
			Vector3.new(4, 2.4, 1),
			CFrame.new(at(-30 + k * 4.2, 41.2, -30)) * CFrame.Angles(0, 0.05 * k, 0),
			Color3.fromRGB(150, 140, 120),
			Enum.Material.Concrete
		)
		prop(
			checkpoint,
			"Stripe",
			Vector3.new(4.02, 0.5, 1.02),
			CFrame.new(at(-30 + k * 4.2, 41.8, -30)) * CFrame.Angles(0, 0.05 * k, 0),
			if k % 2 == 0 then DIRECTORATE else Color3.fromRGB(230, 230, 230)
		)
	end
	Kit.buildCamera(checkpoint, at(-36, 54.5, -36), at(-10, 40, -10), "Checkpoint camera")
end

local function buildPit(root: Folder)
	local folder = newModel(root, "ThePit")

	-- Shelters and stalls packed against the facades (crowding)
	for i = 0, 15 do
		local angle = (i + 0.25) / 16 * math.pi * 2
		local deg = math.deg(angle)
		if (deg > 160 and deg < 200) or (deg > 60 and deg < 120) then
			continue
		end
		local frame = wallFrame(angle, 78, 0)
		local tarp = CLOTH[rng:NextInteger(1, #CLOTH)]
		for _, x in { -3.6, 3.6 } do
			for _, z in { -3, 3 } do
				prop(
					folder,
					"Pole",
					Vector3.new(0.3, 7, 0.3),
					frame * CFrame.new(x, 3.5, z),
					STEEL_DARK,
					Enum.Material.Metal
				)
			end
		end
		part(
			folder,
			"Tarp",
			Vector3.new(8.4, 0.15, 7.4),
			frame * CFrame.new(0, 7.1, 0) * CFrame.Angles(0.12, 0, 0),
			tarp,
			Enum.Material.Fabric
		)
		prop(
			folder,
			"Hang",
			Vector3.new(8.4, 3.2, 0.1),
			frame * CFrame.new(0, 5.4, 3.7),
			tarp,
			Enum.Material.Fabric
		).Transparency =
			0.1
		crate(folder, frame * CFrame.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 1)))
		if i % 3 == 0 then
			bystander(
				folder,
				frame * CFrame.new(1.5, 2, -4.5) * CFrame.Angles(0, math.pi, 0),
				"Sit"
			)
		elseif i % 3 == 1 then
			bystander(
				folder,
				frame * CFrame.new(-2, 2.2, -5) * CFrame.Angles(0, math.pi + 0.4, 0),
				"Stand"
			)
		end
		if i % 4 == 0 then
			local candle = prop(
				folder,
				"Lantern",
				Vector3.new(0.5, 0.8, 0.5),
				frame * CFrame.new(0, 2.8, 1),
				WARM,
				Enum.Material.Neon
			)
			local glow = light(candle, WARM, 12, 0.8)
			glow.Shadows = true
			flicker(candle, "Fire")
		end
	end
	for _, p in { { -30, -20 }, { 40, -40 }, { 10, 30 } } do
		barrel(folder, at(p[1], 0, p[2]), RUST, true)
		for k = 0, 2 do
			local a = k * 2.1
			bystander(
				folder,
				CFrame.lookAt(
					at(p[1] + math.cos(a) * 3.6, 2.2, p[2] + math.sin(a) * 3.6),
					at(p[1], 2.2, p[2])
				),
				"Stand"
			)
		end
	end

	-- Underpass Market (floods): sunken plaza with stalls, stairs down
	part(
		folder,
		"UnderpassFloor",
		Vector3.new(80, 1, 48),
		CFrame.new(at(0, -8.5, 64)),
		Color3.fromRGB(70, 66, 60),
		Enum.Material.Pavement
	)
	for k = 0, 5 do
		local x = -30 + k * 12
		local stall = CLOTH[rng:NextInteger(1, #CLOTH)]
		part(
			folder,
			"Counter",
			Vector3.new(7, 3, 2.5),
			CFrame.new(at(x, -6.5, 80)),
			Color3.fromRGB(90, 76, 58),
			Enum.Material.WoodPlanks
		)
		part(
			folder,
			"Awning",
			Vector3.new(8, 0.2, 5),
			CFrame.new(at(x, -1.4, 79)) * CFrame.Angles(-0.2, 0, 0),
			stall,
			Enum.Material.Fabric
		)
		crate(folder, CFrame.new(at(x + 2, -8, 76)), Vector3.new(2, 1.6, 2))
	end
	for step = 0, 7 do
		part(
			folder,
			"Stair",
			Vector3.new(8, 1, 2),
			CFrame.new(at(-26, -0.5 - step, 50 + step * 2)),
			CONCRETE,
			Enum.Material.Concrete
		)
	end
	signage(
		folder,
		CFrame.new(at(0, 1.5, 41)),
		Vector2.new(18, 2.4),
		"UNDERPASS MARKET · L9-S",
		Color3.fromRGB(240, 220, 160),
		Color3.fromRGB(40, 34, 28)
	)
	signage(
		folder,
		CFrame.new(at(0, -5.5, 70.1)),
		Vector2.new(9, 2),
		"⚠ SEWER BREACH — KEEP OUT",
		HAZARD,
		Color3.fromRGB(30, 28, 20)
	)
	tube(folder, at(-10, -0.5, 60), 0, FLUORESCENT, true)
	local dead = tube(folder, at(15, -0.5, 70), 0, FLUORESCENT, true)
	flicker(dead, "Fault")

	-- Exhaust vent from the pump room (steam rises when the fans run)
	local grate = part(
		folder,
		"ExhaustGrate",
		Vector3.new(16, 0.3, 16),
		CFrame.new(at(-56, -0.2, 56)),
		RUST,
		Enum.Material.CorrodedMetal
	)
	grate.Transparency = 0.35
	grate.CanCollide = false
	local steam = particles(grate, "Steam")
	steam.Name = "Exhaust"
	steam.Rate = 2
	grate:SetAttribute("VentGroup", "HCollector")
	CollectionService:AddTag(grate, "VentSteam")

	-- L9 Shelter: family message terminal + crowd
	local shelter = newModel(folder, "Shelter")
	local terminal = Kit.buildTerminal(
		shelter,
		nil,
		at(60, 0, -52),
		yawToward(at(60, 0, -52), at(0, 0, 0)),
		"L9 Shelter Terminal",
		"PKT-L9-FAMILY",
		""
	)
	signage(
		shelter,
		CFrame.lookAt(at(66, 9, -60), at(0, 9, 0)),
		Vector2.new(14, 3),
		"SHELTER · FAMILY BOARD",
		WARM,
		Color3.fromRGB(30, 26, 22)
	)
	for k = 0, 4 do
		bystander(
			shelter,
			CFrame.lookAt(at(52 + k * 2.5, 2.2, -42 + k), at(60, 2.2, -52)),
			if k % 2 == 0 then "Stand" else "Sit"
		)
	end
	local note = terminal:FindFirstChild("Screen")
	if note then
		local display = note:FindFirstChild("Display")
		local text = display and display:FindFirstChild("Text")
		if text and text:IsA("TextLabel") then
			text.Text = "L9 SHELTER\n214 MESSAGES QUEUED\nNETWORK DOWN"
		end
	end

	-- Family SOS beacons in apartment windows
	local messages: { { angle: number, text: string } } = {
		{
			angle = 160,
			text = "Okafor family, L9-114: all four of us safe. Ada is stuck up on the Deck (L8).",
		},
		{ angle = 230, text = "Hassan, L9-212: Mother needs insulin. We are OK otherwise." },
		{ angle = 30, text = "Lindqvist, L9-031: Water came in, moved to the Shelter. Alive." },
	}
	for index, m in messages do
		local frame = wallFrame(math.rad(m.angle), WELL_RADIUS - 2.6, 18)
		local beacon = Kit.buildBeacon(
			folder,
			nil,
			(frame * CFrame.new(0, 0, -0.2)).Position,
			frame.LookVector,
			"Family beacon " .. index
		)
		beacon:SetAttribute("Objective", "HBeacons")
		beacon:SetAttribute("Message", m.text)
	end

	-- Grid Watch equipment
	local transformer = newModel(folder, "Transformer")
	local core = part(
		transformer,
		"Tank",
		Vector3.new(8, 9, 6),
		CFrame.new(at(-20, 4.5, -64)),
		Color3.fromRGB(78, 88, 76),
		Enum.Material.Metal
	)
	heat(core, 96)
	for k = -3, 3 do
		heat(
			part(
				transformer,
				"Fin",
				Vector3.new(0.3, 7, 2),
				CFrame.new(at(-20 + k * 1.1, 4.5, -60.4)),
				STEEL_DARK,
				Enum.Material.Metal
			),
			88
		)
	end
	for k = 0, 2 do
		prop(
			transformer,
			"Bushing",
			Vector3.new(0.8, 2.5, 0.8),
			CFrame.new(at(-22.5 + k * 2.5, 10.2, -64)),
			Color3.fromRGB(150, 110, 90),
			Enum.Material.SmoothPlastic
		)
	end
	signage(
		transformer,
		CFrame.lookAt(at(-20, 6, -60.9), at(-20, 6, 0)),
		Vector2.new(5, 1.2),
		"T-9 · 11kV/400V",
		Color3.fromRGB(240, 240, 220),
		Color3.fromRGB(150, 30, 30)
	)
	transformer.PrimaryPart = core
	equipment(
		transformer,
		"Transformer T-9 (L9 feeder)",
		96,
		"Oil 205°F / 96°C (limit 221°F / 105°C), rising 2.5°F / 1.4°C per day. Cooling fins clogged. Partial-discharge noise detected.\nFORECAST: thermal trip in ~6 days → 3-day L9 blackout.\nACTION: clean fins, shed 18% load to L8 tie.",
		"FAILURE PREDICTED ~6 DAYS",
		"danger"
	)

	local hx = newModel(folder, "HeatExchanger")
	local shell = cylinder(
		hx,
		"Shell",
		18,
		5,
		at(30, 3.5, 20),
		"X",
		Color3.fromRGB(120, 90, 70),
		Enum.Material.CorrodedMetal
	)
	heat(shell, 74)
	for k = 0, 1 do
		heat(
			cylinder(
				hx,
				"Riser",
				34,
				1.6,
				at(24 + k * 12, 18, 23.5),
				"Y",
				RUST,
				Enum.Material.CorrodedMetal
			),
			71
		)
	end
	local steamLeak = volume(hx, "Leak", at(36, 4, 20), Vector3.new(1, 1, 1))
	particles(steamLeak, "Steam").Rate = 3
	hx.PrimaryPart = shell
	equipment(
		hx,
		"Geothermal exchanger HX-2",
		74,
		"Return 160°F / 71°C (design 131°F / 55°C). Cooling fans at 38% of rated airflow. L9 ambient trending +1.1°F / +0.6°C per month.\nFORECAST: L9 exceeds 95°F / 35°C wet-bulb risk in summer peak.\nACTION: replace 2 fan bearings; reroute HX-1 bypass.",
		"OVERHEATING · COOLING 38%",
		"warning"
	)

	local recycler = newModel(folder, "Recycler")
	for k = 0, 1 do
		local tank = cylinder(
			recycler,
			"Tank",
			10,
			7,
			at(-66 + k * 9, 5, -18),
			"Y",
			Color3.fromRGB(150, 156, 160),
			Enum.Material.Metal
		)
		heat(tank, 31)
	end
	cylinder(
		recycler,
		"Pipe",
		30,
		1.2,
		at(-61, 2, -6),
		"Z",
		Color3.fromRGB(60, 100, 160),
		Enum.Material.Metal
	)
	local membrane = part(
		recycler,
		"Membrane",
		Vector3.new(6, 4, 3),
		CFrame.new(at(-61, 2, -26)),
		Color3.fromRGB(90, 96, 100),
		Enum.Material.Metal
	)
	recycler.PrimaryPart = membrane
	signage(
		recycler,
		CFrame.lookAt(at(-61, 4.5, -24.4), at(-61, 4.5, 10)),
		Vector2.new(5, 1.2),
		"WATER RECYCLER R-9",
		Color3.fromRGB(200, 230, 255),
		Color3.fromRGB(20, 40, 70)
	)
	equipment(
		recycler,
		"Water recycler R-9",
		31,
		"Membrane fouled (ΔP 4.1 bar). Chlorine dosing pump OFF for 9 days. Coliform breakthrough on the outlet.\nThis feeds the L9 taps — matches the outfall sample in C-2.\nACTION: boil-water notice for L9; swap membrane rack B.",
		"UNSAFE OUTPUT · BOIL NOTICE",
		"danger"
	)

	-- Air quality volumes
	airZone(folder, at(0, 19, 0), Vector3.new(184, 38, 184), {
		Label = "LEVEL 9 / THE PIT",
		O2 = 19.6,
		CO2 = 2650,
		PM = 88,
		Temp = 34,
		Verdict = "Poor: overcrowding + scrubbers failing. Headaches likely.",
	})
end

-- A person who can walk: a humanoid tagged "Walker". The Guides system walks
-- it with Humanoid:MoveTo along a computed path; the default walk animation
-- plays from its speed.
local function civilian(
	parent: Instance,
	name: string,
	cf: CFrame,
	shirt: Color3,
	attributes: { [string]: any }
): Model
	local model = person(parent, "Civilian", cf, shirt, "Stand", true)
	local sampled = Characters.temperature("Healthy")
	local all: { [string]: any } =
		{ Temperature = sampled, BaseTemperature = sampled, Status = "WAITING" }
	for key, value in attributes do
		all[key] = value
	end
	device(model, "Civilian", name, all)
	CollectionService:AddTag(model, "Walker")
	return model
end

-- Maintenance stair M-3: the only walkable way between the Deck (L8) and the
-- Pit (L9). Unlit, unsigned from below, and closed by the Directorate, so in
-- a blackout nobody can find it. Two flights with a landing at y = 20.
local function buildStair(root: Folder)
	local folder = newModel(root, "StairM3")
	local function ramp(top: Vector3, bottom: Vector3, width: number)
		local a, b = at(top.X, top.Y, top.Z), at(bottom.X, bottom.Y, bottom.Z)
		local length = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
		part(
			folder,
			"Ramp",
			Vector3.new(width, 1, length),
			cf,
			CONCRETE_DARK,
			Enum.Material.Concrete
		)
		-- step nosings for the look (the ramp itself is what feet walk on)
		local steps = math.floor(length / 1.6)
		for k = 1, steps - 1 do
			prop(
				folder,
				"Nosing",
				Vector3.new(width, 0.12, 0.25),
				CFrame.lookAt(a:Lerp(b, k / steps), b) * CFrame.new(0, 0.05, 0),
				HAZARD,
				Enum.Material.SmoothPlastic
			)
		end
		for side = -1, 1, 2 do
			local railCf = CFrame.lookAt((a + b) / 2, b)
				* CFrame.new(side * (width / 2 - 0.1), 3, 0)
			part(
				folder,
				"Handrail",
				Vector3.new(0.2, 0.2, length),
				railCf,
				RUST,
				Enum.Material.Metal
			)
		end
	end
	ramp(Vector3.new(20.5, DECK_Y, -41), Vector3.new(20.5, 20, -65), 7)
	ramp(Vector3.new(27.5, 20, -65), Vector3.new(27.5, 0, -41), 7)
	part(
		folder,
		"Landing",
		Vector3.new(14, 1, 5),
		CFrame.new(at(24, 19.5, -67.5)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	-- Deck patches around the stairwell opening + guard rails on the Deck
	part(
		folder,
		"DeckPatch",
		Vector3.new(16, 1.5, 9),
		CFrame.new(at(24, DECK_Y - 0.75, -36.5)),
		STEEL,
		Enum.Material.DiamondPlate
	)
	part(
		folder,
		"DeckPatch",
		Vector3.new(16, 1.5, 10),
		CFrame.new(at(24, DECK_Y - 0.75, -75)),
		STEEL,
		Enum.Material.DiamondPlate
	)
	local guards: { { Vector3 } } = {
		{ Vector3.new(28, DECK_Y + 1.7, -41), Vector3.new(8, 3.4, 0.3) },
		{ Vector3.new(16.2, DECK_Y + 1.7, -55.5), Vector3.new(0.3, 3.4, 29) },
		{ Vector3.new(31.8, DECK_Y + 1.7, -55.5), Vector3.new(0.3, 3.4, 29) },
		{ Vector3.new(24, DECK_Y + 1.7, -70), Vector3.new(16, 3.4, 0.3) },
	}
	for _, g in guards do
		local rail = part(
			folder,
			"GuardRail",
			g[2],
			CFrame.new(at(g[1].X, g[1].Y, g[1].Z)),
			RUST,
			Enum.Material.Metal
		)
		rail.Transparency = 0.35
	end
	signage(
		folder,
		CFrame.lookAt(at(20.5, DECK_Y + 6, -40.6), at(20.5, DECK_Y + 6, 0)),
		Vector2.new(7, 2.2),
		"MAINT STAIR M-3 · L8 ↔ L9\nCLOSED · DIRECTORATE ORDER",
		Color3.fromRGB(255, 225, 220),
		DIRECTORATE
	)
	prop(
		folder,
		"Tape",
		Vector3.new(7, 0.4, 0.1),
		CFrame.new(at(20.5, DECK_Y + 2.6, -40.8)) * CFrame.Angles(0, 0, 0.08),
		HAZARD
	)
	local lampPart = prop(
		folder,
		"StairLamp",
		Vector3.new(0.8, 0.4, 0.8),
		CFrame.new(at(24, 27, -69)),
		EMERGENCY,
		Enum.Material.Neon
	)
	light(lampPart, EMERGENCY, 16, 0.5)
	flicker(lampPart, "Pulse")

	-- Ada on the Deck, her father at the Shelter on L9
	civilian(
		folder,
		"Ada Okafor, 31 (L9-114 family)",
		CFrame.lookAt(at(12, DECK_Y + 1.95, -28), at(0, DECK_Y + 1.95, -60)),
		Color3.fromRGB(180, 120, 60),
		{
			Lost = true,
			ReuniteWith = "Ben Okafor",
			Route = "down Maintenance Stair M-3 through the blackout",
			Objective = "HReunite",
			Status = "LOST · TRYING TO REACH L9 SINCE THE BLACKOUT",
		}
	)
	civilian(
		folder,
		"Ben Okafor, 64 (L9-114)",
		CFrame.lookAt(at(66, 1.95, -44), at(40, 1.95, -44)),
		Color3.fromRGB(70, 90, 120),
		{
			Family = "Ben Okafor",
			Place = "the L9 Shelter",
			Status = "WAITING AT THE SHELTER FOR ADA",
		}
	)
end

local function buildCollector(root: Folder)
	local folder = newModel(root, "CollectorC2")

	-- Service ledge along the north wall and a light every 30 studs
	part(
		folder,
		"Ledge",
		Vector3.new(392, 1, 5),
		CFrame.new(at(0, -24.5, 47.6)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	for x = -180, 180, 30 do
		local on = rng:NextNumber() < 0.7
		local lampPart = prop(
			folder,
			"TunnelLamp",
			Vector3.new(1.6, 0.6, 1.6),
			CFrame.new(at(x, -11.4, 60)),
			if on then SODIUM else STEEL_DARK,
			if on then Enum.Material.Neon else Enum.Material.Metal
		)
		if on then
			local glow = light(lampPart, SODIUM, 30, 1.1)
			glow.Shadows = x % 60 == 0
			if rng:NextNumber() < 0.3 then
				flicker(lampPart, "Fault")
			end
		end
	end
	-- Pipes and conduits on the walls
	cylinder(folder, "Main", 392, 2.2, at(0, -18, 72.6), "X", RUST, Enum.Material.CorrodedMetal)
	cylinder(folder, "Conduit", 392, 0.8, at(0, -16, 48.4), "X", STEEL_DARK, Enum.Material.Metal)

	-- Outfall pipes to sample (north wall)
	local samples: { { x: number, label: string, readings: { [string]: any } } } = {
		{
			x = -20,
			label = "Outfall 1 · Recycler R-9 return",
			readings = { PH = 6.1, Coliform = 2400, Lead = 18, Contaminated = true },
		},
		{
			x = 60,
			label = "Outfall 2 · Clinic 7-N drain",
			readings = { PH = 6.8, Coliform = 9100, Lead = 4, Contaminated = true },
		},
		{
			x = 150,
			label = "Outfall 3 · Farm L6 runoff",
			readings = { PH = 7.2, Coliform = 40, Lead = 2, Contaminated = false },
		},
	}
	for _, sample in samples do
		-- Terrain walls are voxel-approximate, so fixtures stand well proud of the
		-- brick and a run of pipe carries them back into the lining
		local pipe = Kit.buildSamplePoint(
			folder,
			at(sample.x, -17, 49.4),
			Vector3.new(0, 0, 1),
			sample.label,
			sample.readings
		)
		pipe:SetAttribute("Objective", "HSamples")
		cylinder(
			folder,
			"OutfallRun",
			6,
			1.6,
			at(sample.x, -17, 45.4),
			"Z",
			Color3.fromRGB(80, 84, 70),
			Enum.Material.CorrodedMetal
		)
	end

	-- Sluice gates (valves) on the north wall
	local valves: { Instance } = {}
	-- SG-1 must be opened (relief to the deep interceptor); SG-2 must be shut
	-- (it is the backflow path into the Underpass)
	local gates: { { x: number, correct: boolean, start: boolean } } = {
		{ x = 40, correct = true, start = false },
		{ x = 120, correct = false, start = true },
	}
	for index, g in gates do
		local valve = Kit.buildValve(
			folder,
			nil,
			at(g.x, -19, 49.2),
			1,
			"Sluice gate SG-" .. index,
			g.correct,
			g.start
		)
		valve:SetAttribute("FloodGroup", "C2")
		table.insert(valves, valve)
		part(
			folder,
			"GateFrame",
			Vector3.new(6, 12, 0.6),
			CFrame.new(at(g.x, -27, 47.4)),
			RUST,
			Enum.Material.CorrodedMetal
		)
		-- spindle housing from the gate up to the handwheel, back into the wall
		part(
			folder,
			"Spindle",
			Vector3.new(0.6, 8, 0.6),
			CFrame.new(at(g.x, -23, 47.6)),
			STEEL,
			Enum.Material.Metal
		)
		part(
			folder,
			"Bracket",
			Vector3.new(1.4, 1.4, 5),
			CFrame.new(at(g.x, -19, 46)),
			STEEL_DARK,
			Enum.Material.Metal
		)
	end

	-- Trash rack at x = 90 with three pieces of debris jammed in it
	for z = 46, 74, 3.5 do
		part(
			folder,
			"RackBar",
			Vector3.new(0.5, 30, 0.5),
			CFrame.new(at(90, -26, z)) * CFrame.Angles(0, 0, 0.12),
			RUST,
			Enum.Material.CorrodedMetal
		)
	end
	local jam: { { at: Vector3, size: Vector3, label: string } } = {
		{ at = Vector3.new(88, -27.5, 54), size = Vector3.new(3, 2.5, 5), label = "Mattress" },
		{ at = Vector3.new(88, -27, 62), size = Vector3.new(4, 3, 3), label = "Shopping trolley" },
		{
			at = Vector3.new(88, -27.5, 70),
			size = Vector3.new(3.5, 2, 3.5),
			label = "Plastic waste bale",
		},
	}
	for index, d in jam do
		local debris =
			Kit.buildDebris(folder, O + d.at, d.size, "HRack", d.label .. " (rack " .. index .. ")")
		debris:SetAttribute("FloodGroup", "C2")
		debris.Color = CLOTH[index]
		debris.Material = Enum.Material.Fabric
	end
	signage(
		folder,
		CFrame.new(at(86, -14, 60)) * CFrame.Angles(0, math.pi / 2, 0),
		Vector2.new(10, 2),
		"TRASH RACK TR-4",
		HAZARD,
		Color3.fromRGB(26, 26, 22),
		Enum.Font.Code
	)

	-- Pump room: methane + H2S, exhaust fans in the shaft, the breaker
	part(
		folder,
		"PumpDeck",
		Vector3.new(30, 1, 20),
		CFrame.new(at(-60, -26.5, 72)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	for k = 0, 1 do
		local pump = cylinder(
			folder,
			"Pump",
			6,
			5,
			at(-66 + k * 12, -23, 74),
			"Y",
			Color3.fromRGB(40, 80, 120),
			Enum.Material.Metal
		)
		heat(pump, 45)
	end
	fan(folder, at(-60, -6, 60), 8, true, "HCollector")
	local panel = breaker(
		folder,
		CFrame.lookAt(at(-46.2, -21, 70), at(-60, -21, 70)),
		"EXHAUST FANS · C-2",
		"HCollector"
	)
	panel.Name = "ExhaustBreaker"
	Kit.buildGas(folder, nil, "CH4", at(-60, -18, 64), 16, 34, "Collector")
		:SetAttribute("VentGroup", "HCollector")
	Kit.buildGas(folder, nil, "H2S", at(-30, -22, 60), 14, 120, "Collector")
		:SetAttribute("VentGroup", "HCollector")
	Kit.buildGas(folder, nil, "H2S", at(20, -22, 60), 12, 70, "Collector")
		:SetAttribute("VentGroup", "HCollector")
	local lampPart = prop(
		folder,
		"PumpLamp",
		Vector3.new(1.4, 0.5, 1.4),
		CFrame.new(at(-60, -8.5, 70)),
		EMERGENCY,
		Enum.Material.Neon
	)
	light(lampPart, EMERGENCY, 24, 0.9)
	flicker(lampPart, "Pulse")
	signage(
		folder,
		CFrame.lookAt(at(-60, -14, 81.2), at(-60, -14, 60)),
		Vector2.new(14, 2.5),
		"PUMP STATION P-2 · CONFINED SPACE · GAS",
		HAZARD,
		Color3.fromRGB(26, 26, 22)
	)
	local mist = volume(folder, "Mist", at(0, -26, 60), Vector3.new(380, 3, 28))
	local fog = particles(mist, "Steam")
	fog.Rate = 14
	fog.Speed = NumberRange.new(0.3, 0.8)
	fog.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 10) })
	fog.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.88),
		NumberSequenceKeypoint.new(1, 1),
	})
	local drips = volume(folder, "Drips", at(0, -11, 60), Vector3.new(380, 1, 20))
	particles(drips, "Drip").Rate = 8

	airZone(folder, at(0, -26, 60), Vector3.new(420, 36, 44), {
		Label = "COLLECTOR C-2",
		O2 = 18.6,
		CO2 = 3400,
		PM = 140,
		Temp = 29,
		Verdict = "Confined space: O2 below 19.5%. Lethal for a human crew without SCBA.",
	})

	Registry.floods.C2 = {
		valves = valves,
		valveObjective = "HSluice",
		debrisObjective = "HRack",
		debrisTotal = 3,
		apply = function(progress: number): number
			return setWater(progress)
		end,
		describe = function(level: number): string
			local depth = (level - TUNNEL.bottom) * Config.STUDS_TO_METERS
			if UNDERPASS.target > UNDERPASS.low then
				return ("Collector surcharged (%.1fm). Underpass Market still flooded by backflow."):format(
					depth
				)
			end
			return ("Underpass Market draining. Collector down to %.1fm."):format(depth)
		end,
	}
	Registry.vents.HCollector = {
		breaker = panel,
		objective = "HGas",
		onText = "Exhaust fans ON. Methane and H2S are being pulled up the shaft; watch it clear in CHEM.",
		offText = "Exhaust fans OFF. Gas will pool in the pump room again.",
	}
end

local function room(parent: Instance, x0: number, x1: number, z0: number, z1: number)
	-- Back wall plaster + skirting so rooms read as homes, not rock caves
	local zWall = if math.abs(z0) > math.abs(z1) then z0 else z1
	part(
		parent,
		"BackWall",
		Vector3.new(x1 - x0, 28, 1),
		CFrame.new(at((x0 + x1) / 2, 14, zWall)),
		Color3.fromRGB(150, 140, 124),
		Enum.Material.Plaster
	)
end

local function buildQuarantine(root: Folder)
	local folder = newModel(root, "QuarantineQ9")
	local wallColor = Color3.fromRGB(160, 152, 138)

	part(
		folder,
		"Floor",
		Vector3.new(86, 1, 80),
		CFrame.new(at(-133, -0.5, 0)),
		Color3.fromRGB(96, 92, 86),
		Enum.Material.Concrete
	)
	part(
		folder,
		"Ceiling",
		Vector3.new(86, 1, 80),
		CFrame.new(at(-133, 28.5, 0)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	-- Front wall on the Pit side with the entrance (x = -90)
	Kit.wallX(
		folder,
		-90.5,
		-40,
		40,
		0,
		28,
		{ Kit.rect(-5, 5, 0, 11) },
		CONCRETE,
		Enum.Material.Concrete
	)
	-- Corridor walls with doors to six rooms
	local doorsNorth =
		{ Kit.rect(-110, -102, 0, 9), Kit.rect(-138, -130, 0, 9), Kit.rect(-166, -158, 0, 9) }
	local doorsSouth =
		{ Kit.rect(-110, -102, 0, 9), Kit.rect(-138, -130, 0, 9), Kit.rect(-166, -158, 0, 9) }
	Kit.wallZ(folder, -5, -176, -91, 0, 28, doorsNorth, wallColor, Enum.Material.Plaster)
	Kit.wallZ(folder, 5, -176, -91, 0, 28, doorsSouth, wallColor, Enum.Material.Plaster)
	-- Shift walls into place (Kit walls use absolute coordinates; offset into the site)
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and (child.Name == "Wall") then
			child.CFrame = child.CFrame + O
		end
	end
	for _, x in { -120, -148 } do
		for _, side in { -1, 1 } do
			part(
				folder,
				"RoomWall",
				Vector3.new(1, 28, 35),
				CFrame.new(at(x, 14, side * 22.5)),
				wallColor,
				Enum.Material.Plaster
			)
		end
	end
	for _, z in { -40, 40 } do
		room(folder, -176, -91, z, z)
	end

	-- Entrance: Directorate quarantine barrier (drone flies over it)
	part(
		folder,
		"Barrier",
		Vector3.new(1, 5, 10),
		CFrame.new(at(-88, 2.5, 0)),
		Color3.fromRGB(200, 190, 170),
		Enum.Material.Concrete
	)
	prop(
		folder,
		"Tape",
		Vector3.new(0.1, 0.5, 12),
		CFrame.new(at(-87.4, 6.5, 0)) * CFrame.Angles(0.1, 0, 0),
		HAZARD
	)
	signage(
		folder,
		CFrame.new(at(-89.8, 15, 0)) * CFrame.Angles(0, -math.pi / 2, 0),
		Vector2.new(14, 4),
		"QUARANTINE ZONE Q-9\nDIRECTORATE MEDICAL ORDER · NO ENTRY",
		Color3.fromRGB(255, 225, 220),
		DIRECTORATE
	)
	local flood = prop(
		folder,
		"Floodlight",
		Vector3.new(1.5, 1, 1.5),
		CFrame.new(at(-86, 12, 8)),
		Color3.fromRGB(240, 240, 255),
		Enum.Material.Neon
	)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Range = 30
	spot.Brightness = 2
	spot.Angle = 70
	spot.Shadows = true
	spot.Parent = flood
	Kit.buildCamera(folder, at(-88, 20, -9), at(-60, 2, 0), "Quarantine camera")

	-- Corridor: one dying emergency light, scattered belongings
	local corridorLamp = prop(
		folder,
		"Emergency",
		Vector3.new(1, 0.5, 1),
		CFrame.new(at(-130, 27.6, 0)),
		EMERGENCY,
		Enum.Material.Neon
	)
	light(corridorLamp, EMERGENCY, 26, 0.7).Shadows = true
	flicker(corridorLamp, "Pulse")
	for k = 0, 5 do
		crate(
			folder,
			CFrame.new(at(-100 - k * 13, 0, rng:NextNumber(-3, 3)))
				* CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Vector3.new(1.6, 1.2, 1.6)
		)
	end

	-- Rooms (x ranges) and occupants
	local function roomCenter(index: number): number
		return -106 - (index - 1) * 28
	end
	-- North row (z negative), south row (z positive)
	-- N1: fever
	local cfN1 = bed(folder, CFrame.new(at(roomCenter(1) - 6, 0, -30)), Color3.fromRGB(70, 90, 120))
	resident(
		folder,
		"Amara Osei, 34 (Q9-N1)",
		"Fever",
		39.4,
		cfN1,
		"Lie",
		Color3.fromRGB(150, 60, 60)
	)
	bunk(folder, CFrame.new(at(roomCenter(1) + 7, 0, -30)))
	-- N2: fever + healthy carer
	local cfN2 =
		bed(folder, CFrame.new(at(roomCenter(2) - 6, 0, -30)), Color3.fromRGB(120, 100, 70))
	resident(
		folder,
		"Tomas Reyes, 61 (Q9-N2)",
		"Fever",
		39.8,
		cfN2,
		"Lie",
		Color3.fromRGB(60, 80, 110)
	)
	resident(
		folder,
		"Lena Reyes, 58 (Q9-N2)",
		"Healthy",
		36.9,
		CFrame.new(at(roomCenter(2) + 2, 2.1, -26)) * CFrame.Angles(0, math.rad(200), 0),
		"Sit",
		Color3.fromRGB(110, 90, 130)
	)
	-- N3: barricaded, dehydrated resident trapped inside
	local cfN3 = bed(folder, CFrame.new(at(roomCenter(3) - 4, 0, -30)), nil)
	resident(
		folder,
		"Ivo Petrov, 45 (Q9-N3)",
		"Dehydrated",
		38.1,
		cfN3,
		"Lie",
		Color3.fromRGB(90, 90, 80)
	)
	local barricade: { { x: number, size: Vector3, label: string } } = {
		{ x = -165, size = Vector3.new(4, 5, 2), label = "Welded bed frame" },
		{ x = -159.5, size = Vector3.new(3.5, 6, 2.2), label = "Wardrobe" },
	}
	for index, d in barricade do
		local debris = Kit.buildDebris(
			folder,
			at(d.x, d.size.Y / 2, -5.2),
			d.size,
			"HBarricade",
			d.label .. " (barricade " .. index .. ")"
		)
		debris.Material = Enum.Material.Metal
		debris.Color = Color3.fromRGB(90, 84, 76)
	end
	-- S1: space heater decoy + fever
	local heater = newModel(folder, "SpaceHeater")
	local body = part(
		heater,
		"Body",
		Vector3.new(1.4, 2.4, 0.8),
		CFrame.new(at(roomCenter(1) + 4, 1.2, 30)),
		Color3.fromRGB(200, 196, 186),
		Enum.Material.SmoothPlastic
	)
	local coil = prop(
		heater,
		"Coil",
		Vector3.new(1, 1.6, 0.1),
		CFrame.new(at(roomCenter(1) + 4, 1.4, 29.55)),
		Color3.fromRGB(255, 120, 40),
		Enum.Material.Neon
	)
	light(coil, Color3.fromRGB(255, 120, 50), 8, 0.6)
	heater.PrimaryPart = body
	device(
		heater,
		"HeatSource",
		"Heat signature (S1)",
		{ Temperature = 61, Status = "UNIDENTIFIED" }
	)
	local cfS1 = bed(
		folder,
		CFrame.new(at(roomCenter(1) - 6, 0, 30)) * CFrame.Angles(0, math.pi, 0),
		Color3.fromRGB(70, 110, 80)
	)
	resident(
		folder,
		"Mika Laine, 29 (Q9-S1)",
		"Fever",
		38.9,
		cfS1,
		"Lie",
		Color3.fromRGB(70, 110, 140)
	)
	-- S2: an empty family room with a beacon, laundry, belongings
	bunk(folder, CFrame.new(at(roomCenter(2) - 6, 0, 30)))
	bunk(folder, CFrame.new(at(roomCenter(2) + 6, 0, 30)))
	local beacon = Kit.buildBeacon(
		folder,
		nil,
		at(roomCenter(2), 12, 39),
		Vector3.new(0, 0, -1),
		"Family beacon (Q9-S2)"
	)
	beacon:SetAttribute("Objective", "HBeacons")
	beacon:SetAttribute(
		"Message",
		"Achterberg family, Q9-S2: moved to the Shelter. Grandad stayed in S3. Please check on him."
	)
	-- S3: critical fever
	local cfS3 = bed(
		folder,
		CFrame.new(at(roomCenter(3) - 4, 0, 30)) * CFrame.Angles(0, math.pi, 0),
		Color3.fromRGB(110, 70, 70)
	)
	resident(
		folder,
		"Grace Mbeki, 70 (Q9-S3)",
		"Fever",
		40.1,
		cfS3,
		"Lie",
		Color3.fromRGB(120, 110, 60)
	)

	-- Furniture for realism
	for _, z in { -36, 36 } do
		for index = 1, 3 do
			local x = roomCenter(index)
			part(
				folder,
				"Table",
				Vector3.new(4, 0.3, 2.6),
				CFrame.new(at(x + 9, 3, z * 0.75)),
				Color3.fromRGB(110, 88, 64),
				Enum.Material.Wood
			)
			for _, dx in { -1.7, 1.7 } do
				for _, dz in { -1.1, 1.1 } do
					prop(
						folder,
						"Leg",
						Vector3.new(0.2, 3, 0.2),
						CFrame.new(at(x + 9 + dx, 1.5, z * 0.75 + dz)),
						Color3.fromRGB(90, 70, 50),
						Enum.Material.Wood
					)
				end
			end
			prop(
				folder,
				"Bottle",
				Vector3.new(0.3, 0.9, 0.3),
				CFrame.new(at(x + 9.5, 3.6, z * 0.75)),
				Color3.fromRGB(80, 140, 120),
				Enum.Material.Glass
			)
			tube(folder, at(x, 27.6, z * 0.6), 0, FLUORESCENT, false)
		end
	end

	-- Spore load in the air of the sick rooms
	Kit.buildGas(folder, nil, "Spores", at(roomCenter(1), 6, -24), 14, 45, "Quarantine")
	Kit.buildGas(folder, nil, "Spores", at(roomCenter(2), 6, -24), 13, 38, "Quarantine")
	Kit.buildGas(folder, nil, "Spores", at(roomCenter(3), 6, 24), 13, 60, "Quarantine")
	local sporeVolume = volume(folder, "SporeMotes", at(-133, 10, 0), Vector3.new(80, 18, 70))
	particles(sporeVolume, "Spores")

	airZone(folder, at(-133, 14, 0), Vector3.new(86, 28, 80), {
		Label = "QUARANTINE Q-9",
		O2 = 19.2,
		CO2 = 3100,
		PM = 210,
		Temp = 33,
		Verdict = "Airborne spore load high: consistent with an active lung-sickness cluster.",
	})
end

local function buildHub(root: Folder): CFrame
	local folder = newModel(root, "OpsHub")
	local floorColor = Color3.fromRGB(80, 78, 74)
	part(
		folder,
		"Floor",
		Vector3.new(74, 1, 52),
		CFrame.new(at(123, 39.5, 0)),
		floorColor,
		Enum.Material.Concrete
	)
	part(
		folder,
		"Ceiling",
		Vector3.new(74, 1, 52),
		CFrame.new(at(123, 63.5, 0)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	for _, z in { -25.5, 25.5 } do
		part(
			folder,
			"Wall",
			Vector3.new(74, 24, 1),
			CFrame.new(at(123, 52, z)),
			Color3.fromRGB(96, 96, 92),
			Enum.Material.Concrete
		)
	end
	part(
		folder,
		"BackWall",
		Vector3.new(1, 24, 52),
		CFrame.new(at(159.5, 52, 0)),
		Color3.fromRGB(96, 96, 92),
		Enum.Material.Concrete
	)
	-- Pipes + cable trays along the ceiling
	for _, z in { -20, -16, 18 } do
		cylinder(
			folder,
			"Pipe",
			72,
			1.2,
			at(123, 61.5, z),
			"X",
			if z > 0 then Color3.fromRGB(40, 90, 150) else RUST,
			Enum.Material.Metal
		)
	end
	for x = 98, 152, 13 do
		tube(folder, at(x, 62.6, -8), math.pi / 2, FLUORESCENT, true)
		tube(folder, at(x, 62.6, 8), math.pi / 2, FLUORESCENT, true)
	end
	-- String lights (warm) over the work area
	for k = 0, 10 do
		local bulb = prop(
			folder,
			"StringLight",
			Vector3.new(0.35, 0.35, 0.35),
			CFrame.new(at(100 + k * 5, 58.5 + math.sin(k) * 0.4, 18)),
			WARM,
			Enum.Material.Neon
		)
		if k % 3 == 0 then
			light(bulb, WARM, 10, 0.6)
		end
	end

	-- Docks (spawn over the middle one)
	local docks = { -14, 0, 14 }
	for index, z in docks do
		Kit.buildDock(folder, nil, "Ops Hub dock " .. index, at(144, 40, z))
	end
	-- Mesh antenna on the rock face beside the hub mouth: the resistance's
	-- link into the open Well (the deck still shadows Level 9 below it)
	local antenna = newModel(folder, "HubAntenna")
	local mast = part(
		antenna,
		"Mast",
		Vector3.new(0.5, 9, 0.5),
		CFrame.new(at(89, 60, -24)),
		STEEL,
		Enum.Material.Metal
	)
	for k = 0, 2 do
		local panelCf = CFrame.new(at(88.6, 62 + k * 1.6, -24))
			* CFrame.Angles(0, math.rad(90 + k * 40), 0)
		prop(
			antenna,
			"Panel",
			Vector3.new(1.4, 1.2, 0.2),
			panelCf * CFrame.new(0, 0, -0.5),
			Color3.fromRGB(220, 220, 214),
			Enum.Material.SmoothPlastic
		)
	end
	local tip = prop(
		antenna,
		"Tip",
		Vector3.new(0.4, 0.4, 0.4),
		CFrame.new(at(89, 64.8, -24)),
		CYAN,
		Enum.Material.Neon
	)
	light(tip, CYAN, 8, 0.6)
	flicker(tip, "Blink")
	antenna.PrimaryPart = mast
	device(antenna, "Antenna", "Ops Hub mesh antenna", {
		Status = "MESH BACKHAUL · FIXED",
		LinkRange = 225,
		Temperature = 33,
	})
	CollectionService:AddTag(antenna, "LinkSource")
	-- Uplink (receives the surface logs and broadcasts them)
	local uplink = Kit.buildTerminal(
		folder,
		nil,
		at(112, 40, -18),
		math.rad(180),
		"Resistance Uplink",
		"",
		"PKT-SURFACE-LOG"
	)
	uplink:SetAttribute("Status", "AWAITING SURFACE DATA")
	-- Map table with a model of the Hollow
	part(
		folder,
		"MapTable",
		Vector3.new(10, 3, 7),
		CFrame.new(at(118, 41.5, 6)),
		STEEL_DARK,
		Enum.Material.Metal
	)
	local holo = prop(
		folder,
		"Holo",
		Vector3.new(0.2, 3.2, 3.2),
		CFrame.new(at(118, 44.8, 6)) * CFrame.Angles(0, 0, math.pi / 2),
		CYAN,
		Enum.Material.Neon
	)
	holo.Shape = Enum.PartType.Cylinder
	holo.Transparency = 0.6
	light(holo, CYAN, 10, 0.8)
	for k = 0, 3 do
		prop(
			folder,
			"HoloLevel",
			Vector3.new(0.05, 3.6 - k * 0.3, 3.6 - k * 0.3),
			CFrame.new(at(118, 43.4 + k * 0.6, 6)) * CFrame.Angles(0, 0, math.pi / 2),
			CYAN,
			Enum.Material.Neon
		).Transparency =
			0.75
	end
	-- Monitor wall
	for row = 0, 1 do
		for col = 0, 3 do
			local screen = prop(
				folder,
				"Monitor",
				Vector3.new(3.4, 2.2, 0.3),
				CFrame.new(at(105 + col * 3.8, 46 + row * 2.6, -24.6)),
				Color3.fromRGB(20, 60, 70),
				Enum.Material.Neon
			)
			screen.Transparency = 0.2
		end
	end
	signage(
		folder,
		CFrame.new(at(124, 57, -24.9)) * CFrame.Angles(0, math.pi, 0),
		Vector2.new(24, 3),
		"THE AIR IS OURS · OPS HUB L8-E",
		WARM,
		Color3.fromRGB(34, 30, 26)
	)
	-- Workbench, crates, cots
	part(
		folder,
		"Bench",
		Vector3.new(10, 3, 3),
		CFrame.new(at(136, 41.5, 22)),
		Color3.fromRGB(110, 90, 66),
		Enum.Material.WoodPlanks
	)
	for k = 0, 3 do
		crate(
			folder,
			CFrame.new(at(100 + k * 3.4, 40, 21)) * CFrame.Angles(0, k * 0.3, 0),
			Vector3.new(3, 2.4, 3)
		)
	end
	for k = 0, 1 do
		bed(
			folder,
			CFrame.new(at(104 + k * 6, 40, -8)) * CFrame.Angles(0, math.pi / 2, 0),
			CLOTH[k + 2]
		)
	end
	bystander(folder, CFrame.lookAt(at(116, 42.2, 2), at(118, 42.2, 6)), "Stand")
	bystander(folder, CFrame.lookAt(at(121, 42.2, 9.5), at(118, 42.2, 6)), "Stand")

	-- Module racks (decor)
	for index, module in Config.MODULE_ORDER do
		local spec = Config.MODULES[module]
		local x = 130 + (index - 1) * 5
		part(
			folder,
			"Rack",
			Vector3.new(4, 6, 1.5),
			CFrame.new(at(x, 43, 24)),
			STEEL_DARK,
			Enum.Material.Metal
		)
		prop(
			folder,
			"Module",
			Vector3.new(2, 1.2, 1.2),
			CFrame.new(at(x, 44, 23.4)),
			spec.color,
			Enum.Material.SmoothPlastic
		)
		signage(
			folder,
			CFrame.new(at(x, 46.5, 23.2)),
			Vector2.new(3.6, 0.8),
			spec.short,
			spec.color,
			Color3.fromRGB(20, 20, 22),
			Enum.Font.Code
		)
	end

	airZone(folder, at(123, 52, 0), Vector3.new(74, 24, 52), {
		Label = "OPS HUB",
		O2 = 20.4,
		CO2 = 1050,
		PM = 30,
		Temp = 26,
	})

	local spawn = at(144, 43.5, 0)
	return CFrame.lookAt(spawn, spawn - Vector3.new(1, 0, 0))
end

local function buildUpperLevels(root: Folder)
	local folder = newModel(root, "UpperLevels")

	-- Clinic 7-N: med supplies + the community board terminal
	local clinic = newModel(folder, "Clinic7N")
	part(
		clinic,
		"Floor",
		Vector3.new(50, 1, 36),
		CFrame.new(at(0, 79.5, -106)),
		Color3.fromRGB(190, 192, 190),
		Enum.Material.Marble
	)
	part(
		clinic,
		"Ceiling",
		Vector3.new(50, 1, 36),
		CFrame.new(at(0, 103.5, -106)),
		Color3.fromRGB(200, 200, 196),
		Enum.Material.Plaster
	)
	for x = -18, 18, 12 do
		tube(clinic, at(x, 102.8, -100), 0, FLUORESCENT, true)
		tube(clinic, at(x, 102.8, -112), 0, FLUORESCENT, true)
	end
	local rack = newModel(clinic, "MedRack")
	local shelf = part(
		rack,
		"Shelf",
		Vector3.new(8, 7, 2),
		CFrame.new(at(-12, 83.5, -122)),
		Color3.fromRGB(220, 220, 214),
		Enum.Material.Metal
	)
	for row = 0, 2 do
		for col = 0, 3 do
			prop(
				rack,
				"Kit",
				Vector3.new(1.4, 1, 1.2),
				CFrame.new(at(-15 + col * 2, 81.4 + row * 2.1, -121.2)),
				Color3.fromRGB(235, 235, 230),
				Enum.Material.SmoothPlastic
			)
			prop(
				rack,
				"Cross",
				Vector3.new(0.6, 0.15, 0.05),
				CFrame.new(at(-15 + col * 2, 81.4 + row * 2.1, -120.55)),
				Color3.fromRGB(220, 40, 40),
				Enum.Material.Neon
			)
		end
	end
	rack.PrimaryPart = shelf
	device(
		rack,
		"MedRack",
		"Clinic 7-N supply rack",
		{ Status = "STOCKED · 24 KITS", Temperature = 22 }
	)
	Kit.buildTerminal(
		clinic,
		nil,
		at(12, 80, -118),
		math.pi,
		"Community Board 7-N",
		"",
		"PKT-L9-FAMILY"
	)
	Kit.buildDock(clinic, nil, "Clinic pad 7-N", at(0, 80, -98))
	for k = 0, 2 do
		bed(
			clinic,
			CFrame.new(at(14 + k * 0, 80, -96 - k * 6)) * CFrame.Angles(0, math.pi / 2, 0),
			Color3.fromRGB(180, 200, 220)
		)
	end
	signage(
		clinic,
		CFrame.new(at(0, 98, -88.2)) * CFrame.Angles(0, math.pi, 0),
		Vector2.new(14, 3),
		"✚ CLINIC 7-N",
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(170, 30, 40)
	)
	bystander(clinic, CFrame.lookAt(at(-6, 82.2, -112), at(-12, 82.2, -122)), "Stand")
	airZone(
		clinic,
		at(0, 92, -106),
		Vector3.new(50, 24, 36),
		{ Label = "CLINIC 7-N", O2 = 20.6, CO2 = 820, PM = 12, Temp = 24 }
	)

	-- Scrubber hall (L7 south): failing CO2 scrubbers, a backup to restart
	local hall = newModel(folder, "ScrubberHall")
	part(
		hall,
		"Floor",
		Vector3.new(60, 1, 50),
		CFrame.new(at(0, 79.5, 112)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	for k = 0, 1 do
		local x = -14 + k * 28
		local unit = part(
			hall,
			"Scrubber",
			Vector3.new(14, 18, 12),
			CFrame.new(at(x, 89, 124)),
			Color3.fromRGB(96, 104, 100),
			Enum.Material.Metal
		)
		heat(unit, if k == 0 then 52 else 30)
		fan(hall, at(x, 98.5, 124), 9, true, "HAir")
		signage(
			hall,
			CFrame.lookAt(at(x, 92, 117.9), at(x, 92, 100)),
			Vector2.new(10, 2),
			if k == 0 then "SCRUBBER A · FAULT" else "SCRUBBER B · STANDBY",
			if k == 0 then EMERGENCY else HAZARD,
			Color3.fromRGB(26, 26, 26),
			Enum.Font.Code
		)
	end
	local hallBreaker =
		breaker(hall, CFrame.lookAt(at(29.2, 83, 106), at(0, 83, 106)), "BACKUP SCRUBBER B", "HAir")
	Kit.buildGas(hall, nil, "CO2", at(0, 90, 112), 24, 9000, "Scrubber")
		:SetAttribute("VentGroup", "HAir")
	local warn = prop(
		hall,
		"Beacon",
		Vector3.new(0.8, 0.8, 0.8),
		CFrame.new(at(-24, 104, 100)),
		Color3.fromRGB(255, 140, 20),
		Enum.Material.Neon
	)
	light(warn, Color3.fromRGB(255, 140, 20), 20, 1)
	flicker(warn, "Rotate")
	Registry.vents.HAir = {
		breaker = hallBreaker,
		objective = "HScrubber",
		onText = "Backup scrubber B running. CO2 in the hall is falling; L6-L8 air cut averted.",
		offText = "Scrubber B stopped. CO2 will build again.",
	}
	airZone(hall, at(0, 94, 112), Vector3.new(60, 28, 50), {
		Label = "SCRUBBER HALL",
		O2 = 19.9,
		CO2 = 1800,
		PM = 22,
		Temp = 31,
		Verdict = "Scrubber A failed. Without B, Levels 6-8 hit 5000 ppm CO2 in ~40 hours.",
	})

	-- Hydroponic farm (L6 west): grow racks under purple light
	local farm = newModel(folder, "Farm6W")
	part(
		farm,
		"Floor",
		Vector3.new(50, 1, 70),
		CFrame.new(at(-112, 119.5, 0)),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	for row = 0, 3 do
		local x = -128 + row * 9
		for tier = 0, 2 do
			part(
				farm,
				"Tray",
				Vector3.new(4, 0.4, 56),
				CFrame.new(at(x, 122 + tier * 5, 0)),
				Color3.fromRGB(220, 222, 220),
				Enum.Material.SmoothPlastic
			)
			local leaves = prop(
				farm,
				"Greens",
				Vector3.new(3.4, 1, 55),
				CFrame.new(at(x, 122.8 + tier * 5, 0)),
				if row == 2 then Color3.fromRGB(150, 140, 60) else Color3.fromRGB(70, 150, 60),
				Enum.Material.Grass
			)
			leaves.CastShadow = false
			local grow = prop(
				farm,
				"GrowLight",
				Vector3.new(3, 0.2, 54),
				CFrame.new(at(x, 125.6 + tier * 5, 0)),
				Color3.fromRGB(230, 80, 255),
				Enum.Material.Neon
			)
			local glow = Instance.new("SurfaceLight")
			glow.Face = Enum.NormalId.Bottom
			glow.Color = Color3.fromRGB(220, 90, 255)
			glow.Range = 6
			glow.Brightness = 1.6
			glow.Parent = grow
		end
		for _, z in { -28, 28 } do
			prop(
				farm,
				"Upright",
				Vector3.new(0.3, 16, 0.3),
				CFrame.new(at(x, 128, z)),
				STEEL,
				Enum.Material.Metal
			)
		end
	end
	local controller = newModel(farm, "FarmController")
	local cabinet = part(
		controller,
		"Cabinet",
		Vector3.new(4, 6, 2),
		CFrame.new(at(-96, 123, -30)),
		Color3.fromRGB(220, 220, 214),
		Enum.Material.Metal
	)
	signage(
		controller,
		CFrame.lookAt(at(-96, 124.5, -28.9), at(-96, 124.5, 0)),
		Vector2.new(3.6, 1),
		"NUTRIENT CTRL",
		Color3.fromRGB(40, 120, 60),
		Color3.fromRGB(230, 230, 220),
		Enum.Font.Code
	)
	controller.PrimaryPart = cabinet
	equipment(
		controller,
		"Farm 6-W nutrient controller",
		33,
		"Dosing pump 2 cavitating; rack C showing nitrogen deficiency (yellowing). Grow-light circuit shares the L9 feeder (T-9).\nFORECAST: 9 days of greens if T-9 trips.\nACTION: swap pump 2; move grow lights to the L8 tie.",
		"DEGRADED · 9 DAYS RESERVE",
		"warning"
	)
	bystander(farm, CFrame.lookAt(at(-115, 122.2, 10), at(-119, 122.2, 10)), "Stand")
	airZone(
		farm,
		at(-112, 132, 0),
		Vector3.new(50, 24, 70),
		{ Label = "FARM 6-W", O2 = 21.4, CO2 = 700, PM = 10, Temp = 25 }
	)

	-- Air for the open upper Well
	airZone(folder, at(0, 140, 0), Vector3.new(184, 200, 184), {
		Label = "UPPER WELL (L6-L8)",
		O2 = 20.6,
		CO2 = 980,
		PM = 24,
		Temp = 26,
	})
end

local function buildShaft(root: Folder)
	local folder = newModel(root, "LiftShaftZero")

	-- Spire top platform under the shaft
	part(
		folder,
		"Platform",
		Vector3.new(26, 1, 26),
		CFrame.new(at(0, 212.5, 0)),
		STEEL,
		Enum.Material.DiamondPlate
	)
	for _, c in { { -12, -12 }, { 12, -12 }, { -12, 12 }, { 12, 12 } } do
		part(
			folder,
			"GuideRail",
			Vector3.new(0.6, 218, 0.6),
			CFrame.new(at(c[1], 322, c[2])),
			STEEL_DARK,
			Enum.Material.Metal
		)
	end
	-- Directorate seal across the shaft with one panel broken out (drone-sized)
	for _, piece in Kit.solids(-13, 13, -13, 13, { Kit.rect(4, 12, 4, 12) }) do
		part(
			folder,
			"Seal",
			Vector3.new(piece.a1 - piece.a0, 2, piece.b1 - piece.b0),
			CFrame.new(at((piece.a0 + piece.a1) / 2, 246, (piece.b0 + piece.b1) / 2)),
			Color3.fromRGB(60, 58, 56),
			Enum.Material.Metal
		)
	end
	part(
		folder,
		"BentPanel",
		Vector3.new(8, 0.6, 8),
		CFrame.new(at(9, 243, 6)) * CFrame.Angles(0.9, 0.2, 0.3),
		RUST,
		Enum.Material.CorrodedMetal
	)
	signage(
		folder,
		CFrame.new(at(0, 244.8, -6)) * CFrame.Angles(-math.pi / 2, 0, 0),
		Vector2.new(20, 5),
		"SURFACE ACCESS SEALED\nDIRECTORATE ORDER 2057 · LETHAL ATMOSPHERE",
		Color3.fromRGB(255, 220, 220),
		DIRECTORATE
	)
	Kit.buildCamera(folder, at(-11, 238, -11), at(0, 214, 0), "Seal camera")

	-- The stuck freight car at ~300 (gaps on both sides to fly through)
	local car = newModel(folder, "LiftCar")
	part(
		car,
		"Floor",
		Vector3.new(14, 1, 22),
		CFrame.new(at(0, 296, 0)),
		STEEL_DARK,
		Enum.Material.DiamondPlate
	)
	part(
		car,
		"Roof",
		Vector3.new(14, 1, 22),
		CFrame.new(at(0, 308, 0)),
		STEEL_DARK,
		Enum.Material.Metal
	)
	for _, x in { -6.8, 6.8 } do
		part(
			car,
			"Side",
			Vector3.new(0.4, 11, 22),
			CFrame.new(at(x, 302, 0)),
			Color3.fromRGB(120, 100, 70),
			Enum.Material.CorrodedMetal
		)
	end
	signage(
		car,
		CFrame.new(at(0, 304, -11.2)),
		Vector2.new(10, 2),
		"FREIGHT 0 · OUT OF SERVICE 2057",
		HAZARD,
		Color3.fromRGB(24, 22, 20),
		Enum.Font.Code
	)
	for _, x in { -2, 2 } do
		prop(
			car,
			"HoistCable",
			Vector3.new(0.3, 120, 0.3),
			CFrame.new(at(x, 368, 0)),
			STEEL_DARK,
			Enum.Material.Metal
		)
	end
	-- Light and dust pouring down from the open top
	local motes = volume(folder, "Motes", at(0, 360, 0), Vector3.new(22, 120, 22))
	particles(motes, "Dust").Rate = 30
	for y = 260, 400, 35 do
		local lampPart = prop(
			folder,
			"ShaftLamp",
			Vector3.new(1, 0.5, 1),
			CFrame.new(at(12.4, y, -12.4)),
			SODIUM,
			Enum.Material.Neon
		)
		light(lampPart, SODIUM, 18, 0.5)
		if y > 300 then
			lampPart.Material = Enum.Material.SmoothPlastic
			lampPart.Color = STEEL_DARK
			local glow = lampPart:FindFirstChildOfClass("PointLight")
			if glow then
				glow.Enabled = false
			end
		end
	end

	airZone(folder, at(0, 330, 0), Vector3.new(26, 170, 26), {
		Label = "LIFT SHAFT ZERO",
		O2 = 20.7,
		CO2 = 520,
		PM = 15,
		Temp = 19,
		Verdict = "Air is drafting DOWN from the surface, and it is clean. Not what the Directorate says.",
	})
end

local function buildSurface(root: Folder)
	local folder = newModel(root, "Surface")
	local y = 430

	-- Hatch collar and the burst blast door
	for _, s in { { 0, -15, 34, 4 }, { 0, 15, 34, 4 }, { -15, 0, 4, 26 }, { 15, 0, 4, 26 } } do
		part(
			folder,
			"Collar",
			Vector3.new(s[3], 3, s[4]),
			CFrame.new(at(s[1], y + 0.5, s[2])),
			CONCRETE,
			Enum.Material.Concrete
		)
	end
	part(
		folder,
		"BlastDoor",
		Vector3.new(24, 1.6, 24),
		CFrame.new(at(-24, y + 6, 0)) * CFrame.Angles(0, 0, math.rad(62)),
		RUST,
		Enum.Material.CorrodedMetal
	)
	signage(
		folder,
		CFrame.new(at(0, y + 2.1, -17.1)),
		Vector2.new(16, 1.6),
		"SHAFT ZERO · SEALED 2057",
		Color3.fromRGB(220, 210, 190),
		Color3.fromRGB(60, 50, 40)
	)

	-- Met Station 4: still logging after 30 years
	local station = newModel(folder, "MetStation4")
	part(
		station,
		"Hut",
		Vector3.new(10, 8, 8),
		CFrame.new(at(46, y + 4, 30)),
		Color3.fromRGB(170, 166, 150),
		Enum.Material.Concrete
	)
	part(
		station,
		"Mast",
		Vector3.new(0.5, 22, 0.5),
		CFrame.new(at(54, y + 11, 34)),
		STEEL,
		Enum.Material.Metal
	)
	local cups = prop(
		station,
		"Anemometer",
		Vector3.new(3, 0.3, 3),
		CFrame.new(at(54, y + 22, 34)),
		Color3.fromRGB(230, 230, 230)
	)
	cups:SetAttribute("VentGroup", "Wind")
	cups:SetAttribute("Running", true)
	CollectionService:AddTag(cups, "Fan")
	part(
		station,
		"Panel",
		Vector3.new(6, 0.3, 4),
		CFrame.new(at(46, y + 8.6, 30)) * CFrame.Angles(0.4, 0, 0),
		Color3.fromRGB(30, 40, 70),
		Enum.Material.Glass
	)
	local met = Kit.buildTerminal(
		station,
		nil,
		at(46, y, 23),
		yawToward(at(46, y, 23), at(0, y, 0)),
		"Surface Met Station 4",
		"PKT-SURFACE-LOG",
		""
	)
	met:SetAttribute("Objective", "HWeatherLog")
	met:SetAttribute("Status", "30 YEARS OF AIR LOGS · JACK IN")

	-- Ruins of the old city: concrete frames, floors partly collapsed
	local ruins: { { x: number, z: number, w: number, d: number, floors: number, yaw: number } } = {
		{ x = -120, z = -100, w = 34, d = 26, floors = 6, yaw = 0.3 },
		{ x = 150, z = -130, w = 28, d = 28, floors = 8, yaw = -0.2 },
		{ x = -175, z = 120, w = 40, d = 30, floors = 4, yaw = 0.9 },
		{ x = 120, z = 160, w = 26, d = 22, floors = 7, yaw = 0.5 },
		{ x = -40, z = -190, w = 30, d = 24, floors = 5, yaw = -0.4 },
	}
	local concrete = Color3.fromRGB(128, 124, 116)
	for _, r in ruins do
		local base = CFrame.new(at(r.x, y, r.z)) * CFrame.Angles(0, r.yaw, 0)
		local storey = 11
		-- the top floors have fallen in: each column stops at a random height
		for cx = -1, 1 do
			for cz = -1, 1, 2 do
				local height = storey * rng:NextInteger(math.max(1, r.floors - 3), r.floors)
				part(
					folder,
					"Column",
					Vector3.new(1.6, height, 1.6),
					base * CFrame.new(cx * r.w / 2.2, height / 2, cz * r.d / 2.2),
					concrete,
					Enum.Material.Concrete
				)
			end
		end
		for floor = 1, r.floors - 1 do
			local missing = rng:NextNumber()
			if missing > 0.25 then
				local share = if floor > r.floors - 3 then rng:NextNumber(0.3, 0.7) else 1
				local slab = part(
					folder,
					"Slab",
					Vector3.new(r.w * share, 1.2, r.d),
					base
						* CFrame.new(-r.w * (1 - share) / 2, floor * storey, 0)
						* CFrame.Angles(0, 0, if share < 1 then rng:NextNumber(-0.12, 0.12) else 0),
					concrete,
					Enum.Material.Concrete
				)
				slab.CastShadow = true
				-- rebar sticking out of broken edges
				if share < 1 then
					for k = 0, 3 do
						prop(
							folder,
							"Rebar",
							Vector3.new(0.15, 0.15, 3),
							base
								* CFrame.new(
									-r.w / 2 + r.w * share + 1,
									floor * storey,
									-r.d / 3 + k * r.d / 4.5
								)
								* CFrame.Angles(0, math.pi / 2, rng:NextNumber(-0.4, 0.4)),
							RUST,
							Enum.Material.CorrodedMetal
						)
					end
				end
			end
		end
		-- rubble mound at the foot
		for _ = 1, 6 do
			local size =
				Vector3.new(rng:NextNumber(3, 8), rng:NextNumber(1.5, 4), rng:NextNumber(3, 8))
			part(
				folder,
				"Rubble",
				size,
				base
					* CFrame.new(
						rng:NextNumber(-r.w / 2, r.w / 2),
						size.Y / 3,
						rng:NextNumber(-r.d / 2, r.d / 2)
					)
					* CFrame.Angles(
						rng:NextNumber(-0.4, 0.4),
						rng:NextNumber(0, 3),
						rng:NextNumber(-0.4, 0.4)
					),
				Color3.fromRGB(116, 112, 104),
				Enum.Material.Slate
			)
		end
		-- ivy reclaiming the frame
		for _ = 1, 4 do
			local height = rng:NextNumber(6, storey * 3)
			prop(
				folder,
				"Ivy",
				Vector3.new(rng:NextNumber(3, 6), height, 0.3),
				base * CFrame.new(rng:NextNumber(-r.w / 2, r.w / 2), height / 2, -r.d / 2.2 - 0.9),
				Color3.fromRGB(56, 92, 44),
				Enum.Material.Grass
			)
		end
	end

	-- Trees and scrub returning: clustered crowns in several greens
	local greens = {
		Color3.fromRGB(62, 98, 46),
		Color3.fromRGB(78, 112, 52),
		Color3.fromRGB(52, 84, 40),
		Color3.fromRGB(92, 118, 60),
	}
	for _ = 1, 34 do
		local x, z = rng:NextNumber(-210, 210), rng:NextNumber(-210, 230)
		if math.abs(x) > 30 or math.abs(z) > 30 then
			local trunkHeight = rng:NextNumber(8, 18)
			local lean = CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08))
			local treeBase = CFrame.new(at(x, y, z)) * lean
			local trunk = part(
				folder,
				"Trunk",
				Vector3.new(trunkHeight, rng:NextNumber(0.7, 1.2), rng:NextNumber(0.7, 1.2)),
				treeBase * CFrame.new(0, trunkHeight / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
				Color3.fromRGB(74, 58, 44),
				Enum.Material.Wood
			)
			trunk.Shape = Enum.PartType.Cylinder
			local top = treeBase * CFrame.new(0, trunkHeight, 0)
			for k = 1, rng:NextInteger(4, 7) do
				local radius = rng:NextNumber(3, 6.5)
				local crown = ball(
					folder,
					"Crown",
					radius * 2,
					(top * CFrame.new(
						rng:NextNumber(-3.5, 3.5),
						rng:NextNumber(-1, 4) + k * 0.4,
						rng:NextNumber(-3.5, 3.5)
					)).Position,
					greens[rng:NextInteger(1, #greens)],
					Enum.Material.Grass
				)
				crown.CanCollide = false
			end
		end
	end
	for _ = 1, 60 do
		local x, z = rng:NextNumber(-220, 220), rng:NextNumber(-220, 240)
		if math.abs(x) > 24 or math.abs(z) > 24 then
			local bush = ball(
				folder,
				"Scrub",
				rng:NextNumber(2, 4.5),
				at(x, y + 0.8, z),
				greens[rng:NextInteger(1, #greens)],
				Enum.Material.Grass
			)
			bush.CanCollide = false
		end
	end
	-- A dormant machine of the old world, half buried
	local machine = newModel(folder, "DormantMachine")
	part(
		machine,
		"Body",
		Vector3.new(18, 10, 12),
		CFrame.new(at(-70, y + 3, 70)) * CFrame.Angles(0.1, 0.6, 0.15),
		Color3.fromRGB(70, 66, 60),
		Enum.Material.CorrodedMetal
	)
	part(
		machine,
		"Arm",
		Vector3.new(26, 2.4, 2.4),
		CFrame.new(at(-58, y + 8, 64)) * CFrame.Angles(0, 0.6, 0.5),
		Color3.fromRGB(80, 74, 66),
		Enum.Material.CorrodedMetal
	)
	local eye = prop(
		machine,
		"Eye",
		Vector3.new(1.2, 1.2, 0.3),
		CFrame.new(at(-63.5, y + 5, 64.6)) * CFrame.Angles(0, 0.6, 0),
		Color3.fromRGB(80, 20, 20),
		Enum.Material.Glass
	)
	eye.Transparency = 0.2

	-- Invisible boundary so the courier drone doesn't wander off
	for _, b in
		{ { 0, -250, 520, 2 }, { 0, 270, 520, 2 }, { -250, 10, 2, 520 }, { 250, 10, 2, 520 } }
	do
		local wall =
			volume(folder, "Boundary", at(b[1], y + 60, b[2]), Vector3.new(b[3], 140, b[4]))
		wall.CanCollide = true
	end

	airZone(folder, at(0, y + 50, 10), Vector3.new(500, 100, 520), {
		Label = "SURFACE · MET STATION 4",
		O2 = 20.8,
		CO2 = 428,
		PM = 9,
		Temp = 17,
		Verdict = "VERDICT: BREATHABLE. Comparable to pre-collapse rural air.",
		Objective = "HSurfaceAir",
	})
end

---------------------------------------------------------------------------
-- Entry
---------------------------------------------------------------------------

local HollowBuilder = {}

local built: Folder? = nil

function HollowBuilder.get(): Folder
	if built then
		return built
	end
	local root = Instance.new("Folder")
	root.Name = "TheHollow"
	root:SetAttribute("Site", "Hollow")
	built = root

	buildTerrain()
	buildWell(root)
	buildPit(root)
	buildStair(root)
	buildCollector(root)
	buildQuarantine(root)
	local spawn = buildHub(root)
	buildUpperLevels(root)
	buildShaft(root)
	buildSurface(root)

	-- Relays below the deck count toward OP-2
	local relayZone = volume(root, "RelayZone", at(0, -4, 0), Vector3.new(480, 82, 480))
	relayZone:SetAttribute("Objective", "HRelays")
	CollectionService:AddTag(relayZone, "RelayZone")

	local relays = Instance.new("Folder")
	relays.Name = "Relays"
	relays.Parent = root

	-- The rock walls of the Well are dark; make sure nothing renders as plastic
	for _, descendant in root:GetDescendants() do
		if
			descendant:IsA("BasePart")
			and descendant.Material == Enum.Material.SmoothPlastic
			and descendant.Transparency < 1
		then
			if descendant.Name ~= "Panel" and descendant.Name ~= "Sign" then
				descendant.Reflectance = 0
			end
		end
	end

	Registry.roots.Hollow = root
	Registry.spawns.Hollow = spawn

	if not Workspace:FindFirstChild("Drones") then
		local drones = Instance.new("Folder")
		drones.Name = "Drones"
		drones.Parent = Workspace
	end
	root.Parent = Workspace

	-- Flood the collector and the Underpass to their starting levels
	fillNow(TUNNEL)
	fillNow(UNDERPASS)
	Workspace:SetAttribute("UnderpassFlooded", true)
	return root
end

function HollowBuilder.init()
	HollowBuilder.get()
end

return HollowBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Junction 9 test range: one hall where every drone mechanic can be shown
-- in a couple of minutes. Every interactive object is tagged "Device" with a
-- DeviceId / DeviceType / Label so the scanner can identify it and the
-- server can validate actions against it.
--
-- Top view (studs). Floor y = 0, ceiling y = 32, hall x -66..66, z -48..48.
--
--   z -48 ┌──────────────┬───────────────────────┬──────────────────────┐
--         │ WARD (sealed)│ MESH: terminal A,     │ SEWER POOL (sunken)  │
--         │ 3 patients,  │ jammer J-8 (cage),    │ valves on north wall │
--         │ visitor,     │ SOS beacon, camera    │ gas + ceiling fans   │
--         │ heater decoy │                       │ drain under debris   │
--         │ door barred ═╡      open floor       │ outflow pipes (east) │
--   z -8  ├──────────────┘                       └──────── breaker ─────┤
--         │ MEZZANINE (y 12): Ada, lost         transformer (inspect)   │
--         │                                                             │
--         │      ramp ════════>  DOCK        SHELTER: Kofi (family),    │
--   z 48  └──────────────────────────────── terminal B, MED RACK ───────┘
--        x -66                    x 0                               x 66
--
-- The med rack is in the far (south-east) corner from the ward's patients,
-- so a delivery is a real flight across the hall and through the ward door.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Characters = require(script.Parent.Parent.Characters)
local Registry = require(script.Parent.Parent.Registry)

export type Refs = {
	root: Folder,
	spawn: CFrame,
	docks: { Model },
	water: BasePart,
	sewerGas: { BasePart },
	valves: { Model },
	breaker: Model,
	fans: { BasePart },
	jammer: Model,
	beacons: { Model },
	terminals: { Model },
	residents: { Model },
}

-- Construction kit (primitives + standard devices) lives in Kit.luau
local Kit = require(script.Parent.Parent.Kit)
local newPart = Kit.newPart
local box = Kit.box
local cylinder = Kit.cylinder
local ball = Kit.ball
local decor = Kit.decor
local light = Kit.light
local lamp = Kit.lamp
local sign = Kit.sign
local facing = Kit.facing
local rect = Kit.rect
local wallX = Kit.wallX
local wallZ = Kit.wallZ
local device = Kit.device
local newModel = Kit.newModel
local buildDock = Kit.buildDock
local buildJunctionBox = Kit.buildJunctionBox
local buildCamera = Kit.buildCamera
local buildGas = Kit.buildGas
local buildDebris = Kit.buildDebris
local buildTerminal = Kit.buildTerminal
local buildBeacon = Kit.buildBeacon
local buildResident = Kit.buildResident
local buildValve = Kit.buildValve
local buildSamplePoint = Kit.buildSamplePoint

local CONCRETE = Kit.colors.CONCRETE
local CONCRETE_DARK = Kit.colors.CONCRETE_DARK
local SEWER = Kit.colors.SEWER
local METAL = Kit.colors.METAL
local METAL_DARK = Kit.colors.METAL_DARK
local HAZARD = Kit.colors.HAZARD
local CYAN = Kit.colors.CYAN
local MAGENTA = Kit.colors.MAGENTA
local RED = Kit.colors.RED
local WHITE = Kit.colors.WHITE
local GREEN = Color3.fromRGB(120, 255, 140)
local MED = Color3.fromRGB(255, 150, 180)
local LAMP = Color3.fromRGB(214, 228, 240)
local EMERGENCY = Color3.fromRGB(255, 70, 50)

-- Hall extents
local X0, X1 = -66, 66
local Z0, Z1 = -48, 48
local CEILING = 32

-- Sewer pool (sunken pit in the north-east)
local POOL = { x0 = 24, x1 = 62, z0 = -46, z1 = -12, bottom = -6 }
local WATER_HIGH = -0.6
local WATER_LOW = -5.2

-- Ward (sealed room in the north-west)
local WARD = { x0 = X0, x1 = -30, z0 = Z0, z1 = -8, roof = 14 }

-- Mezzanine (south-west), reached by a ramp along the south wall
local MEZZ = { x0 = X0, x1 = -40, z0 = 14, z1 = Z1, top = 12 }
local RAMP = { top = Vector3.new(-40, 12, 44), bottom = Vector3.new(-14, 0, 44), width = 6 }

local WorldBuilder = {}

local built: Refs? = nil

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local function volume(parent: Instance, name: string, a: Vector3, b: Vector3): Part
	local part = box(parent, name, a, b, WHITE)
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function glass(parent: Instance, a: Vector3, b: Vector3)
	local pane = box(parent, "Window", a, b, Color3.fromRGB(150, 175, 190), Enum.Material.Glass)
	pane.Transparency = 0.65
	pane.CastShadow = false
end

-- Hip-height rail between two points (collidable, so nothing walks off)
local function rail(parent: Instance, a: Vector3, b: Vector3)
	local length = (b - a).Magnitude
	local mid = (a + b) / 2
	local bar = newPart(
		parent,
		"Rail",
		Vector3.new(0.3, 0.3, length),
		CFrame.lookAt(mid + Vector3.new(0, 3.4, 0), b + Vector3.new(0, 3.4, 0)),
		HAZARD,
		Enum.Material.Metal
	)
	bar.CastShadow = false
	local guard = newPart(
		parent,
		"RailGuard",
		Vector3.new(0.2, 3.6, length),
		CFrame.lookAt(mid + Vector3.new(0, 1.7, 0), b + Vector3.new(0, 1.7, 0)),
		METAL_DARK,
		Enum.Material.DiamondPlate
	)
	guard.Transparency = 0.55
	guard.CastShadow = false
end

local function ramp(parent: Instance, top: Vector3, bottom: Vector3, width: number)
	local length = (bottom - top).Magnitude
	local cf = CFrame.lookAt((top + bottom) / 2, bottom) * CFrame.new(0, -0.5, 0)
	newPart(
		parent,
		"Ramp",
		Vector3.new(width, 1, length),
		cf,
		METAL_DARK,
		Enum.Material.DiamondPlate
	)
	for side = -1, 1, 2 do
		local offset = Vector3.new(0, 0, side * (width / 2 - 0.2))
		rail(parent, top + offset, bottom + offset)
	end
end

-- A hospital bed. Returns the hip CFrame for a person lying in it (head
-- toward the pillow at the cframe's +Z end).
local function bed(parent: Instance, cf: CFrame, blanket: Color3): CFrame
	newPart(
		parent,
		"BedFrame",
		Vector3.new(3.4, 1.4, 7),
		cf * CFrame.new(0, 0.7, 0),
		METAL,
		Enum.Material.Metal
	)
	newPart(
		parent,
		"Mattress",
		Vector3.new(3.2, 0.6, 6.8),
		cf * CFrame.new(0, 1.7, 0),
		Color3.fromRGB(150, 146, 136),
		Enum.Material.Fabric
	)
	decor(
		newPart(
			parent,
			"Pillow",
			Vector3.new(2.2, 0.4, 1.1),
			cf * CFrame.new(0, 2.2, 2.75),
			Color3.fromRGB(196, 192, 182),
			Enum.Material.Fabric
		)
	)
	decor(
		newPart(
			parent,
			"Blanket",
			Vector3.new(3.3, 1.15, 3.4),
			cf * CFrame.new(0, 2.55, -1.75),
			blanket,
			Enum.Material.Fabric
		)
	)
	decor(
		newPart(
			parent,
			"Headboard",
			Vector3.new(3.4, 2.4, 0.3),
			cf * CFrame.new(0, 2.6, 3.4),
			METAL,
			Enum.Material.Metal
		)
	)
	return cf * CFrame.new(0, 2.4, 0.6)
end

-- A plain seat (top at y + 1.6). Returns the hip CFrame of someone on it.
local function seat(parent: Instance, cf: CFrame, width: number): CFrame
	newPart(
		parent,
		"Seat",
		Vector3.new(width, 0.4, 1.8),
		cf * CFrame.new(0, 1.4, 0),
		Color3.fromRGB(80, 64, 48),
		Enum.Material.Wood
	)
	newPart(
		parent,
		"SeatBack",
		Vector3.new(width, 2, 0.3),
		cf * CFrame.new(0, 2.6, 0.85),
		Color3.fromRGB(80, 64, 48),
		Enum.Material.Wood
	)
	for side = -1, 1, 2 do
		decor(
			newPart(
				parent,
				"SeatLeg",
				Vector3.new(0.3, 1.2, 1.6),
				cf * CFrame.new(side * (width / 2 - 0.3), 0.6, 0),
				METAL_DARK,
				Enum.Material.Metal
			)
		)
	end
	return cf * CFrame.new(0, 1.8, -0.1)
end

-- A person who can walk (guide mode); stands at hip CFrame `cf`
local function civilian(
	parent: Instance,
	name: string,
	cf: CFrame,
	shirt: Color3,
	attributes: { [string]: any }
): Model
	local model = Characters.spawn(
		parent,
		"Civilian",
		{ pose = "Stand", cf = cf, shirt = shirt, mobile = true }
	)
	local temperature = Characters.temperature("Healthy")
	local all: { [string]: any } =
		{ Temperature = temperature, BaseTemperature = temperature, Status = "WAITING" }
	for key, value in attributes do
		all[key] = value
	end
	device(model, "Civilian", name, all)
	CollectionService:AddTag(model, "Walker")
	return model
end

-- Background person: warm on thermal, nothing to interact with
local function bystander(parent: Instance, cf: CFrame, pose: string, shirt: Color3)
	local model = Characters.spawn(parent, "Bystander", { pose = pose, cf = cf, shirt = shirt })
	local chest = Characters.chest(model)
	local temperature = Characters.temperature("Healthy")
	chest:SetAttribute("Temperature", temperature)
	chest:SetAttribute("BaseTemperature", temperature)
	CollectionService:AddTag(chest, "Heat")
end

-- Wall-mounted ventilation breaker facing `normal`
local function buildBreaker(parent: Instance, refs: Refs, position: Vector3, normal: Vector3)
	local breaker = newModel(parent, "Breaker")
	local cf = CFrame.lookAt(position, position + normal)
	local panel =
		newPart(breaker, "Panel", Vector3.new(3, 4, 0.6), cf, METAL_DARK, Enum.Material.Metal)
	newPart(
		breaker,
		"Lever",
		Vector3.new(0.4, 1.6, 0.6),
		cf * CFrame.new(0, -0.6, -0.6),
		HAZARD,
		Enum.Material.Metal
	)
	local status = decor(
		ball(
			breaker,
			"StatusLamp",
			0.6,
			(cf * CFrame.new(1, 1.4, -0.4)).Position,
			RED,
			Enum.Material.Neon
		)
	)
	light(status, RED, 6, 1)
	breaker.PrimaryPart = panel
	device(
		breaker,
		"Breaker",
		"Pool ventilation fans (breaker V-1)",
		{ On = false, Status = "OFF" }
	)
	refs.breaker = breaker
end

---------------------------------------------------------------------------
-- Shell: floor, walls, ceiling, lights
---------------------------------------------------------------------------

local function buildShell(parent: Instance)
	-- Floor around the sunken pool
	box(
		parent,
		"Floor",
		Vector3.new(X0, -1, Z0),
		Vector3.new(POOL.x0, 0, Z1),
		CONCRETE,
		Enum.Material.Concrete
	)
	box(
		parent,
		"Floor",
		Vector3.new(POOL.x0, -1, POOL.z1),
		Vector3.new(X1, 0, Z1),
		CONCRETE,
		Enum.Material.Concrete
	)
	box(
		parent,
		"Floor",
		Vector3.new(POOL.x1, -1, Z0),
		Vector3.new(X1, 0, POOL.z1),
		CONCRETE,
		Enum.Material.Concrete
	)
	box(
		parent,
		"Floor",
		Vector3.new(POOL.x0, -1, Z0),
		Vector3.new(POOL.x1, 0, POOL.z0),
		CONCRETE,
		Enum.Material.Concrete
	)
	box(
		parent,
		"Ceiling",
		Vector3.new(X0 - 1, CEILING, Z0 - 1),
		Vector3.new(X1 + 1, CEILING + 1, Z1 + 1),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	wallX(parent, X0 - 0.5, Z0 - 1, Z1 + 1, -1, CEILING, {}, CONCRETE, Enum.Material.Concrete)
	wallX(parent, X1 + 0.5, Z0 - 1, Z1 + 1, -7, CEILING, {}, CONCRETE, Enum.Material.Concrete)
	wallZ(parent, Z0 - 0.5, X0 - 1, X1 + 1, -7, CEILING, {}, CONCRETE, Enum.Material.Concrete)
	wallZ(parent, Z1 + 0.5, X0 - 1, X1 + 1, -1, CEILING, {}, CONCRETE, Enum.Material.Concrete)

	-- Ceiling lights (the ward is left dark: it's the blackout block)
	for _, x in { -14, 14, 42 } do
		for _, z in { -28, 2, 32 } do
			lamp(parent, Vector3.new(x, CEILING - 0.4, z), LAMP, 46, 0.9)
		end
	end
	lamp(parent, Vector3.new(-52, CEILING - 0.4, 30), LAMP, 40, 0.7)

	-- Floor lane markings
	for z = -4, 44, 8 do
		decor(
			box(
				parent,
				"Stripe",
				Vector3.new(-0.2, 0, z),
				Vector3.new(0.2, 0.06, z + 4),
				HAZARD,
				Enum.Material.Neon
			)
		)
	end

	sign(
		parent,
		facing(Vector3.new(0, 26, Z1 - 0.2), Vector3.new(0, 26, 0)),
		Vector2.new(34, 4),
		"JUNCTION 9 // DRONE TEST RANGE",
		CYAN
	)
	sign(
		parent,
		facing(Vector3.new(0, 22.5, Z1 - 0.2), Vector3.new(0, 22.5, 0)),
		Vector2.new(34, 2),
		"Every mechanic in one hall  ·  [Log] for the checklist",
		Color3.fromRGB(200, 200, 200),
		Enum.Font.Code
	)
end

---------------------------------------------------------------------------
-- South: dock + module racks
---------------------------------------------------------------------------

local function buildDockArea(parent: Instance, refs: Refs)
	buildDock(parent, refs, "Range Dock R-0", Vector3.new(0, 0, 36))
	refs.spawn = CFrame.lookAt(Vector3.new(0, 3, 36), Vector3.new(0, 3, 0))
	for index, module in Config.MODULE_ORDER do
		local x = -14 + index * 6
		box(
			parent,
			"Rack",
			Vector3.new(x - 2.4, 0, 44.5),
			Vector3.new(x + 2.4, 4, 47.5),
			METAL_DARK,
			Enum.Material.Metal
		)
		decor(
			box(
				parent,
				"RackGlow",
				Vector3.new(x - 2.4, 4, 44.5),
				Vector3.new(x + 2.4, 4.3, 44.7),
				Config.MODULES[module].color,
				Enum.Material.Neon
			)
		)
		sign(
			parent,
			facing(Vector3.new(x, 6, 47.8), Vector3.new(x, 6, 0)),
			Vector2.new(5, 1.2),
			Config.MODULES[module].label,
			Config.MODULES[module].color,
			Enum.Font.Code
		)
	end
	buildJunctionBox(parent, Vector3.new(18, 5, Z1 - 0.6), Vector3.new(0, 0, -1), "Dock power feed")
end

---------------------------------------------------------------------------
-- North-east: sewer pool (water samples, valves, drain, gas, fans)
---------------------------------------------------------------------------

local function buildPool(parent: Instance, refs: Refs)
	-- Pit
	box(
		parent,
		"PoolBottom",
		Vector3.new(POOL.x0, POOL.bottom - 1, POOL.z0),
		Vector3.new(POOL.x1, POOL.bottom, POOL.z1),
		SEWER,
		Enum.Material.Slate
	)
	box(
		parent,
		"PoolWall",
		Vector3.new(POOL.x0 - 1, POOL.bottom - 1, POOL.z0),
		Vector3.new(POOL.x0, 0, POOL.z1),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	box(
		parent,
		"PoolWall",
		Vector3.new(POOL.x1, POOL.bottom - 1, POOL.z0),
		Vector3.new(POOL.x1 + 1, 0, POOL.z1),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	box(
		parent,
		"PoolWall",
		Vector3.new(POOL.x0, POOL.bottom - 1, POOL.z0 - 1),
		Vector3.new(POOL.x1, 0, POOL.z0),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	box(
		parent,
		"PoolWall",
		Vector3.new(POOL.x0, POOL.bottom - 1, POOL.z1),
		Vector3.new(POOL.x1, 0, POOL.z1 + 1),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	-- Hazard edge + rails on the open sides
	decor(
		box(
			parent,
			"Edge",
			Vector3.new(POOL.x0 - 1, 0, POOL.z1),
			Vector3.new(POOL.x1 + 1, 0.06, POOL.z1 + 1),
			HAZARD,
			Enum.Material.SmoothPlastic
		)
	)
	decor(
		box(
			parent,
			"Edge",
			Vector3.new(POOL.x0 - 1, 0, POOL.z0),
			Vector3.new(POOL.x0, 0.06, POOL.z1),
			HAZARD,
			Enum.Material.SmoothPlastic
		)
	)
	rail(
		parent,
		Vector3.new(POOL.x0 - 0.5, 0, POOL.z1 + 0.5),
		Vector3.new(POOL.x1, 0, POOL.z1 + 0.5)
	)
	rail(
		parent,
		Vector3.new(POOL.x0 - 0.5, 0, POOL.z0),
		Vector3.new(POOL.x0 - 0.5, 0, POOL.z1 + 0.5)
	)

	-- Inflow culvert (north wall) and the drain grate (pit floor, east end)
	decor(
		cylinder(
			parent,
			"Culvert",
			1,
			5,
			Vector3.new(30, -2.5, Z0 + 0.1),
			"Z",
			Color3.fromRGB(20, 22, 20),
			Enum.Material.Metal
		)
	)
	decor(
		box(
			parent,
			"DrainGrate",
			Vector3.new(56, POOL.bottom, -31),
			Vector3.new(60, POOL.bottom + 0.15, -27),
			Color3.fromRGB(26, 26, 26),
			Enum.Material.DiamondPlate
		)
	)
	buildDebris(
		parent,
		Vector3.new(57.2, POOL.bottom + 0.9, -29.6),
		Vector3.new(2.2, 1.8, 2),
		"RDrain",
		"Collapsed brick"
	)
	buildDebris(
		parent,
		Vector3.new(58.6, POOL.bottom + 0.8, -27.8),
		Vector3.new(2, 1.6, 2.4),
		"RDrain",
		"Waste sack"
	)

	-- Flood control valves on the north wall
	buildValve(
		parent,
		refs,
		Vector3.new(36, 5, Z0 + 1.2),
		1,
		"Drain gate D-1 (open to drain the pool)",
		true,
		false
	)
	buildValve(
		parent,
		refs,
		Vector3.new(48, 5, Z0 + 1.2),
		1,
		"Inflow gate IN-2 (close to stop the inflow)",
		false,
		true
	)
	sign(
		parent,
		facing(Vector3.new(42, 10.5, Z0 + 0.2), Vector3.new(42, 10.5, 0)),
		Vector2.new(22, 1.6),
		"SEWER POOL S-3 // FLOOD CONTROL",
		HAZARD,
		Enum.Font.Code
	)

	-- Outflow pipes on the east wall
	buildSamplePoint(
		parent,
		Vector3.new(X1 - 0.6, 2.5, -38),
		Vector3.new(-1, 0, 0),
		"Outflow 1 (residential L8)",
		{
			Contaminated = true,
			PH = 6.1,
			Coliform = 2400,
			Lead = 4,
		}
	)
	buildSamplePoint(
		parent,
		Vector3.new(X1 - 0.6, 2.5, -20),
		Vector3.new(-1, 0, 0),
		"Outflow 2 (recycler return)",
		{
			Contaminated = false,
			PH = 7.2,
			Coliform = 0,
			Lead = 2,
		}
	)

	-- Toxic gas over the water (invisible except in CHEM vision)
	buildGas(parent, refs, "H2S", Vector3.new(42, 1.5, -29), 11, 170, "Sewer")
	buildGas(parent, refs, "CH4", Vector3.new(54, 2.5, -40), 7, 40, "Sewer")

	-- Ceiling fans over the pool, on breaker V-1 (east wall)
	refs.fans = {}
	for _, x in { 34, 50 } do
		decor(
			cylinder(
				parent,
				"FanHousing",
				1,
				7,
				Vector3.new(x, CEILING - 0.7, -29),
				"Y",
				METAL_DARK,
				Enum.Material.Metal
			)
		)
		local blades = newPart(
			parent,
			"FanBlades",
			Vector3.new(6, 0.2, 1),
			CFrame.new(x, CEILING - 1.4, -29),
			METAL,
			Enum.Material.Metal
		)
		decor(blades)
		table.insert(refs.fans, blades)
	end
	buildBreaker(parent, refs, Vector3.new(X1 - 0.3, 5, -6), Vector3.new(-1, 0, 0))
	sign(
		parent,
		facing(Vector3.new(X1 - 0.2, 8.4, -6), Vector3.new(0, 8.4, -6)),
		Vector2.new(6, 1),
		"VENT BREAKER V-1",
		HAZARD,
		Enum.Font.Code
	)

	-- Water (level driven by the Environment system)
	local water = box(
		parent,
		"PoolWater",
		Vector3.new(POOL.x0, POOL.bottom, POOL.z0),
		Vector3.new(POOL.x1, WATER_HIGH, POOL.z1),
		Color3.fromRGB(55, 70, 40),
		Enum.Material.Glass
	)
	water.Transparency = 0.35
	decor(water)
	refs.water = water
end

---------------------------------------------------------------------------
-- East: plant equipment (early warning)
---------------------------------------------------------------------------

local function buildTransformer(parent: Instance)
	local model = newModel(parent, "Transformer")
	local body = box(
		model,
		"Body",
		Vector3.new(54, 0, 2),
		Vector3.new(60, 7, 8),
		Color3.fromRGB(70, 78, 70),
		Enum.Material.Metal
	)
	for i = 0, 5 do
		decor(
			box(
				model,
				"Fin",
				Vector3.new(53.4, 1, 2.6 + i),
				Vector3.new(54, 6, 2.8 + i),
				METAL_DARK,
				Enum.Material.Metal
			)
		)
	end
	for _, z in { 3.5, 5, 6.5 } do
		decor(
			cylinder(
				model,
				"Bushing",
				2,
				0.6,
				Vector3.new(57, 8, z),
				"Y",
				Color3.fromRGB(150, 110, 80),
				Enum.Material.Granite
			)
		)
	end
	sign(
		model,
		facing(Vector3.new(53.1, 5, 5), Vector3.new(0, 5, 5)),
		Vector2.new(4.5, 1),
		"TX-4  11kV",
		HAZARD,
		Enum.Font.Code
	)
	model.PrimaryPart = body
	device(model, "Equipment", "Transformer TX-4 (feeds the ward)", {
		Temperature = 96,
		Diagnostic = "Oil 205°F / 96°C (limit 221°F / 105°C), rising 2.5°F / 1.4°C per day. Cooling fins clogged.\nFORECAST: thermal trip in ~6 days → ward blackout.\nACTION: clean fins, shed 18% load tonight.",
		Verdict = "TRIP IN ~6 DAYS",
		Severity = "danger",
		Objective = "RInspect",
		Status = "NOT SURVEYED",
	})
end

---------------------------------------------------------------------------
-- North: mesh network (jammer, terminal A, beacon)
---------------------------------------------------------------------------

local function buildMesh(parent: Instance, refs: Refs)
	-- Jammer J-8 in a mesh cage against the north wall
	local jammer = newModel(parent, "Jammer")
	local body = newPart(
		jammer,
		"Body",
		Vector3.new(3.4, 5, 2),
		CFrame.new(4, 2.5, Z0 + 2),
		Color3.fromRGB(30, 28, 34),
		Enum.Material.Metal
	)
	for _, x in { 3, 5 } do
		decor(
			cylinder(
				jammer,
				"Antenna",
				6,
				0.3,
				Vector3.new(x, 8, Z0 + 2),
				"Y",
				METAL,
				Enum.Material.Metal
			)
		)
	end
	local strip = decor(
		newPart(
			jammer,
			"Glow",
			Vector3.new(3, 0.3, 0.2),
			CFrame.new(4, 4.2, Z0 + 3.05),
			MAGENTA,
			Enum.Material.Neon
		)
	)
	light(strip, MAGENTA, 18, 1.2)
	newPart(
		jammer,
		"Cable",
		Vector3.new(0.6, 0.6, 6),
		CFrame.new(6.2, 0.3, Z0 + 4),
		Color3.fromRGB(20, 20, 20),
		Enum.Material.Rubber
	)
	jammer.PrimaryPart = body
	device(jammer, "Jammer", "Directorate signal jammer J-8", {
		Active = true,
		Status = "JAMMING ALL BANDS",
		Temperature = 52,
		JamRadius = 22,
		JamFactor = 0.15,
	})
	CollectionService:AddTag(jammer, "Jammer")
	refs.jammer = jammer
	sign(
		parent,
		facing(Vector3.new(4, 11, Z0 + 0.2), Vector3.new(4, 11, 0)),
		Vector2.new(12, 1.6),
		"MESH // DIRECTORATE JAMMER",
		MAGENTA,
		Enum.Font.Code
	)

	-- Terminal A sits inside the jammed zone; B is across the hall (shelter)
	buildTerminal(
		parent,
		refs,
		Vector3.new(-14, 0, Z0 + 3),
		math.pi,
		"Range Terminal A",
		"PKT-RANGE-ROLL",
		""
	)
	buildBeacon(
		parent,
		refs,
		Vector3.new(16, 9, Z0 + 0.6),
		Vector3.new(0, 0, 1),
		"Family SOS beacon"
	)
	buildCamera(
		parent,
		Vector3.new(-22, CEILING - 4, Z0 + 2),
		Vector3.new(0, 0, -20),
		"Directorate cam R-1"
	)
	buildJunctionBox(parent, Vector3.new(-6, 5, Z0 + 0.6), Vector3.new(0, 0, 1), "Jammer mains")
	-- Dim red work light over the jammer cage
	lamp(parent, Vector3.new(4, CEILING - 0.4, Z0 + 6), EMERGENCY, 24, 0.5)
end

---------------------------------------------------------------------------
-- North-west: the ward (outbreak + care), sealed and blacked out
---------------------------------------------------------------------------

local function buildWard(parent: Instance, refs: Refs)
	-- East wall: barricaded door + observation windows
	wallX(
		parent,
		WARD.x1,
		WARD.z0,
		WARD.z1,
		0,
		WARD.roof,
		{ rect(-24, -18, 0, 9), rect(-44, -30, 4, 8) },
		CONCRETE,
		Enum.Material.Concrete
	)
	glass(parent, Vector3.new(WARD.x1 - 0.2, 4, -44), Vector3.new(WARD.x1 + 0.2, 8, -30))
	-- South wall with a window
	wallZ(
		parent,
		WARD.z1,
		WARD.x0,
		WARD.x1 + 0.5,
		0,
		WARD.roof,
		{ rect(-60, -40, 4, 8) },
		CONCRETE,
		Enum.Material.Concrete
	)
	glass(parent, Vector3.new(-60, 4, WARD.z1 - 0.2), Vector3.new(-40, 8, WARD.z1 + 0.2))
	box(
		parent,
		"WardRoof",
		Vector3.new(WARD.x0, WARD.roof, WARD.z0),
		Vector3.new(WARD.x1 + 0.5, WARD.roof + 1, WARD.z1 + 0.5),
		CONCRETE_DARK,
		Enum.Material.Concrete
	)
	sign(
		parent,
		facing(Vector3.new(WARD.x1 + 0.6, 11.5, -21), Vector3.new(0, 11.5, -21)),
		Vector2.new(14, 2),
		"WARD W-1 // QUARANTINE",
		MED
	)
	sign(
		parent,
		facing(Vector3.new(WARD.x1 + 0.6, 9.8, -21), Vector3.new(0, 9.8, -21)),
		Vector2.new(14, 1.2),
		"Sealed since the blackout. Official count: 1 sick.",
		Color3.fromRGB(200, 200, 200),
		Enum.Font.Code
	)

	-- Barricade in the doorway (outside face)
	buildDebris(
		parent,
		Vector3.new(WARD.x1 + 1.4, 2, -21),
		Vector3.new(1.4, 4, 6.4),
		"RDoor",
		"Fallen locker"
	)
	buildDebris(
		parent,
		Vector3.new(WARD.x1 + 1.4, 6.5, -21),
		Vector3.new(1.2, 5, 6.4),
		"RDoor",
		"Plywood barricade"
	)

	-- Beds along the west wall, pillows toward the wall
	local yaw = CFrame.Angles(0, -math.pi / 2, 0)
	local people = {
		{
			z = -42,
			name = "Amara Osei, 34",
			condition = "Fever",
			shirt = Color3.fromRGB(150, 70, 80),
			blanket = Color3.fromRGB(70, 90, 120),
		},
		{
			z = -30,
			name = "Tomas Reyes, 61",
			condition = "Fever",
			shirt = Color3.fromRGB(90, 110, 90),
			blanket = Color3.fromRGB(120, 100, 70),
		},
		{
			z = -18,
			name = "Ivo Petrov, 45",
			condition = "Dehydrated",
			shirt = Color3.fromRGB(110, 110, 130),
			blanket = Color3.fromRGB(80, 80, 86),
		},
	}
	for _, spec in people do
		local hips = bed(parent, CFrame.new(-60, 0, spec.z) * yaw, spec.blanket)
		buildResident(parent, refs, {
			name = spec.name,
			condition = spec.condition,
			cf = hips,
			pose = "Lie",
			shirt = spec.shirt,
		})
	end
	-- A visitor sitting by Tomas (healthy: a thermal false alarm)
	local chair = seat(parent, CFrame.new(-53, 0, -27.5) * CFrame.Angles(0, math.pi / 2, 0), 2.2)
	buildResident(parent, refs, {
		name = "Nadia Reyes, 58",
		condition = "Healthy",
		cf = chair,
		pose = "Sit",
		shirt = Color3.fromRGB(170, 120, 60),
	})

	-- Space heater: hot on thermal, but not a person
	local heater = newModel(parent, "SpaceHeater")
	local heaterBody = newPart(
		heater,
		"Body",
		Vector3.new(2, 2.4, 1),
		CFrame.new(-36, 1.2, -45),
		METAL_DARK,
		Enum.Material.Metal
	)
	decor(
		newPart(
			heater,
			"Coils",
			Vector3.new(1.6, 1.6, 0.1),
			heaterBody.CFrame * CFrame.new(0, 0, 0.52) * CFrame.Angles(0, math.pi, 0),
			Color3.fromRGB(255, 90, 20),
			Enum.Material.Neon
		)
	)
	heater.PrimaryPart = heaterBody
	device(
		heater,
		"HeatSource",
		"Unknown heat signature",
		{ Temperature = 61, Status = "UNIDENTIFIED" }
	)

	-- Stale, spore-laden air
	buildGas(parent, nil, "Spores", Vector3.new(-50, 5, -30), 10, 45, "Quarantine")
	local zone = volume(
		parent,
		"AirZone",
		Vector3.new(WARD.x0, 0, WARD.z0),
		Vector3.new(WARD.x1, WARD.roof, WARD.z1)
	)
	for key, value in
		{
			Label = "WARD W-1",
			O2 = 19.6,
			CO2 = 2600,
			PM = 64,
			Temp = 31,
			Verdict = "Stale, crowded air: CO2 high, spores present. Ventilate before anyone else goes in.",
			Objective = "RAir",
		} :: { [string]: any }
	do
		zone:SetAttribute(key, value)
	end
	CollectionService:AddTag(zone, "AirZone")

	-- One dim emergency light: the ward is a blackout block (thermal / NV)
	local bulb = decor(
		ball(
			parent,
			"EmergencyBulb",
			0.5,
			Vector3.new(-48, WARD.roof - 0.4, -30),
			EMERGENCY,
			Enum.Material.Neon
		)
	)
	light(bulb, EMERGENCY, 16, 0.25)
	bulb:SetAttribute("FlickerMode", "Pulse")
	CollectionService:AddTag(bulb, "Flicker")
end

---------------------------------------------------------------------------
-- South-west: mezzanine + ramp (guide mode start)
---------------------------------------------------------------------------

local function buildMezzanine(parent: Instance)
	box(
		parent,
		"Mezzanine",
		Vector3.new(MEZZ.x0, MEZZ.top - 1, MEZZ.z0),
		Vector3.new(MEZZ.x1, MEZZ.top, MEZZ.z1),
		METAL_DARK,
		Enum.Material.DiamondPlate
	)
	for _, x in { MEZZ.x1 - 1, -53 } do
		for _, z in { MEZZ.z0 + 1, 30 } do
			box(
				parent,
				"Column",
				Vector3.new(x - 0.6, 0, z - 0.6),
				Vector3.new(x + 0.6, MEZZ.top - 1, z + 0.6),
				METAL,
				Enum.Material.Metal
			)
		end
	end
	-- Rails: north edge, east edge (open where the ramp joins)
	rail(
		parent,
		Vector3.new(MEZZ.x0, MEZZ.top, MEZZ.z0 + 0.3),
		Vector3.new(MEZZ.x1, MEZZ.top, MEZZ.z0 + 0.3)
	)
	rail(
		parent,
		Vector3.new(MEZZ.x1 - 0.3, MEZZ.top, MEZZ.z0),
		Vector3.new(MEZZ.x1 - 0.3, MEZZ.top, RAMP.top.Z - RAMP.width / 2)
	)
	ramp(parent, RAMP.top, RAMP.bottom, RAMP.width)
	lamp(parent, Vector3.new(-56, MEZZ.top + 8, 36), Color3.fromRGB(255, 196, 130), 22, 0.5)
	sign(
		parent,
		facing(Vector3.new(MEZZ.x1 - 0.6, MEZZ.top + 5, 26), Vector3.new(0, MEZZ.top + 5, 26)),
		Vector2.new(12, 1.4),
		"MEZZANINE // L8 ACCESS",
		HAZARD,
		Enum.Font.Code
	)
	-- Storage under the mezzanine
	local rng = Random.new(87)
	for _ = 1, 6 do
		local x = rng:NextNumber(-63, -48)
		local z = rng:NextNumber(18, 44)
		local s = rng:NextNumber(2.5, 4)
		box(
			parent,
			"Crate",
			Vector3.new(x, 0, z),
			Vector3.new(x + s, s, z + s),
			Color3.fromRGB(70, 74, 60),
			Enum.Material.WoodPlanks
		)
	end
	-- Ada: lost up here since the blackout
	civilian(
		parent,
		"Ada Mensah, 27",
		CFrame.lookAt(Vector3.new(-56, MEZZ.top + 1.95, 24), Vector3.new(-40, MEZZ.top + 1.95, 24)),
		Color3.fromRGB(180, 120, 60),
		{
			Lost = true,
			ReuniteWith = "Kofi Mensah",
			Route = "down the mezzanine ramp and across the hall",
			Objective = "RReunite",
			Status = "LOST · CAN'T FIND THE WAY DOWN IN THE DARK",
		}
	)
end

---------------------------------------------------------------------------
-- South-east: shelter (family, terminal B, med rack)
---------------------------------------------------------------------------

local function buildShelter(parent: Instance, refs: Refs)
	sign(
		parent,
		facing(Vector3.new(44, 12, Z1 - 0.2), Vector3.new(44, 12, 0)),
		Vector2.new(16, 2),
		"SHELTER // MED SUPPLY",
		GREEN
	)
	-- Benches
	for _, x in { 32, 40 } do
		seat(parent, CFrame.new(x, 0, 41), 6)
	end
	bystander(
		parent,
		CFrame.new(40, 0, 41) * CFrame.new(1.2, 1.8, -0.1),
		"Sit",
		Color3.fromRGB(70, 90, 120)
	)
	-- Kofi waits here for Ada
	civilian(
		parent,
		"Kofi Mensah, 59",
		CFrame.lookAt(Vector3.new(44, 1.95, 30), Vector3.new(30, 1.95, 30)),
		Color3.fromRGB(70, 90, 120),
		{
			Family = "Kofi Mensah",
			Place = "the shelter corner",
			Status = "WAITING FOR ADA",
		}
	)
	buildTerminal(
		parent,
		refs,
		Vector3.new(26, 0, Z1 - 3),
		0,
		"Shelter Terminal B",
		"",
		"PKT-RANGE-ROLL"
	)

	-- Med supply rack on the east wall (far side of the hall from the ward)
	local rack = newModel(parent, "MedRack")
	local cf = CFrame.lookAt(Vector3.new(X1 - 0.8, 3, 34), Vector3.new(0, 3, 34))
	local frame =
		newPart(rack, "Frame", Vector3.new(4, 6, 1.2), cf, METAL_DARK, Enum.Material.Metal)
	for row = 0, 2 do
		for col = -1, 1 do
			local kit = newPart(
				rack,
				"Kit",
				Vector3.new(1, 0.8, 0.9),
				cf * CFrame.new(col * 1.2, -2 + row * 1.8, -0.5),
				WHITE
			)
			decor(
				newPart(
					rack,
					"Cross",
					Vector3.new(0.5, 0.15, 0.05),
					kit.CFrame * CFrame.new(0, 0, -0.47),
					RED,
					Enum.Material.Neon
				)
			)
		end
	end
	light(frame, Color3.fromRGB(255, 200, 210), 8, 0.6)
	rack.PrimaryPart = frame
	device(rack, "MedRack", "Field med supplies", { Status = "STOCKED", Temperature = 18 })
end

---------------------------------------------------------------------------
-- Registration with the generic simulation
---------------------------------------------------------------------------

local function register(refs: Refs)
	local root = refs.root
	root:SetAttribute("Site", "Range")
	Registry.roots.Range = root
	Registry.spawns.Range = refs.spawn

	for _, valve in refs.valves do
		valve:SetAttribute("FloodGroup", "R1")
	end
	for _, instance in root:GetDescendants() do
		local deviceType = instance:GetAttribute("DeviceType")
		if deviceType == "Debris" and instance:GetAttribute("Objective") == "RDrain" then
			instance:SetAttribute("FloodGroup", "R1")
		elseif deviceType == "SamplePoint" then
			instance:SetAttribute("Objective", "RSamples")
		end
	end
	for _, cloud in refs.sewerGas do
		cloud:SetAttribute("VentGroup", "R1")
	end
	for _, fan in refs.fans do
		fan:SetAttribute("VentGroup", "R1")
		fan:SetAttribute("Running", false)
		CollectionService:AddTag(fan, "Fan")
	end
	refs.breaker:SetAttribute("VentGroup", "R1")
	refs.jammer:SetAttribute("Objective", "RJammer")
	refs.jammer:SetAttribute("CutText", "Jammer J-8 is offline. Terminal A has a clean link again.")
	for _, beacon in refs.beacons do
		beacon:SetAttribute("Objective", "RBeacon")
		beacon:SetAttribute(
			"Message",
			"Mensah family: Kofi is safe in the shelter corner. Ada, where are you?"
		)
	end
	for _, resident in refs.residents do
		resident:SetAttribute("LocateObjective", "RLocated")
		resident:SetAttribute("TreatObjective", "RTreated")
	end

	-- A relay at the ward door is what gets a usable link inside the sealed ward
	local zone = volume(
		root,
		"RelayZone",
		Vector3.new(WARD.x0, 0, WARD.z0),
		Vector3.new(WARD.x1 + 8, WARD.roof, WARD.z1)
	)
	zone:SetAttribute("Objective", "RRelay")
	CollectionService:AddTag(zone, "RelayZone")

	local water = refs.water
	local bottom = POOL.bottom
	Registry.floods.R1 = {
		valves = (refs.valves :: any) :: { Instance },
		valveObjective = "RValves",
		debrisObjective = "RDrain",
		debrisTotal = 2,
		apply = function(progress: number): number
			local level = WATER_HIGH + (WATER_LOW - WATER_HIGH) * progress
			local height = math.max(0.2, level - bottom)
			TweenService:Create(water, TweenInfo.new(6, Enum.EasingStyle.Sine), {
				Size = Vector3.new(water.Size.X, height, water.Size.Z),
				CFrame = CFrame.new(water.Position.X, bottom + height / 2, water.Position.Z),
			}):Play()
			return level
		end,
		describe = function(level: number): string
			return ("Pool water heading to %.1fm deep."):format(
				(level - bottom) * Config.STUDS_TO_METERS
			)
		end,
	}
	Registry.vents.R1 = {
		breaker = refs.breaker,
		objective = "RGas",
		onText = "Ventilation fans ON. The gas over the pool will clear over ~20s. Check it in CHEM vision.",
		offText = "Ventilation fans OFF. Gas will build back up.",
	}
end

function WorldBuilder.get(): Refs
	if built then
		return built
	end

	for _, name in { "Baseplate", "SpawnLocation" } do
		local existing = Workspace:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end

	local root = Instance.new("Folder")
	root.Name = "Junction9"
	local refs = {
		root = root,
		docks = {},
		sewerGas = {},
		valves = {},
		fans = {},
		beacons = {},
		terminals = {},
		residents = {},
	} :: any

	local function zone(name: string): Folder
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = root
		return folder
	end

	buildShell(zone("Hall"))
	buildDockArea(zone("Dock"), refs)
	buildPool(zone("SewerPool"), refs)
	buildTransformer(zone("Plant"))
	buildMesh(zone("Mesh"), refs)
	buildWard(zone("Ward"), refs)
	buildMezzanine(zone("Mezzanine"))
	buildShelter(zone("Shelter"), refs)

	if not Workspace:FindFirstChild("Drones") then
		local drones = Instance.new("Folder")
		drones.Name = "Drones"
		drones.Parent = Workspace
	end

	local relays = Instance.new("Folder")
	relays.Name = "Relays"
	relays.Parent = root

	register(refs :: Refs)
	root.Parent = Workspace
	built = refs :: Refs
	return refs :: Refs
end

function WorldBuilder.init()
	WorldBuilder.get()
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="30">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="31">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="32">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Hollow Drone client entry point.

local StarterGui = game:GetService("StarterGui")

-- A drone feed, not a game: hide Roblox's player list, backpack, health and
-- emote menus (the player list would also swallow the Tab key)
for _, coreGui in
	{
		Enum.CoreGuiType.PlayerList,
		Enum.CoreGuiType.Backpack,
		Enum.CoreGuiType.Health,
		Enum.CoreGuiType.EmotesMenu,
	}
do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreGui, false)
	end)
end

local Controllers = script:FindFirstChild("Controllers")

local loaded: { [string]: any } = {}
if Controllers then
	for _, child in Controllers:GetChildren() do
		if child:IsA("ModuleScript") then
			loaded[child.Name] = require(child) :: any
		end
	end
end

for _, controller in loaded do
	if typeof(controller.init) == "function" then
		controller.init()
	end
end

for _, controller in loaded do
	if typeof(controller.start) == "function" then
		task.spawn(controller.start)
	end
end

print("[HollowDrone] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="33">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- Local-only life in the world, at full frame rate: fans spinning, faulty
-- lights flickering, fire light, aviation blinkers, sweeping Directorate
-- cameras, SOS beacon strobes, exhaust steam, the drone's own strobe and
-- sick people coughing.
-- The server only flips attributes; nothing here is replicated.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Ambience = {}

type LightState = {
	part: BasePart,
	color: Color3,
	material: Enum.Material,
	lights: { Light },
	base: { number },
	mode: string,
	seed: number,
	off: boolean,
}

local flickers: { [BasePart]: LightState } = {}
local cameras: { [Model]: { pivot: CFrame, seed: number } } = {}
local rng = Random.new()

local function track(part: Instance)
	if not part:IsA("BasePart") or flickers[part] then
		return
	end
	local lights: { Light } = {}
	local base: { number } = {}
	for _, child in part:GetChildren() do
		if child:IsA("Light") then
			table.insert(lights, child)
			table.insert(base, child.Brightness)
		end
	end
	local mode = part:GetAttribute("FlickerMode")
	flickers[part] = {
		part = part,
		color = part.Color,
		material = part.Material,
		lights = lights,
		base = base,
		mode = if typeof(mode) == "string" then mode else "Fault",
		seed = rng:NextNumber(0, 100),
		off = false,
	}
end

local function setLevel(state: LightState, level: number)
	for index, lightObject in state.lights do
		lightObject.Brightness = state.base[index] * level
	end
	local off = level < 0.15
	if off ~= state.off then
		state.off = off
		state.part.Material = if off then Enum.Material.SmoothPlastic else state.material
		state.part.Color = if off then state.color:Lerp(Color3.new(0, 0, 0), 0.7) else state.color
	end
end

local function flickerStep(t: number)
	for part, state in flickers do
		if not part.Parent then
			flickers[part] = nil
			continue
		end
		local mode = state.mode
		local level = 1
		if mode == "Fault" then
			-- mostly on, with bursts of failing starter
			local burst = math.noise(t * 0.4, state.seed) > 0.25
			if burst then
				level = if math.noise(t * 22, state.seed) > 0 then 1 else 0
			end
		elseif mode == "Pulse" then
			level = 0.35 + 0.65 * (0.5 + 0.5 * math.sin(t * 2.2 + state.seed))
		elseif mode == "Fire" then
			level = 0.75 + 0.25 * math.noise(t * 6, state.seed)
		elseif mode == "Blink" then
			level = if (t + state.seed) % 1.6 < 0.25 then 1 else 0.05
		elseif mode == "Rotate" then
			level = math.max(0, math.sin(t * 6 + state.seed)) ^ 2
		end
		setLevel(state, level)
	end
end

local spins: { [BasePart]: number } = {}

local function fanStep(dt: number)
	for _, fan in CollectionService:GetTagged("Fan") do
		if fan:IsA("BasePart") then
			local running = fan:GetAttribute("Running") == true
			local speed = spins[fan] or 0
			speed += ((if running then 14 else 0) - speed) * math.min(1, dt * 0.8)
			spins[fan] = speed
			if speed > 0.05 then
				fan.CFrame = fan.CFrame * CFrame.Angles(0, speed * dt, 0)
			end
		end
	end
end

local function cameraStep(t: number)
	for _, model in CollectionService:GetTagged("SweepCam") do
		if model:IsA("Model") then
			local state = cameras[model]
			if not state then
				state = { pivot = model:GetPivot(), seed = rng:NextNumber(0, 10) }
				cameras[model] = state
			end
			local angle = math.sin(t * 0.35 + state.seed) * math.rad(32)
			model:PivotTo(state.pivot * CFrame.Angles(0, angle, 0))
		end
	end
end

local function beaconStep(t: number)
	local on = t % 0.8 < 0.35
	for _, device in CollectionService:GetTagged("Device") do
		if
			device:GetAttribute("DeviceType") == "Beacon"
			and device:GetAttribute("Active") == true
		then
			local dome = device:FindFirstChild("Dome")
			if dome and dome:IsA("BasePart") then
				dome.Material = Enum.Material.Neon
				dome.Color = if on
					then Color3.fromRGB(255, 150, 40)
					else Color3.fromRGB(120, 40, 10)
				local strobe = dome:FindFirstChild("Strobe")
				if strobe and strobe:IsA("PointLight") then
					strobe.Brightness = if on then 3 else 0.3
				end
			end
		end
	end
	-- Drone anti-collision strobes: white double flash every 1.4 s; in guide
	-- mode a green pulse in time with the beep, bright enough to follow
	local phase = t % 1.4
	local flash = phase < 0.06 or (phase > 0.16 and phase < 0.22)
	for _, drone in CollectionService:GetTagged("Drone") do
		local strobe = drone:FindFirstChild("Strobe")
		local lightObject = strobe and strobe:FindFirstChild("Flash")
		if strobe and strobe:IsA("BasePart") and lightObject and lightObject:IsA("PointLight") then
			local guiding = drone:GetAttribute("Guiding")
			if typeof(guiding) == "string" and guiding ~= "" then
				local pulse = (t % 0.85) < 0.3
				lightObject.Color = Color3.fromRGB(60, 255, 120)
				lightObject.Range = 20
				lightObject.Brightness = if pulse then 5 else 0.4
				strobe.Color = Color3.fromRGB(60, 255, 120)
			else
				lightObject.Color = Color3.fromRGB(230, 230, 225)
				lightObject.Range = 9
				lightObject.Brightness = if flash then 4 else 0
				strobe.Color = Color3.fromRGB(230, 230, 225)
			end
		end
	end
end

local function steamStep()
	for _, grate in CollectionService:GetTagged("VentSteam") do
		local group = grate:GetAttribute("VentGroup")
		local running = false
		for _, fan in CollectionService:GetTagged("Fan") do
			if fan:GetAttribute("VentGroup") == group and fan:GetAttribute("Running") == true then
				running = true
				break
			end
		end
		local emitter = grate:FindFirstChild("Exhaust")
		if emitter and emitter:IsA("ParticleEmitter") then
			emitter.Rate = if running then 22 else 2
			emitter.Speed = if running then NumberRange.new(12, 18) else NumberRange.new(3, 5)
		end
	end
end

-- Coughing: the server bumps a "Cough" counter on sick people; here each
-- cough is a sharp forward jerk of chest and head (on top of whatever
-- animation is playing), a puff of breath and, if configured, a sound.
local function joint(model: Model, part: string, name: string): Motor6D?
	local holder = model:FindFirstChild(part)
	local motor = holder and holder:FindFirstChild(name)
	return if motor and motor:IsA("Motor6D") then motor else nil
end

local function puff(head: BasePart)
	local emitter = head:FindFirstChild("CoughPuff") :: ParticleEmitter?
	if not emitter then
		local attachment = Instance.new("Attachment")
		attachment.Name = "Mouth"
		attachment.Position = Vector3.new(0, -0.25, -0.6)
		attachment.Parent = head
		local made = Instance.new("ParticleEmitter")
		made.Name = "CoughPuff"
		made.Texture = "rbxasset://textures/particles/smoke_main.dds"
		made.Color = ColorSequence.new(Color3.fromRGB(225, 225, 220))
		made.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82),
			NumberSequenceKeypoint.new(1, 1),
		})
		made.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(1, 0.9),
		})
		made.Lifetime = NumberRange.new(0.5, 0.9)
		made.Speed = NumberRange.new(2, 4)
		made.SpreadAngle = Vector2.new(18, 18)
		made.EmissionDirection = Enum.NormalId.Front
		made.Drag = 4
		made.Rate = 0
		made.LightInfluence = 1
		made.Parent = attachment
		emitter = made
	end
	(emitter :: ParticleEmitter):Emit(5)
end

local restC0: { [Motor6D]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

local function cough(model: Model)
	local waist = joint(model, "UpperTorso", "Waist")
	local neck = joint(model, "Head", "Neck")
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		puff(head)
		local id = Config.COUGH_SOUND
		if id ~= "" then
			local sound = Instance.new("Sound")
			sound.SoundId = id
			sound.Volume = 0.7
			sound.PlaybackSpeed = rng:NextNumber(0.9, 1.1)
			sound.RollOffMinDistance = 4
			sound.RollOffMaxDistance = 45
			sound.Parent = head
			sound:Play()
			sound.Ended:Once(function()
				sound:Destroy()
			end)
		end
	end
	local motors: { { motor: Motor6D, base: CFrame, angle: number } } = {}
	local function add(motor: Motor6D?, angle: number)
		if motor then
			restC0[motor] = restC0[motor] or motor.C0
			table.insert(motors, { motor = motor, base = restC0[motor], angle = angle })
		end
	end
	add(waist, 0.32)
	add(neck, 0.38)
	task.spawn(function()
		-- two quick hacks, then settle
		for _, bout in { 1, 0.7 } do
			for _, entry in motors do
				entry.motor.C0 = entry.base * CFrame.Angles(-entry.angle * bout, 0, 0)
			end
			task.wait(0.09)
			for _, entry in motors do
				entry.motor.C0 = entry.base * CFrame.Angles(-entry.angle * bout * 0.3, 0, 0)
			end
			task.wait(0.14)
		end
		for _, entry in motors do
			entry.motor.C0 = entry.base
		end
	end)
end

local coughHooks: { [Instance]: boolean } = {}
local function hookCough(model: Instance)
	if coughHooks[model] or not model:IsA("Model") then
		return
	end
	coughHooks[model] = true
	model:GetAttributeChangedSignal("Cough"):Connect(function()
		cough(model)
	end)
end

function Ambience.start()
	for _, model in CollectionService:GetTagged("NPC") do
		hookCough(model)
	end
	CollectionService:GetInstanceAddedSignal("NPC"):Connect(hookCough)
	for _, part in CollectionService:GetTagged("Flicker") do
		track(part)
	end
	CollectionService:GetInstanceAddedSignal("Flicker"):Connect(track)

	local slow = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		flickerStep(t)
		fanStep(dt)
		cameraStep(t)
		beaconStep(t)
		slow += dt
		if slow > 0.5 then
			slow = 0
			steamStep()
		end
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sound, using only audio that ships inside Roblox Studio (rbxasset://), so
-- nothing depends on uploaded assets. Every sound is optional: if a file
-- fails to load it simply stays silent.
--   rotors   a looped airflow bed, pitch and volume follow throttle + speed
--   pings    scan ping, action confirmations, warnings
--   ambience wind on the surface, a low room tone underground

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local DroneState = require(script.Parent.Parent.DroneState)
local Net = require(script.Parent.Parent.Net)

local _Config = require(ReplicatedStorage.Shared.Config)

local Audio = {}

local SOUNDS = {
	Rotor = "rbxasset://sounds/action_falling.mp3",
	Ping = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/button.wav",
	Alert = "rbxasset://sounds/clickfast.wav",
}

local function make(name: string, id: string, volume: number, looped: boolean): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Volume = volume
	sound.Looped = looped
	sound.Parent = SoundService
	return sound
end

local rotor: Sound
local ping: Sound
local click: Sound
local alert: Sound

function Audio.init()
	rotor = make("RotorBed", SOUNDS.Rotor, 0, true)
	ping = make("ScanPing", SOUNDS.Ping, 0.35, false)
	click = make("Confirm", SOUNDS.Click, 0.3, false)
	alert = make("Alert", SOUNDS.Alert, 0.3, false)
end

function Audio.start()
	DroneState.Command.connect(function(name: string)
		if name == "Scan" then
			ping:Play()
		elseif name == "CycleCamera" or name == "MenuConfirm" or name == "MenuNav" then
			click:Play()
		end
	end)
	Net.on("Feedback", function(raw: unknown)
		if typeof(raw) == "table" then
			local severity = (raw :: { [string]: unknown }).severity
			if severity == "danger" or severity == "warning" then
				alert:Play()
			else
				click:Play()
			end
		end
	end)
	DroneState.waitForDrone()
	rotor:Play()

	-- Guide beacon: every drone in guide mode beeps from its own hull (3D
	-- sound), so whoever is following can hear where it is
	task.spawn(function()
		while true do
			task.wait(0.85)
			for _, drone in CollectionService:GetTagged("Drone") do
				local guiding = drone:GetAttribute("Guiding")
				local hull = drone:FindFirstChild("Hull")
				if typeof(guiding) == "string" and guiding ~= "" and hull then
					local beep = hull:FindFirstChild("GuideBeep") :: Sound?
					if not beep then
						local sound = Instance.new("Sound")
						sound.Name = "GuideBeep"
						sound.SoundId = SOUNDS.Ping
						sound.Volume = 0.7
						sound.PlaybackSpeed = 1.5
						sound.RollOffMaxDistance = 140
						sound.Parent = hull
						beep = sound
					end
					(beep :: Sound):Play()
				end
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		local active = not DroneState.cinematic
		local throttle = DroneState.throttle
		local targetVolume = if active then 0.12 + throttle * 0.22 else 0
		rotor.Volume += (targetVolume - rotor.Volume) * math.min(1, dt * 3)
		rotor.PlaybackSpeed = 1.5 + throttle * 0.7 + math.min(DroneState.speed, 40) / 80
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Ground-control-station style OSD, modelled on real inspection-drone feeds:
--   top     REC timer + timestamp, compass heading tape, camera/sensor mode
--   centre  reticle, attitude (horizon) bar, proximity sensor arcs, target ID
--   sides   speed tape (left), altitude tape + vertical speed (right)
--   bottom  power (V / A / % / minutes), link (RSSI / latency / quality),
--           positioning (no GNSS underground: VIO + LiDAR SLAM), payloads
--   right   work orders for the site (mapped to the hackathon problems),
--           result cards from the server
-- Control hints switch between Xbox and keyboard labels.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Gas = require(ReplicatedStorage.Shared.Util.Gas)
local Sites = require(ReplicatedStorage.Shared.Util.Sites)
local Units = require(ReplicatedStorage.Shared.Util.Units)
local Types = require(ReplicatedStorage.Shared.Types)
local DroneState = require(script.Parent.Parent.DroneState)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Parent.Ui)
local Pilot = require(script.Parent.Pilot)
local Scanner = require(script.Parent.Scanner)

local player = Players.LocalPlayer
local M = Config.STUDS_TO_METERS

local Hud = {}

local WHITE = Color3.fromRGB(236, 242, 240)
local DIM = Color3.fromRGB(150, 165, 160)
local GREEN = Color3.fromRGB(110, 255, 150)
local AMBER = Color3.fromRGB(255, 196, 70)
local RED = Color3.fromRGB(255, 80, 80)
local CYAN = Color3.fromRGB(110, 225, 255)
local FONT = Enum.Font.RobotoMono
local FONT_BOLD = Enum.Font.GothamBold

local HINTS: { [string]: { pad: string, key: string } } = {
	Primary = { pad = "A", key = "LMB" },
	Secondary = { pad = "B", key = "RMB" },
	Switch = { pad = "X", key = "X" },
	Scan = { pad = "RB", key = "F" },
	Camera = { pad = "LB", key = "C" },
	Menu = { pad = "Y", key = "T" },
	Boost = { pad = "L3 hold", key = "Shift hold" },
	Lights = { pad = "D-Up", key = "L" },
	Log = { pad = "D-Down", key = "J" },
	Help = { pad = "D-Left", key = "H" },
	Sites = { pad = "View", key = "M" },
	Up = { pad = "RT", key = "Space / E" },
	Down = { pad = "LT", key = "Ctrl / Q" },
	Move = { pad = "Left stick", key = "WASD" },
	Look = { pad = "Right stick", key = "Mouse" },
	Recenter = { pad = "R3", key = "V" },
}

local SEVERITY_COLOR: { [string]: Color3 } = {
	info = CYAN,
	warning = AMBER,
	danger = RED,
	success = GREEN,
	data = WHITE,
}

local MODE_NAMES: { [string]: string } = {
	Normal = "EO · 4K · AUTO-EXP",
	Thermal = "IR · IRONBOW · 640",
	Night = "NV · GEN-III · GAIN HI",
	Chem = "CHEM · PID/EC SENSE",
	Lidar = "LIDAR · SLAM MAP",
}

local function hint(name: string): string
	local spec = HINTS[name]
	return if DroneState.gamepad then spec.pad else spec.key
end

local function hex(color: Color3): string
	return ("#%02X%02X%02X"):format(
		math.floor(color.R * 255),
		math.floor(color.G * 255),
		math.floor(color.B * 255)
	)
end

local function colored(text: string, color: Color3): string
	return ('<font color="%s">%s</font>'):format(hex(color), text)
end

local function text(props: { [string]: any }): TextLabel
	local merged: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = WHITE,
		TextSize = 14,
		TextStrokeTransparency = 0.55,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 16),
		RichText = true,
	}
	for key, value in props do
		merged[key] = value
	end
	return Ui.create("TextLabel", merged)
end

local function line(
	parent: Instance,
	position: UDim2,
	size: UDim2,
	color: Color3?,
	transparency: number?
): Frame
	return Ui.create("Frame", {
		BackgroundColor3 = color or WHITE,
		BackgroundTransparency = transparency or 0.15,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = parent,
	})
end

