	for name, spec in arcs do
		proximity[name] = line(centre, spec[1], spec[2], AMBER, 1)
	end

	-- Speed (left) and altitude (right) boxes, like a PFD
	local function tapeBox(anchor: number, x: UDim): TextLabel
