		Parent = opsPanel,
	})

	feedbackStack = Ui.create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, -96),
		Size = UDim2.fromOffset(380, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = safe,
	})
	Ui.create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 6),
		Parent = feedbackStack,
	})

	-- Help card (left, under the header)
	helpPanel = Ui.create("Frame", {
		Position = UDim2.fromOffset(0, 126),
		Size = UDim2.fromOffset(450, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Parent = safe,
	})
	Ui.create("UIPadding", {
		PaddingLeft = UDim.new(0, 15),
		PaddingRight = UDim.new(0, 15),
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		Parent = helpPanel,
	})
	helpText = text({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextSize = 18,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = helpPanel,
	})
end

---------------------------------------------------------------------------
-- Feedback cards
---------------------------------------------------------------------------

local function parseFeedback(raw: unknown): Types.Feedback?
	if typeof(raw) ~= "table" then
		return nil
	end
	local t = raw :: { [string]: unknown }
	if
		typeof(t.title) ~= "string"
		or typeof(t.text) ~= "string"
		or typeof(t.severity) ~= "string"
	then
		return nil
	end
	return { title = t.title, text = t.text, severity = t.severity :: Types.Severity }
end

local function showFeedback(feedback: Types.Feedback)
	local color = SEVERITY_COLOR[feedback.severity] or CYAN
	feedbackOrder += 1
	local card = Ui.create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		LayoutOrder = feedbackOrder,
		Parent = feedbackStack,
	})
	Ui.create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BorderSizePixel = 0,
		BackgroundColor3 = color,
		Parent = card,
	})
	local body = Ui.create("Frame", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -20, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	Ui.create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		Parent = body,
	})
	Ui.create(
		"UIListLayout",
		{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = body }
	)
	text({
		Text = feedback.title,
		TextColor3 = color,
		Font = FONT_BOLD,
		TextSize = 13,
		RichText = false,
		LayoutOrder = 1,
		Parent = body,
	})
	text({
		Text = feedback.text,
		TextSize = 13,
		RichText = false,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Parent = body,
	})
	local cards: { Frame } = {}
	for _, child in feedbackStack:GetChildren() do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	table.sort(cards, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #cards > 3 do
		local oldest = table.remove(cards, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	local lifetime = if feedback.severity == "data" or feedback.severity == "danger" then 12 else 7
	task.delay(lifetime, function()
		card:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Refresh
---------------------------------------------------------------------------

local function actionText(hardpoint: string, deviceType: string?): string
	local drone = DroneState.drone
	if not drone then
		return ""
	end
	local module = DroneState.module(hardpoint)
	local _, primary = Devices.resolve(module, "Primary", deviceType, drone)
	local _, secondary = Devices.resolve(module, "Secondary", deviceType, drone)
	local parts = {}
	if primary then
		table.insert(parts, ("[%s] %s"):format(hint("Primary"), primary))
	end
	if secondary then
		table.insert(parts, ("[%s] %s"):format(hint("Secondary"), secondary))
	end
	return table.concat(parts, "    ")
end

local function refreshTarget()
	local target = DroneState.target
	local deviceType = Devices.typeOf(target)
	local spec = if deviceType then Config.DEVICES[deviceType] else nil
	local reticleColor = WHITE
	if target and spec then
		local categoryColor = Config.CATEGORY_COLORS[spec.category] or CYAN
		reticleColor = if DroneState.targetInRange then GREEN else categoryColor
		targetPanel.Visible = true
		local bar = targetPanel:FindFirstChild("Bar")
		if bar and bar:IsA("Frame") then
			bar.BackgroundColor3 = categoryColor
		end
		targetLines[1].Text = colored(
			("%s  %s"):format(tostring(target:GetAttribute("DeviceId")), spec.label),
			categoryColor
		) .. colored(("   %.1fm"):format(DroneState.targetDistance * M), DIM)
		targetLines[2].Text = tostring(target:GetAttribute("Label") or target.Name)
		local status = target:GetAttribute("Status")
		targetLines[3].Text = colored(tostring(status or ""), DIM)
		targetLines[3].Visible = status ~= nil
		local temperature = target:GetAttribute("Temperature")
		local showTemp = typeof(temperature) == "number" and DroneState.cameraMode == "Thermal"
		targetLines[4].Text = if showTemp
			then colored("SURFACE " .. Units.temp(temperature :: number), AMBER)
			else ""
		targetLines[4].Visible = showTemp
		if DroneState.targetInRange then
			local prompt = actionText(DroneState.activeHardpoint, deviceType)
			targetLines[5].Text = if prompt ~= ""
				then colored(prompt, GREEN)
				else colored(
					("No %s action. [%s] other hardpoint"):format(
						DroneState.module() or "?",
						hint("Switch")
					),
					DIM
				)
		else
			targetLines[5].Text = colored(
				("Close to %.1fm to interact"):format(Config.DRONE.INTERACT_RANGE * M),
				AMBER
			)
		end
		actionLabel.Text = ""
	else
		targetPanel.Visible = false
		local prompt = actionText(DroneState.activeHardpoint, nil)
		actionLabel.Text = if prompt ~= "" then prompt else ""
	end
	for _, piece in reticle do
		piece.BackgroundColor3 = reticleColor
	end
end

local function refreshTape()
	local heading = Pilot.heading()
	local width = 460
	local pixelsPerDegree = 4
	local index = 1
	local first = math.floor((heading - 55) / 5) * 5
	for degree = first, first + 120, 5 do
		local mark = tapeMarks[index]
		if not mark then
			break
		end
		index += 1
		local offset = (degree - heading) * pixelsPerDegree + width / 2
		local normalized = degree % 360
		local label = ""
		if normalized % 90 == 0 then
			label = ({ [0] = "N", [90] = "E", [180] = "S", [270] = "W" })[normalized]
		elseif normalized % 30 == 0 then
			label = tostring(normalized // 10)
		elseif normalized % 10 == 0 then
			label = "|"
		else
			label = "·"
		end
		mark.Text = label
		mark.Position = UDim2.fromOffset(offset, 2)
		mark.TextColor3 = if normalized % 90 == 0 then AMBER else WHITE
		mark.Visible = offset > 10 and offset < width - 10
	end
	for i = index, #tapeMarks do
		tapeMarks[i].Visible = false
	end
	headingLabel.Text = ("%03d°"):format(math.floor(heading + 0.5) % 360)
end

local drainEstimate = 0.2
local lastBattery = 100

local function refreshTelemetry(dt: number)
	local hull = DroneState.hull
	if not hull then
		return
	end
	local site = Config.SITES[DroneState.site] or Config.SITES[Config.DEFAULT_SITE]
	local localPos = hull.Position - site.origin

	-- Header
	local elapsed = os.clock() - startedAt
	local blink = elapsed % 1 < 0.6
	recLabel.Text = colored(if blink then "● REC" else "○ REC", RED)
		.. ("  %02d:%02d:%02d"):format(elapsed // 3600, (elapsed // 60) % 60, elapsed % 60)
	local now = os.date("!*t")
	clockLabel.Text = ("2087-11-20  %02d:%02d:%02d  ·  UNIT HD-%04d"):format(
		now.hour,
		now.min,
		now.sec,
		player.UserId % 10000
	)
	siteLabel.Text = site.name
	local modeName = MODE_NAMES[DroneState.cameraMode] or DroneState.cameraMode
	if DroneState.cameraMode == "Lidar" then
		modeName ..= ("  ·  %d pts"):format(DroneState.lidarPoints)
	end
	modeLabel.Text = modeName .. (if DroneState.headlights then "  ·  LIGHT ON" else "")

	refreshTape()

	-- Attitude bar: the airframe's roll and pitch (camera stays level)
	horizon.Rotation = Pilot.roll()
	horizon.Position = UDim2.new(0.5, 0, 0.5, math.clamp(DroneState.tilt, -30, 30) * 0.6)

	-- Speeds and heights
	speedBox.Text = ("%.1f"):format(DroneState.groundSpeed * M)
	altBox.Text = ("%+.1f"):format((localPos.Y - site.datum) * M)
	local vs = DroneState.verticalSpeed * M
	vsLabel.Text = ("VS %s%.1f m/s"):format(if vs >= 0 then "▲" else "▼", math.abs(vs))
	aglLabel.Text = ("AGL %.1f m"):format(math.min(DroneState.agl, 99) * M)

	-- Power
	local battery = DroneState.battery
	local delta = (lastBattery - battery) / math.max(dt, 1e-3)
	lastBattery = battery
	if not DroneState.docked and delta > 0 then
		drainEstimate += (delta - drainEstimate) * math.min(1, dt * 0.5)
	end
	local minutes = battery / math.max(drainEstimate, 0.05) / 60
	local batteryColor = if battery > 40 then GREEN elseif battery > 20 then AMBER else RED
	powerLabel.Text = colored(("BAT %3d%%"):format(math.floor(battery)), batteryColor)
		.. ("  %.1fV  %2dA  ~%d min"):format(
			DroneState.voltage,
			math.floor(DroneState.current),
			math.floor(minutes)
		)
		.. (if DroneState.docked then colored("  ⚡ DOCK CHARGING", GREEN) else "")

	-- Link
	local link = DroneState.link
	local rssi = -48 - (1 - link) * 46
	local latency = 22 + (1 - link) * 160 + math.noise(elapsed * 2) * 6
	local linkColor = if link >= Config.LINK.WEAK
		then GREEN
		elseif link >= Config.LINK.LOST then AMBER
		else RED
	linkLabel.Text = colored(("LINK %3d%%"):format(math.floor(link * 100)), linkColor)
		.. ("  %d dBm  %d ms  MESH 2.4/5.8"):format(
			math.floor(rssi),
			math.floor(math.max(15, latency))
		)

	-- Navigation (no satellites underground)
	navLabel.Text = ("POS VIO+LIDAR SLAM · GNSS NONE   X%+.1f Y%+.1f Z%+.1f m"):format(
		localPos.X * M,
		localPos.Y * M,
		localPos.Z * M
	)

	-- Gas sensor (Sensor pod only)
	if DroneState.hasModule("Sensor") then
		local readings = Gas.at(hull.Position, Gas.gather())
		local parts = {}
		for _, gas in { "H2S", "CH4", "Spores", "CO2" } do
			local value = readings[gas]
			if value and value >= 1 then
				local gasSpec = Config.GASES[gas]
				local harmful = value >= gasSpec.danger
				table.insert(
					parts,
					colored(
						("%s %d %s"):format(gasSpec.label, math.floor(value), gasSpec.unit),
						if harmful then RED else AMBER
					)
				)
			end
		end
		gasLabel.Text = "GAS  "
			.. (if #parts > 0 then table.concat(parts, "   ") else colored("clear", GREEN))
	else
		gasLabel.Text = ""
	end

	-- Proximity arcs
	local o = DroneState.obstacles
	for name, frame in proximity do
		local distance = (o :: any)[name] :: number
		if distance < 6 then
			frame.BackgroundTransparency = 0.1 + distance / 8
			frame.BackgroundColor3 = if distance < 2 then RED else AMBER
		else
			frame.BackgroundTransparency = 1
		end
	end

	-- Warnings (one line, most important first)
	local warning = ""
	if battery <= 0 then
		warning = colored("BATTERY DEPLETED · LIMP MODE · RETURN TO DOCK", RED)
	elseif battery < 20 then
		warning = colored(
			("LOW BATTERY %d%% · RETURN TO A DOCK"):format(math.floor(battery)),
			if blink then RED else AMBER
		)
	elseif DroneState.avoiding then
		warning = colored("OBSTACLE · AUTO-BRAKE", AMBER)
	elseif DroneState.wind.Magnitude > 6 then
		warning = colored(
			("WIND %.1f m/s · HOLDING POSITION"):format(DroneState.wind.Magnitude * M),
			AMBER
		)
	end
	warnLabel.Text = warning
end

local function refreshHardpoints()
	local drone = DroneState.drone
	if not drone then
		return
	end
	local lines = {}
	for _, hardpoint in { "A", "B" } do
		local module = DroneState.module(hardpoint)
		local spec = if module then Config.MODULES[module] else nil
		local active = DroneState.activeHardpoint == hardpoint
		local label = if spec then spec.label else "EMPTY"
		local color = if spec then spec.color else DIM
		table.insert(
			lines,
			(if active then "▶ " else "  ")
				.. colored(("HP-%s %s"):format(hardpoint, label), if active then color else DIM)
		)
	end
	hardpointLabel.Text = table.concat(lines, "\n")

	local cargo = {}
	local relays = drone:GetAttribute("Relays")
	if DroneState.hasModule("DataJack") then
		table.insert(cargo, ("RELAYS %d"):format(if typeof(relays) == "number" then relays else 0))
	end
	local packet = drone:GetAttribute("Packet")
	if typeof(packet) == "string" and packet ~= "" then
		table.insert(cargo, colored("DATA " .. packet, CYAN))
	end
	if drone:GetAttribute("Payload") == true then
		table.insert(cargo, colored("MED KIT LOADED", GREEN))
	end
	if drone:GetAttribute("Holding") == true then
		table.insert(cargo, colored("GRIPPING", AMBER))
	end
	local guiding = drone:GetAttribute("Guiding")
	if typeof(guiding) == "string" and guiding ~= "" then
		local follower: Model? = nil
		for _, model in CollectionService:GetTagged("Walker") do
			if model:IsA("Model") and model:GetAttribute("FollowerOf") == player.UserId then
				follower = model
			end
		end
		local hull = DroneState.hull
		if follower and hull then
			local distance = (follower:GetPivot().Position - hull.Position).Magnitude * M
			local first = string.split(guiding, ",")[1]
			local close = distance <= Config.DRONE.GUIDE_RANGE * M
			table.insert(
				cargo,
				colored(
					("♪ GUIDING %s %.0fm"):format(string.upper(first), distance),
					if close then GREEN else RED
				)
			)
		end
	end
	local cooldown = Scanner.cooldown()
	table.insert(
		cargo,
		if cooldown > 0 then ("SCAN %.1fs"):format(cooldown) else ("SCAN [%s]"):format(hint("Scan"))
	)
	payloadLabel.Text = table.concat(cargo, "   ")
end

local function refreshOps()
	opsPanel.Visible = DroneState.logOpen
	if not DroneState.logOpen then
		return
	end
	local mission = game:GetService("ReplicatedStorage"):FindFirstChild("Mission")
	local site = DroneState.site
	local out = {
		colored(
			"WORK ORDERS · " .. (Config.SITES[site] and Config.SITES[site].name or site),
			WHITE
		),
	}
	for _, group in Sites.groups(site) do
		local done = true
		local rows = {}
		for _, item in group.items do
			local value = if mission then mission:GetAttribute(item.key) else 0
			local count = if typeof(value) == "number" then value else 0
			local complete = count >= item.total
			done = done and complete
			table.insert(
				rows,
				("  %s %s %s"):format(
					if complete then colored("■", GREEN) else colored("□", DIM),
					if complete then colored(item.label, DIM) else item.label,
					colored(
						("%d/%d"):format(math.min(count, item.total), item.total),
						if complete then GREEN else AMBER
					)
				)
			)
		end
		local problems = {}
		for _, number in group.problems do
			table.insert(problems, "#" .. number)
		end
		table.insert(out, "")
		table.insert(
			out,
			colored(group.zone, if done then GREEN else CYAN)
				.. colored("  " .. table.concat(problems, " "), DIM)
		)
		if not done then
			table.insert(out, colored("  " .. group.brief, DIM))
		end
		for _, row in rows do
			table.insert(out, row)
		end
	end
	table.insert(out, "")
	table.insert(
		out,
		colored(
			("[%s] hide   [%s] sites   #n = hackathon problem"):format(hint("Log"), hint("Sites")),
			DIM
		)
	)
	opsText.Text = table.concat(out, "\n")
end

local function refreshHelp()
	helpPanel.Visible = DroneState.helpOpen
	if not DroneState.helpOpen then
		return
	end
	local rows = {
		{ "Move", "Fly (horizontal)" },
		{ "Up", "Climb" },
		{ "Down", "Descend" },
		{ "Look", "Gimbal / heading" },
		{ "Recenter", "Level the gimbal" },
		{ "Boost", "Sport mode" },
		{ "Primary", "Module action" },
		{ "Secondary", "Alt action" },
		{ "Switch", "Swap hardpoint" },
		{ "Scan", "Device scan ping" },
		{ "Camera", "EO / IR / NV / CHEM / LIDAR" },
		{ "Lights", "Headlight" },
		{ "Menu", "Loadout (at a dock)" },
		{ "Sites", "Site / recall menu" },
		{ "Log", "Work orders" },
		{ "Help", "Hide this" },
	}
	local out = {
		colored(
			"CONTROLS · " .. (if DroneState.gamepad then "XBOX" else "KEYBOARD + MOUSE"),
			WHITE
		),
	}
	for _, row in rows do
		table.insert(out, colored(("%-12s"):format(hint(row[1])), AMBER) .. row[2])
	end
	helpText.Text = table.concat(out, "\n")
end

function Hud.init()
	build()
end

function Hud.start()
	Net.on("Feedback", function(raw: unknown)
		local feedback = parseFeedback(raw)
		if feedback then
			showFeedback(feedback)
		end
	end)
	DroneState.waitForDrone()

	local slow = 0
	RunService.RenderStepped:Connect(function(dt: number)
		gui.Enabled = not DroneState.cinematic
		if DroneState.cinematic then
			return
		end
		refreshTarget()
		refreshTelemetry(dt)
		slow += dt
		if slow > 0.25 then
			slow = 0
			refreshHardpoints()
			refreshOps()
			refreshHelp()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Loadout</string>
              <string name="Source"><![CDATA[--!strict
-- DRONE SYSTEMS menu: swap modules on hardpoints A/B (only when docked),
-- or recall the drone to the bay from anywhere. Fully gamepad navigable.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DroneState = require(script.Parent.Parent.DroneState)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Parent.Ui)

local player = Players.LocalPlayer
local theme = Ui.theme

local Loadout = {}

local FOCUS = { "A", "B", "Apply", "Recall" }

local window: Frame
local statusLabel: TextLabel
local hintLabel: TextLabel
local rows: { [string]: { frame: Frame, name: TextLabel, description: TextLabel } } = {}
local buttons: { [string]: TextButton } = {}
local focus = 1
local selection: { [string]: string } = { A = "Sensor", B = "Arm" }

local function focusStroke(instance: GuiObject): UIStroke
	local stroke = instance:FindFirstChildOfClass("UIStroke")
	if not stroke then
		stroke = Ui.create("UIStroke", { Thickness = 2, Color = theme.amber, Parent = instance })
	end
	return stroke :: UIStroke
end

local function refresh()
	statusLabel.Text = if DroneState.docked
		then '<font color="#5AFF96">DOCKED</font>  module swap + charging available'
		else '<font color="#FFBE3C">NOT DOCKED</font>  fly onto a dock pad to swap modules'
	for _, hardpoint in { "A", "B" } do
		local spec = Config.MODULES[selection[hardpoint]]
		local row = rows[hardpoint]
		row.name.Text = ("<b>%s</b>"):format(spec.label)
		row.name.TextColor3 = spec.color
		row.description.Text = spec.description
	end
	for index, name in FOCUS do
		local target: GuiObject = if rows[name] then rows[name].frame else buttons[name]
		local stroke = focusStroke(target)
		stroke.Transparency = if index == focus then 0 else 1
	end
	buttons.Apply.BackgroundColor3 = if DroneState.docked
		then theme.amber
		else Color3.fromRGB(70, 70, 70)
	hintLabel.Text = if DroneState.gamepad
		then "D-Pad: select / change   A: confirm   B or Y: close"
		else "Click arrows or use arrow keys   Enter: confirm   T: close"
end

local function cycleModule(hardpoint: string, direction: number)
	local other = if hardpoint == "A" then "B" else "A"
	local order = Config.MODULE_ORDER
	local index = table.find(order, selection[hardpoint]) or 1
	for _ = 1, #order do
		index = (index - 1 + direction) % #order + 1
		if order[index] ~= selection[other] then
			selection[hardpoint] = order[index]
			break
		end
	end
	refresh()
end

local function close()
	window.Visible = false
	DroneState.set("menuOpen", false)
end

local function open()
	selection.A = DroneState.module("A") or Config.DEFAULT_LOADOUT.A
	selection.B = DroneState.module("B") or Config.DEFAULT_LOADOUT.B
	focus = 1
	window.Visible = true
	DroneState.set("menuOpen", true)
	refresh()
end

local function applyLoadout()
	if selection.A == selection.B then
		return
	end
	Net.fire("SetLoadout", { A = selection.A, B = selection.B })
	close()
end

local function recall()
	Net.fire("Recall")
	close()
end

local function button(
	name: string,
	text: string,
	color: Color3,
	parent: Instance,
	onClick: () -> ()
): TextButton
	local b = Ui.create("TextButton", {
		Text = text,
		Font = theme.fontBold,
		TextSize = 15,
		TextColor3 = Color3.fromRGB(10, 14, 18),
		BackgroundColor3 = color,
		Size = UDim2.new(1 / 3, -6, 1, 0),
		Parent = parent,
	})
	Ui.create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = b })
	b.Activated:Connect(onClick)
	buttons[name] = b
	return b
end

local function build()
	local screen = Ui.create("ScreenGui", {
		Name = "DroneSystems",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		Parent = player:WaitForChild("PlayerGui"),
	})
	window = Ui.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.08,
		Visible = false,
		Parent = screen,
	})
	Ui.create(
		"UIListLayout",
		{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = window }
	)
	Ui.label({
		Text = "DRONE SYSTEMS // HARDPOINTS",
		Font = theme.fontBold,
		TextSize = 20,
		TextColor3 = theme.cyan,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 0,
		Parent = window,
	})
	statusLabel = Ui.label({ TextSize = 14, LayoutOrder = 1, Parent = window })

	for index, hardpoint in { "A", "B" } do
		local frame = Ui.create("Frame", {
			BackgroundColor3 = Color3.fromRGB(10, 20, 26),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 58),
			LayoutOrder = 1 + index,
			Parent = window,
		})
		Ui.label({
			Text = "HARDPOINT " .. hardpoint .. (if hardpoint == "A"
				then "  (left)"
				else "  (right)"),
			TextColor3 = theme.dim,
			TextSize = 12,
			Position = UDim2.fromOffset(46, 4),
			Parent = frame,
		})
		local name = Ui.label({
			TextSize = 17,
			Position = UDim2.fromOffset(46, 18),
			Size = UDim2.new(1, -92, 0, 20),
			Parent = frame,
		})
		local description = Ui.label({
			TextSize = 12,
			TextColor3 = theme.text,
			Position = UDim2.fromOffset(46, 38),
			Size = UDim2.new(1, -92, 0, 16),
			Parent = frame,
		})
		for _, arrow in
			{ { text = "<", x = 6, direction = -1 }, { text = ">", x = -38, direction = 1 } }
		do
			local arrowButton = Ui.create("TextButton", {
				Text = arrow.text,
				Font = theme.fontBold,
				TextSize = 20,
				TextColor3 = theme.cyan,
				BackgroundColor3 = Color3.fromRGB(20, 40, 50),
				Position = if arrow.x < 0
					then UDim2.new(1, arrow.x, 0.5, -16)
					else UDim2.new(0, arrow.x, 0.5, -16),
				Size = UDim2.fromOffset(32, 32),
				Parent = frame,
			})
			arrowButton.Activated:Connect(function()
				focus = index
				cycleModule(hardpoint, arrow.direction)
			end)
		end
		rows[hardpoint] = { frame = frame, name = name, description = description }
	end

	local actions = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = 10,
		Parent = window,
	})
	Ui.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 9),
		Parent = actions,
	})
	button("Apply", "APPLY LOADOUT", theme.amber, actions, applyLoadout)
	button("Recall", "RECALL TO BAY", theme.cyan, actions, recall)
	button("Close", "CLOSE", Color3.fromRGB(120, 130, 140), actions, close)

	hintLabel =
		Ui.label({ TextSize = 12, TextColor3 = theme.dim, LayoutOrder = 11, Parent = window })
end

function Loadout.init()
	build()
end

function Loadout.start()
	DroneState.Command.connect(function(name: string, direction: string?)
		if name == "ToggleMenu" then
			if DroneState.siteMenuOpen or DroneState.cinematic then
				return
			end
			if window.Visible then
				close()
			else
				open()
			end
		elseif not window.Visible then
			return
		elseif name == "MenuBack" then
			close()
		elseif name == "MenuNav" then
			if direction == "Up" then
				focus = math.max(1, focus - 1)
			elseif direction == "Down" then
				focus = math.min(#FOCUS, focus + 1)
			elseif direction == "Left" or direction == "Right" then
				local field = FOCUS[focus]
				if field == "A" or field == "B" then
					cycleModule(field, if direction == "Left" then -1 else 1)
				elseif field == "Apply" or field == "Recall" then
					focus = if field == "Apply" then 4 else 3
				end
			end
			refresh()
		elseif name == "MenuConfirm" then
			local field = FOCUS[focus]
			if field == "Apply" then
				applyLoadout()
			elseif field == "Recall" then
				recall()
			else
				focus += 1
				refresh()
			end
		end
	end)
	DroneState.Changed.connect(function(key: string)
		if window.Visible and (key == "docked" or key == "gamepad") then
			refresh()
		end
	end)
end

return Loadout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Pilot</string>
              <string name="Source"><![CDATA[--!strict
-- Flight, camera, targeting and input.
--
-- Physics: the drone hull is owned by this client. We steer it with two
-- constraints the server created: LinearVelocity ("Thrust") for 6DOF
-- translation and AlignOrientation ("Gyro") for attitude.
--
-- Flight model (an inspection quad, not an arcade ship):
--   * the sticks command a velocity; the motors can only deliver MAX_ACCEL,
--     so the airframe has inertia, overshoot and a braking distance
--   * attitude follows ACCELERATION (a real quad tilts to accelerate)
--   * wind fields from running fans, the lift-shaft draft and surface gusts
--   * turbulence + propwash near walls, ground effect near the floor
--   * six proximity sensors, with gentle obstacle braking (like APAS)
--   * a 6S battery: voltage sags under load, current scales with thrust
-- Camera: first-person through the nose lens on a 3-axis gimbal that holds
-- the horizon, with a little motor vibration and turbulence bleed-through.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Link = require(ReplicatedStorage.Shared.Util.Link)
local Sites = require(ReplicatedStorage.Shared.Util.Sites)
local DroneState = require(script.Parent.Parent.DroneState)
local Net = require(script.Parent.Parent.Net)

local DRONE = Config.DRONE

local Pilot = {}

local yaw = 0
local pitch = 0
local roll = 0
local velocity = Vector3.zero
local acceleration = Vector3.zero
local fov = DRONE.FOV
local clock = 0
local gimbal = CFrame.identity

type Axes = { lx: number, ly: number, rx: number, ry: number, lt: number, rt: number }
local axes: Axes = { lx = 0, ly = 0, rx = 0, ry = 0, lt = 0, rt = 0 }

-- Rotor animation: base C0 per weld
local rotorBase: { [Weld]: CFrame } = {}
local rotorAngle = 0

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

---------------------------------------------------------------------------
-- Input
---------------------------------------------------------------------------

local function deadzone(x: number, y: number): (number, number)
	local magnitude = math.sqrt(x * x + y * y)
	if magnitude < 0.15 then
		return 0, 0
	end
	local scale = math.min(1, (magnitude - 0.15) / 0.85) / magnitude
	return x * scale, y * scale
end

local function readGamepad()
	axes.lx, axes.ly, axes.rx, axes.ry, axes.lt, axes.rt = 0, 0, 0, 0, 0, 0
	if not UserInputService:GetGamepadConnected(Enum.UserInputType.Gamepad1) then
		return
	end
	for _, input in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		local code = input.KeyCode
		if code == Enum.KeyCode.Thumbstick1 then
			axes.lx, axes.ly = deadzone(input.Position.X, input.Position.Y)
		elseif code == Enum.KeyCode.Thumbstick2 then
			axes.rx, axes.ry = deadzone(input.Position.X, input.Position.Y)
		elseif code == Enum.KeyCode.ButtonL2 then
			axes.lt = input.Position.Z
		elseif code == Enum.KeyCode.ButtonR2 then
			axes.rt = input.Position.Z
		end
	end
end

local function down(code: Enum.KeyCode): boolean
	return UserInputService:IsKeyDown(code)
end

-- Returns the requested local-space move (x = strafe, z = forward is -Z) and vertical (-1..1).
local function blocked(): boolean
	return DroneState.menuOpen or DroneState.siteMenuOpen or DroneState.cinematic
end

local function flightInput(): (Vector3, number)
	if blocked() then
		return Vector3.zero, 0
	end
	local strafe, forward, vertical = axes.lx, axes.ly, axes.rt - axes.lt
	if down(Enum.KeyCode.W) then
		forward += 1
	end
	if down(Enum.KeyCode.S) then
		forward -= 1
	end
	if down(Enum.KeyCode.D) then
		strafe += 1
	end
	if down(Enum.KeyCode.A) then
		strafe -= 1
	end
	if down(Enum.KeyCode.Space) or down(Enum.KeyCode.E) then
		vertical += 1
	end
	if down(Enum.KeyCode.LeftControl) or down(Enum.KeyCode.Q) then
		vertical -= 1
	end
	local move = Vector3.new(math.clamp(strafe, -1, 1), 0, -math.clamp(forward, -1, 1))
	if move.Magnitude > 1 then
		move = move.Unit
	end
	return move, math.clamp(vertical, -1, 1)
end

local function look(dt: number)
	if blocked() then
		return
	end
	local dx = -axes.rx * DRONE.LOOK_SPEED_GAMEPAD * dt
	local dy = axes.ry * DRONE.LOOK_SPEED_GAMEPAD * 0.8 * dt
	local mouse = UserInputService:GetMouseDelta()
	dx -= mouse.X * DRONE.MOUSE_SENSITIVITY
	dy -= mouse.Y * DRONE.MOUSE_SENSITIVITY
	yaw = (yaw + dx) % (math.pi * 2)
	pitch = math.clamp(pitch + dy, -DRONE.MAX_PITCH, DRONE.MAX_PITCH)
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

local function act(kind: string)
	if blocked() or not DroneState.drone then
		return
	end
	local target = if DroneState.targetInRange then DroneState.target else nil
	Net.fire("DroneAction", kind, DroneState.activeHardpoint, target)
end

local function onBegin(callback: () -> ())
	return function(
		_: string,
		state: Enum.UserInputState,
		_input: InputObject
	): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			callback()
		end
		return Enum.ContextActionResult.Sink
	end
end

local function command(name: string, ...: any)
	DroneState.Command.fire(name, ...)
end

local function menuOr(direction: string, otherwise: () -> ())
	return function()
		if DroneState.menuOpen or DroneState.siteMenuOpen then
			command("MenuNav", direction)
		else
			otherwise()
		end
	end
end

local function bindInputs()
	local bind = function(name: string, callback: () -> (), ...: any)
		ContextActionService:BindAction(name, onBegin(callback), false, ...)
	end

	bind("DronePrimary", function()
		if DroneState.menuOpen or DroneState.siteMenuOpen then
			command("MenuConfirm")
		else
			act("Primary")
		end
	end, Enum.KeyCode.ButtonA, Enum.UserInputType.MouseButton1, Enum.KeyCode.R)

	bind("DroneSecondary", function()
		if DroneState.menuOpen or DroneState.siteMenuOpen then
			command("MenuBack")
		else
			act("Secondary")
		end
	end, Enum.KeyCode.ButtonB, Enum.UserInputType.MouseButton2, Enum.KeyCode.G)

	bind("DroneSwitch", function()
		if not DroneState.menuOpen then
			DroneState.set(
				"activeHardpoint",
				if DroneState.activeHardpoint == "A" then "B" else "A"
			)
		end
	end, Enum.KeyCode.ButtonX, Enum.KeyCode.X, Enum.KeyCode.Tab)

	bind("DroneScan", function()
		command("Scan")
	end, Enum.KeyCode.ButtonR1, Enum.KeyCode.F)

	bind("DroneCamera", function()
		command("CycleCamera")
	end, Enum.KeyCode.ButtonL1, Enum.KeyCode.C)

	bind("DroneMenu", function()
		command("ToggleMenu")
	end, Enum.KeyCode.ButtonY, Enum.KeyCode.T)

	bind(
		"DroneLights",
		menuOr("Up", function()
			DroneState.set("headlights", not DroneState.headlights)
		end),
		Enum.KeyCode.DPadUp,
		Enum.KeyCode.L
	)

	bind(
		"DroneLog",
		menuOr("Down", function()
			DroneState.set("logOpen", not DroneState.logOpen)
		end),
		Enum.KeyCode.DPadDown,
		Enum.KeyCode.J
	)

	bind(
		"DroneHelp",
		menuOr("Left", function()
			DroneState.set("helpOpen", not DroneState.helpOpen)
		end),
		Enum.KeyCode.DPadLeft,
		Enum.KeyCode.H
	)

	bind("DroneRight", menuOr("Right", function() end), Enum.KeyCode.DPadRight)

	bind("DroneRecenter", function()
		pitch = 0
	end, Enum.KeyCode.ButtonR3, Enum.KeyCode.V)

	bind("DroneSites", function()
		command("ToggleSites")
	end, Enum.KeyCode.ButtonSelect, Enum.KeyCode.M)

	-- Keyboard menu navigation
	for code, direction in
		{
			[Enum.KeyCode.Up] = "Up",
			[Enum.KeyCode.Down] = "Down",
			[Enum.KeyCode.Left] = "Left",
			[Enum.KeyCode.Right] = "Right",
		}
	do
		bind("MenuArrow" .. direction, function()
			if DroneState.menuOpen or DroneState.siteMenuOpen then
				command("MenuNav", direction)
			end
		end, code)
	end
	bind("MenuEnter", function()
		if DroneState.menuOpen or DroneState.siteMenuOpen then
			command("MenuConfirm")
		end
	end, Enum.KeyCode.Return)

	-- Boost is held, not toggled
	ContextActionService:BindAction(
		"DroneBoost",
		function(_: string, state: Enum.UserInputState, _input: InputObject)
			DroneState.set(
				"boosting",
				state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
			)
			return Enum.ContextActionResult.Sink
		end,
		false,
		Enum.KeyCode.ButtonL3,
		Enum.KeyCode.LeftShift
	)

	UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
		local isPad = inputType.Name:sub(1, 7) == "Gamepad"
		local isKeyboard = inputType == Enum.UserInputType.Keyboard
			or inputType == Enum.UserInputType.MouseMovement
			or inputType == Enum.UserInputType.MouseButton1
		if isPad then
			DroneState.set("gamepad", true)
		elseif isKeyboard then
			DroneState.set("gamepad", false)
		end
	end)
	DroneState.set("gamepad", UserInputService:GetGamepadConnected(Enum.UserInputType.Gamepad1))
end

---------------------------------------------------------------------------
-- Sensing
---------------------------------------------------------------------------

local function updateTarget(hull: BasePart, camera: Camera)
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 60
	local exclude: { Instance } = { Workspace:FindFirstChild("Drones") or hull }
	for _ = 1, 4 do
		raycastParams.FilterDescendantsInstances = exclude
		local hit = Workspace:Raycast(origin, direction, raycastParams)
		if not hit then
			break
		end
		if hit.Instance:GetAttribute("Carried") == true then
			table.insert(exclude, hit.Instance)
		else
			local root = Devices.root(hit.Instance)
			if root then
				local distance = (Devices.position(root) - hull.Position).Magnitude
				DroneState.target = root
				DroneState.targetDistance = distance
				DroneState.targetInRange = distance <= DRONE.INTERACT_RANGE + Devices.extent(root)
				return
			end
			break
		end
	end
	DroneState.target = nil
	DroneState.targetDistance = math.huge
	DroneState.targetInRange = false
end

local sensorParams = RaycastParams.new()
sensorParams.FilterType = Enum.RaycastFilterType.Exclude
sensorParams.RespectCanCollide = true

-- Six time-of-flight proximity sensors in the heading frame, plus AGL.
local function sense(hull: BasePart)
	local exclude: { Instance } = { Workspace:FindFirstChild("Drones") or hull }
	local held = DroneState.drone and DroneState.drone:GetAttribute("Holding") == true
	if held then
		for _, part in Workspace:GetPartBoundsInRadius(hull.Position, 4) do
			if part:GetAttribute("Carried") == true then
				table.insert(exclude, part)
			end
		end
	end
	sensorParams.FilterDescendantsInstances = exclude
	local heading = CFrame.Angles(0, yaw, 0)
	local range = DRONE.OBSTACLE_RANGE
	local directions: { [string]: Vector3 } = {
		front = heading.LookVector,
		back = -heading.LookVector,
		left = -heading.RightVector,
		right = heading.RightVector,
		up = Vector3.yAxis,
	}
	local obstacles = DroneState.obstacles :: any
	for name, direction in directions do
		local hit = Workspace:Raycast(hull.Position, direction * range, sensorParams)
		obstacles[name] = if hit then math.max(0, hit.Distance - 1.4) else math.huge
	end
	local ground = Workspace:Raycast(hull.Position, Vector3.new(0, -400, 0), sensorParams)
	DroneState.agl = if ground then math.max(0, ground.Distance - 0.6) else 400
	obstacles.down = if ground and ground.Distance < range
		then math.max(0, ground.Distance - 0.6)
		else math.huge
end

-- Wind from running fans (pulled along the fan axis), the lift-shaft draft
-- and surface gusts. Returns studs/s.
local function windAt(position: Vector3, t: number): Vector3
	local wind = Vector3.zero
	for _, fan in CollectionService:GetTagged("Fan") do
		if
			fan:IsA("BasePart")
			and fan:GetAttribute("Running") == true
			and fan:GetAttribute("VentGroup") ~= "Wind"
		then
			local offset = position - fan.Position
			local reach = math.max(fan.Size.X, fan.Size.Z) * 1.6
			if offset.Magnitude < reach then
				local strength = (1 - offset.Magnitude / reach) * 14
				wind += fan.CFrame.UpVector * strength
			end
		end
	end
	local site = Config.SITES.Hollow
	local localPos = position - site.origin
	if
		localPos.Y > 240
		and localPos.Y < 430
		and math.abs(localPos.X) < 14
		and math.abs(localPos.Z) < 14
	then
		-- cool surface air sinking down Shaft Zero
		wind += Vector3.new(0, -2.2, 0) + Vector3.new(
			math.noise(t * 0.3, 1),
			0,
			math.noise(t * 0.3, 2)
		) * 1.5
	elseif localPos.Y >= 430 and position.Z > 1500 then
		local gust = 0.6 + 0.4 * math.noise(t * 0.15, 7)
		wind += Vector3.new(7, 0, 2.5) * gust
	end
	return wind
end

local function slowUpdate(hull: BasePart)
	DroneState.set("link", Link.at(hull.Position))
	DroneState.set("site", Sites.at(hull.Position))
	local docked = false
	for _, dock in CollectionService:GetTagged("Device") do
		if dock:GetAttribute("DeviceType") == "Dock" then
			if (Devices.position(dock) - hull.Position).Magnitude <= DRONE.DOCK_RANGE then
				docked = true
				break
			end
		end
	end
	DroneState.set("docked", docked)
end

local function spinRotors(dt: number, throttle: number)
	rotorAngle += dt * (38 + throttle * 34)
	for _, model in CollectionService:GetTagged("Drone") do
		for _, blade in model:GetChildren() do
			if blade.Name == "Rotor" then
				local weld = blade:FindFirstChild("RotorWeld")
				if weld and weld:IsA("Weld") then
					local base = rotorBase[weld]
					if not base then
						base = weld.C0
						rotorBase[weld] = base
					end
					local spin = blade:GetAttribute("Spin")
					local direction = if typeof(spin) == "number" then spin else 1
					weld.C0 = base * CFrame.Angles(0, rotorAngle * direction, 0)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Flight model
---------------------------------------------------------------------------

-- Limits the commanded velocity toward close obstacles (soft braking).
local function avoid(desired: Vector3): Vector3
	local heading = CFrame.Angles(0, yaw, 0)
	local o = DroneState.obstacles
	local localDesired = heading:VectorToObjectSpace(desired)
	local avoiding = false
	local function limit(component: number, distance: number, positive: boolean): number
		local toward = if positive then component > 0 else component < 0
		if toward and distance < 4 then
			avoiding = true
			local cap = math.max(0, (distance - 0.6) * 2.5)
			return math.clamp(component, -cap, cap)
		end
		return component
	end
	local x = limit(localDesired.X, o.right, true)
	x = limit(x, o.left, false)
	local z = limit(localDesired.Z, o.back, true)
	z = limit(z, o.front, false)
	local y = limit(desired.Y, o.up, true)
	y = limit(y, o.down, false)
	DroneState.avoiding = avoiding
	return heading:VectorToWorldSpace(Vector3.new(x, 0, z)) + Vector3.new(0, y, 0)
end

local function fly(dt: number, hull: BasePart, thrust: LinearVelocity, gyro: AlignOrientation)
	clock += dt
	readGamepad()
	look(dt)

	local move, vertical = flightInput()
	local lowPower = DroneState.battery <= 0
	local boost = DroneState.boosting and not lowPower
	local speed = if lowPower
		then DRONE.LOW_POWER_SPEED
		elseif boost then DRONE.BOOST_SPEED
		else DRONE.SPEED
	-- Voltage sag trims the top speed on a tired pack
	speed *= 0.82 + 0.18 * math.clamp(DroneState.battery / 40, 0, 1)
	local heading = CFrame.Angles(0, yaw, 0)
	local desired = heading:VectorToWorldSpace(move) * speed
		+ Vector3.new(
			0,
			vertical * (if lowPower then DRONE.LOW_POWER_SPEED else DRONE.VERTICAL_SPEED),
			0
		)
	desired = avoid(desired)

	-- Velocity controller with limited authority (inertia + braking distance)
	local sticks = move.Magnitude + math.abs(vertical)
	local gain = if sticks > 0.05 then 3.2 else DRONE.BRAKE
	local wanted = (desired - velocity) * gain
	local maxAccel = DRONE.MAX_ACCEL * (if boost then 1.35 else 1)
	if wanted.Magnitude > maxAccel then
		wanted = wanted.Unit * maxAccel
	end
	acceleration = acceleration:Lerp(wanted, math.min(1, dt * 12))
	velocity += acceleration * dt
	velocity -= velocity * DRONE.DRAG * 0.08 * dt

	-- Disturbances: wind, turbulence, propwash near surfaces, ground effect
	local wind = windAt(hull.Position, clock)
	DroneState.wind = wind
	local o = DroneState.obstacles
	local nearest = math.min(o.front, o.back, o.left, o.right, o.up, DroneState.agl)
	local wash = math.clamp(1 - nearest / 6, 0, 1)
	local t = clock * 1.7
	local turbulence = Vector3.new(
		math.noise(t, 0.1, 3.3),
		math.noise(t, 5.2, 1.1) * 0.6,
		math.noise(t, 9.7, 4.4)
	) * (DRONE.TURBULENCE + wash * DRONE.PROPWASH + wind.Magnitude * 0.12)
	local groundEffect = 0
	if DroneState.agl < DRONE.GROUND_EFFECT_HEIGHT then
		groundEffect = (1 - DroneState.agl / DRONE.GROUND_EFFECT_HEIGHT) * 1.8
	end
	local applied = velocity
		+ wind * DRONE.WIND_RESPONSE
		+ turbulence
		+ Vector3.new(0, groundEffect, 0)
	thrust.VectorVelocity = applied

	-- Attitude from acceleration (plus a share of the wind the motors fight)
	local tiltSource = heading:VectorToObjectSpace(acceleration + wind * 0.8)
	local maxTilt = math.rad(28)
	local tiltPitch = math.clamp(tiltSource.Z / DRONE.MAX_ACCEL, -1, 1) * maxTilt
	roll = -math.clamp(tiltSource.X / DRONE.MAX_ACCEL, -1, 1) * maxTilt
	local wobble = CFrame.Angles(turbulence.Z * 0.012, 0, -turbulence.X * 0.012)
	gyro.CFrame = heading * CFrame.Angles(tiltPitch, 0, roll) * wobble
	DroneState.tilt = math.deg(math.sqrt(tiltPitch * tiltPitch + roll * roll))

	-- Power: hover current + thrust for acceleration and climbing
	local load = math.clamp(
		0.42
			+ acceleration.Magnitude / DRONE.MAX_ACCEL * 0.4
			+ math.max(0, velocity.Y) / DRONE.VERTICAL_SPEED * 0.25
			+ wind.Magnitude * 0.01,
		0,
		1
	)
	DroneState.throttle = load
	DroneState.current = 9 + load * 46
	local visionDrain = if DroneState.cameraMode ~= "Normal" then DRONE.BATTERY_VISION else 0
	local drain = DRONE.BATTERY_IDLE + DRONE.BATTERY_MOVE * (load - 0.42) * 2.4 + visionDrain
	local battery = if DroneState.docked
		then DroneState.battery + DRONE.BATTERY_RECHARGE * dt
		else DroneState.battery - math.max(DRONE.BATTERY_IDLE, drain) * dt
	DroneState.battery = math.clamp(battery, 0, 100)
	local rest = DRONE.CELL_EMPTY
		+ (DRONE.CELL_FULL - DRONE.CELL_EMPTY) * (DroneState.battery / 100) ^ 0.7
	DroneState.voltage = rest - DRONE.SAG * load
	DroneState.speed = hull.AssemblyLinearVelocity.Magnitude
	local planar = hull.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
	DroneState.groundSpeed = planar.Magnitude
	DroneState.verticalSpeed = hull.AssemblyLinearVelocity.Y
	if not DroneState.docked then
		DroneState.flightSeconds += dt
	end

	spinRotors(dt, load)
end

function Pilot.init()
	DroneState.targetInRange = false
end

function Pilot.start()
	local drone = DroneState.waitForDrone()
	local hull = DroneState.hull :: BasePart
	local thrust = hull:WaitForChild("Thrust") :: LinearVelocity
	local gyro = hull:WaitForChild("Gyro") :: AlignOrientation
	local headlight = hull:WaitForChild("Headlight") :: SpotLight
	local camera = Workspace.CurrentCamera

	-- Start looking the way the drone was spawned
	local _, spawnYaw, _ = hull.CFrame:ToEulerAnglesYXZ()
	yaw = spawnYaw

	bindInputs()

	DroneState.Changed.connect(function(key: string)
		if key == "headlights" then
			headlight.Enabled = DroneState.headlights
		end
	end)

	-- Teleports (site change / recall): reset the controller state
	local lastPosition = hull.Position

	RunService:BindToRenderStep(
		"DroneFlight",
		Enum.RenderPriority.Input.Value + 1,
		function(dt: number)
			if not drone.Parent then
				return
			end
			if (hull.Position - lastPosition).Magnitude > 40 then
				velocity = Vector3.zero
				acceleration = Vector3.zero
				local _, newYaw, _ = hull.CFrame:ToEulerAnglesYXZ()
				yaw = newYaw
			end
			lastPosition = hull.Position
			fly(math.min(dt, 0.05), hull, thrust, gyro)
		end
	)

	-- Camera (after Roblox's camera scripts so nothing overrides us)
	RunService:BindToRenderStep(
		"DroneCamera",
		Enum.RenderPriority.Camera.Value + 1,
		function(dt: number)
			if not drone.Parent or DroneState.cinematic then
				return
			end
			camera.CameraType = Enum.CameraType.Scriptable
			local targetFov = if DroneState.boosting then DRONE.FOV + 4 else DRONE.FOV
			fov += (targetFov - fov) * math.min(1, dt * 4)
			camera.FieldOfView = fov

			-- 3-axis gimbal: slews toward the commanded look with a little lag
			local goal = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
			gimbal = gimbal:Lerp(goal, math.min(1, dt * 18))
			local vibration = CFrame.Angles(
				math.noise(clock * 40, 1) * 0.0012 * (0.5 + DroneState.throttle),
				math.noise(clock * 40, 2) * 0.0012 * (0.5 + DroneState.throttle),
				roll * 0.12 + math.noise(clock * 3, 3) * 0.004
			)
			local lens = CFrame.new(hull.Position)
				* CFrame.Angles(0, yaw, 0)
				* CFrame.new(0, 0.05, -1.45)
			camera.CFrame = CFrame.new(lens.Position) * gimbal.Rotation * vibration

			local menu = DroneState.menuOpen or DroneState.siteMenuOpen
			UserInputService.MouseBehavior = if menu
				then Enum.MouseBehavior.Default
				else Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = menu

			updateTarget(hull, camera)
		end
	)

	local sensorClock = 0
	RunService.Heartbeat:Connect(function(dt: number)
		sensorClock += dt
		if sensorClock >= 1 / 15 and drone.Parent then
			sensorClock = 0
			sense(hull)
		end
	end)

	while true do
		task.wait(0.2)
		if drone.Parent then
			slowUpdate(hull)
		end
	end
end

-- Exposed for the HUD
function Pilot.heading(): number
	return (360 - math.deg(yaw)) % 360
end

function Pilot.pitch(): number
	return math.deg(pitch)
end

function Pilot.roll(): number
	return math.deg(roll)
end

return Pilot
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Scanner</string>
              <string name="Source"><![CDATA[--!strict
-- Electronic detection. A ping wave sweeps outward from the drone. Every
-- electronic device it reaches is outlined through walls and tagged with its
-- device ID, type, status and raw block data, then fades after a few seconds.
-- People are not electronics: residents only show up on thermal.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Types = require(ReplicatedStorage.Shared.Types)
local DroneState = require(script.Parent.Parent.DroneState)
local Ui = require(script.Parent.Parent.Ui)

local SCAN = Config.SCAN
local theme = Ui.theme

local Scanner = {}

type Mark = { highlight: Highlight, label: BillboardGui, expires: number }

local marks: { [Instance]: Mark } = {}
local folder: Folder
local lastScan = -math.huge
local generation = 0

local function anchorPart(device: Instance): BasePart?
	if device:IsA("BasePart") then
		return device
	elseif device:IsA("Model") then
		return device.PrimaryPart or device:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

-- "Block ID": the raw Roblox instance data behind the device.
local function blockId(device: Instance): string
	local part = anchorPart(device)
	if not part then
		return "BLK " .. device.ClassName
	end
	local size = part.Size
	return ("BLK %s<%s:%s> %.1fx%.1fx%.1f"):format(
		device.ClassName,
		part.ClassName,
		part.Material.Name,
		size.X,
		size.Y,
		size.Z
	)
end

local function clearMark(device: Instance)
	local mark = marks[device]
	if mark then
		mark.highlight:Destroy()
		mark.label:Destroy()
		marks[device] = nil
	end
end

local function makeMark(device: Instance, color: Color3, spec: Types.DeviceSpec?)
	local part = anchorPart(device)
	if not part or not device.Parent then
		return
	end
	clearMark(device)

	local highlight = Instance.new("Highlight")
	highlight.Adornee = device
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.FillTransparency = 0.8
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0
	highlight.Parent = folder

	local label = Ui.create("BillboardGui", {
		Adornee = part,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(240, 66),
		StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0),
		MaxDistance = 250,
		LightInfluence = 0,
		Parent = folder,
	})
	Ui.create("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 3, 1, 0),
		Parent = label,
	})
	local function line(order: number, text: string, size: number, lineColor: Color3)
		Ui.label({
			Text = text,
			TextSize = size,
			TextColor3 = lineColor,
			TextStrokeTransparency = 0.3,
			Position = UDim2.fromOffset(8, (order - 1) * 15),
			Size = UDim2.new(1, -8, 0, 15),
			RichText = false,
			Parent = label,
		})
	end
	local id = tostring(device:GetAttribute("DeviceId") or "????")
	line(1, ("[%s] %s"):format(id, if spec then spec.label else "UNKNOWN"), 13, color)
	line(2, tostring(device:GetAttribute("Label") or device.Name), 12, theme.text)
	line(3, tostring(device:GetAttribute("Status") or ""), 11, theme.dim)
	line(4, blockId(device), 10, Color3.fromRGB(110, 120, 130))

	marks[device] =
		{ highlight = highlight, label = label, expires = os.clock() + SCAN.HOLD_SECONDS }
end

local function ping()
	local hull = DroneState.hull
	if not hull or os.clock() - lastScan < SCAN.COOLDOWN then
		return
	end
	lastScan = os.clock()
	generation += 1
	local thisGeneration = generation

	-- Expanding wave
	local wave = Instance.new("Part")
	wave.Shape = Enum.PartType.Ball
	wave.Material = Enum.Material.ForceField
	wave.Color = theme.cyan
	wave.Anchored = true
	wave.CanCollide = false
	wave.CanQuery = false
	wave.CanTouch = false
	wave.CastShadow = false
	wave.Size = Vector3.one * 2
	wave.CFrame = hull.CFrame
	wave.Parent = folder
	TweenService:Create(
		wave,
		TweenInfo.new(SCAN.WAVE_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.one * SCAN.RANGE * 2,
			Transparency = 1,
		}
	):Play()
	Debris:AddItem(wave, SCAN.WAVE_SECONDS + 0.1)

	-- Devices in range, nearest first, within the highlight budget
	type Hit = { device: Instance, distance: number }
	local hits: { Hit } = {}
	for _, device in CollectionService:GetTagged("Device") do
		local deviceType = Devices.typeOf(device)
		local spec = if deviceType then Config.DEVICES[deviceType] else nil
		if spec and spec.category ~= "Life" and device:IsDescendantOf(Workspace) then
			local distance = (Devices.position(device) - hull.Position).Magnitude
			if distance <= SCAN.RANGE then
				table.insert(hits, { device = device, distance = distance })
			end
		end
	end
	table.sort(hits, function(a, b)
		return a.distance < b.distance
	end)

	for device in marks do
		clearMark(device)
	end
	local count = math.min(#hits, SCAN.MAX_HIGHLIGHTS)
	DroneState.set("lastScanCount", count)
	DroneState.set("lastScanAt", os.clock())
	for i = 1, count do
		local hit = hits[i]
		local deviceType = Devices.typeOf(hit.device) :: string
		local spec = Config.DEVICES[deviceType]
		local color = Config.CATEGORY_COLORS[spec.category] or theme.cyan
		task.delay(hit.distance / SCAN.RANGE * SCAN.WAVE_SECONDS, function()
			if generation == thisGeneration then
				makeMark(hit.device, color, spec)
			end
		end)
	end
end

function Scanner.init()
	folder = Instance.new("Folder")
	folder.Name = "ScanFX"
	folder.Parent = Workspace
end

function Scanner.start()
	DroneState.Command.connect(function(name: string)
		if name == "Scan" then
			ping()
		end
	end)

	while true do
		task.wait(0.1)
		local now = os.clock()
		for device, mark in marks do
			local remaining = mark.expires - now
			if remaining <= 0 or not device.Parent then
				clearMark(device)
			elseif remaining < 1.5 then
				local fade = 1 - remaining / 1.5
				mark.highlight.OutlineTransparency = fade
				mark.highlight.FillTransparency = 0.8 + 0.2 * fade
			end
		end
	end
end

-- Seconds until the scanner is ready again (for the HUD).
function Scanner.cooldown(): number
	return math.max(0, SCAN.COOLDOWN - (os.clock() - lastScan))
end

return Scanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">SiteSelect</string>
              <string name="Source"><![CDATA[--!strict
-- Opening cinematic + site picker. While it runs, the camera tours the
-- Hollow (dome, Spire, the sealed deck, the Pit, the flooded collector, the
-- light coming down Shaft Zero) behind a title card. The same picker opens
-- later from [M]/[View] to switch sites or recall to the home dock.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local DroneState = require(script.Parent.Parent.DroneState)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Parent.Ui)

local player = Players.LocalPlayer

local SiteSelect = {}

local WHITE = Color3.fromRGB(236, 242, 240)
local DIM = Color3.fromRGB(150, 160, 156)
local ACCENT = Color3.fromRGB(255, 196, 70)

-- Camera tour of the Hollow, in site-local coordinates: { from, lookAt, seconds }
local TOUR: { { Vector3 } } = {
	{ Vector3.new(70, 215, 70), Vector3.new(0, 70, 0) },
	{ Vector3.new(-60, 150, 55), Vector3.new(0, 96, 0) },
	{ Vector3.new(-40, 98, -30), Vector3.new(12, 86, 0) },
	{ Vector3.new(30, 60, -55), Vector3.new(-60, 30, 20) },
	{ Vector3.new(-50, 22, -30), Vector3.new(-95, 10, 0) },
	{ Vector3.new(10, 10, 20), Vector3.new(0, -4, 64) },
	{ Vector3.new(-30, -18, 58), Vector3.new(90, -26, 60) },
	{ Vector3.new(4, 250, 4), Vector3.new(0, 430, 0) },
	{ Vector3.new(20, 445, 40), Vector3.new(46, 432, 23) },
}
local LEG_SECONDS = 6.5

type Option = { id: string, title: string, detail: string }

local gui: ScreenGui
local card: Frame
local optionLabels: { TextLabel } = {}
local options: { Option } = {}
local focus = 1
local touring = false
local fade: Frame

local function buildOptions(includeRecall: boolean)
	table.clear(options)
	for _, id in Config.SITE_ORDER do
		local spec = Config.SITES[id]
		table.insert(options, { id = id, title = spec.name, detail = spec.subtitle })
	end
	if includeRecall then
		table.insert(options, {
			id = "Recall",
			title = "RECALL TO HOME DOCK",
			detail = "Return to this site's charging dock",
		})
		table.insert(options, { id = "Close", title = "CLOSE", detail = "Back to the feed" })
	end
end

local function refresh()
	for index, label in optionLabels do
		local option = options[index]
		label.Visible = option ~= nil
		if option then
			local selected = index == focus
			label.Text = ('<font color="#%s">%s %s</font>\n<font color="#9AA59F" size="13">   %s</font>'):format(
				if selected then "FFC446" else "ECF2F0",
				if selected then "▶" else " ",
				option.title,
				option.detail
			)
			label.BackgroundTransparency = if selected then 0.55 else 0.8
		end
	end
end

local function build()
	gui = Ui.create("ScreenGui", {
		Name = "SiteSelect",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 20,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Letterbox
	for _, y in { 0, 1 } do
		Ui.create("Frame", {
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0.09, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Name = "Letterbox",
			Parent = gui,
		})
	end
	card = Ui.create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 60, 0.52, 0),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Ui.create(
		"UIListLayout",
		{ SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = card }
	)
	local function label(
		order: number,
		value: string,
		size: number,
		color: Color3,
		font: Enum.Font
	): TextLabel
		return Ui.create("TextLabel", {
			LayoutOrder = order,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = value,
			TextColor3 = color,
			TextSize = size,
			Font = font,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextStrokeTransparency = 0.6,
			RichText = true,
			Parent = card,
		})
	end
	label(1, "PATRIOT HACKFEST 2026 · LIFE UNDERGROUND", 14, ACCENT, Enum.Font.GothamBold)
	label(2, "HOLLOW DRONE", 54, WHITE, Enum.Font.GothamBlack)
	label(
		3,
		"Sector 9, the Hollow, 2087. Blackouts, sewage floods, a jammed network, a lung-sickness cluster the Directorate won't count, and a surface nobody is allowed to see. One inspection drone with swappable sensors goes where people can't.",
		16,
		DIM,
		Enum.Font.Gotham
	)
	local problems = {}
	for number in Config.PROBLEMS do
		table.insert(problems, number)
	end
	table.sort(problems)
	local tags = {}
	for _, number in problems do
		table.insert(tags, "#" .. number)
	end
	label(
		4,
		("Covers %d of the 15 Hollow problems: %s"):format(#problems, table.concat(tags, " ")),
		14,
		ACCENT,
		Enum.Font.RobotoMono
	)
	for index = 1, 4 do
		local option = label(4 + index, "", 18, WHITE, Enum.Font.RobotoMono)
		option.BackgroundColor3 = Color3.new(0, 0, 0)
		Ui.create("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			Parent = option,
		})
		table.insert(optionLabels, option)
	end
	label(9, " ", 6, DIM, Enum.Font.Gotham)
	local hintLabel = label(10, "", 14, DIM, Enum.Font.RobotoMono)
	hintLabel.Name = "Hint"
	fade = Ui.create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = gui,
	})
end

local function setHint()
	local hintLabel = card:FindFirstChild("Hint")
	if hintLabel and hintLabel:IsA("TextLabel") then
		hintLabel.Text = if DroneState.gamepad
			then "D-Pad ▲▼ choose   A deploy   B close"
			else "↑ ↓ choose   Enter / Click deploy   RMB close"
	end
end

local function runTour()
	touring = true
	local camera = Workspace.CurrentCamera
	local origin = Config.SITES.Hollow.origin
	task.spawn(function()
		local leg = 1
		while touring do
			local a = TOUR[leg]
			local b = TOUR[leg % #TOUR + 1]
			local startCf = CFrame.lookAt(origin + a[1], origin + a[2])
			local endCf = CFrame.lookAt(origin + b[1], origin + b[2])
			local cut = (b[1] - a[1]).Magnitude > 160
			local t0 = os.clock()
			while touring and os.clock() - t0 < LEG_SECONDS do
				local alpha = (os.clock() - t0) / LEG_SECONDS
				camera.CameraType = Enum.CameraType.Scriptable
				camera.FieldOfView = 62
				if cut then
					-- Long jumps are hard cuts with a slow push-in, like an edit
					camera.CFrame = endCf:Lerp(endCf * CFrame.new(0, 0, -6), alpha)
				else
					local eased = alpha * alpha * (3 - 2 * alpha)
					camera.CFrame = startCf:Lerp(endCf, eased)
				end
				RunService.RenderStepped:Wait()
			end
			leg = leg % #TOUR + 1
		end
	end)
end

local function open(withTour: boolean)
	buildOptions(not withTour)
	focus = 1
	if not withTour then
		local index = table.find(Config.SITE_ORDER, DroneState.site)
		focus = index or 1
	end
	DroneState.set("siteMenuOpen", true)
	gui.Enabled = true
	for _, child in gui:GetChildren() do
		if child.Name == "Letterbox" and child:IsA("Frame") then
			child.Visible = withTour
		end
	end
	card.BackgroundTransparency = if withTour then 1 else 0.35
	card.BackgroundColor3 = Color3.new(0, 0, 0)
	setHint()
	refresh()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

local function close()
	touring = false
	DroneState.set("siteMenuOpen", false)
	gui.Enabled = false
	if DroneState.cinematic then
		fade.BackgroundTransparency = 0
		DroneState.set("cinematic", false)
		TweenService:Create(fade, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
		gui.Enabled = true
		card.Visible = false
		for _, child in gui:GetChildren() do
			if child.Name == "Letterbox" and child:IsA("Frame") then
				child.Visible = false
			end
		end
		task.delay(1.3, function()
			gui.Enabled = DroneState.siteMenuOpen
			card.Visible = true
		end)
	end
end

local function confirm()
	local option = options[focus]
	if not option then
		return
	end
	if option.id == "Recall" then
		Net.fire("Recall")
		close()
	elseif option.id == "Close" then
		close()
	else
		Net.fire("SelectSite", option.id)
		if DroneState.cinematic then
			fade.BackgroundTransparency = 1
			TweenService:Create(fade, TweenInfo.new(0.4), { BackgroundTransparency = 0 }):Play()
			task.delay(0.6, close)
		else
			close()
		end
	end
end

function SiteSelect.init()
	build()
end

function SiteSelect.start()
	DroneState.waitForDrone()
	-- Give the terrain and the world a moment to stream in, then fade up
	task.wait(1)
	runTour()
	open(true)
	TweenService:Create(fade, TweenInfo.new(2.5), { BackgroundTransparency = 1 }):Play()

	DroneState.Command.connect(function(name: string, direction: string?)
		if name == "ToggleSites" then
			if DroneState.cinematic or DroneState.menuOpen then
				return
			end
			if DroneState.siteMenuOpen then
				close()
			else
				open(false)
			end
			return
		end
		if not DroneState.siteMenuOpen then
			return
		end
		if name == "MenuNav" then
			if direction == "Up" then
				focus = math.max(1, focus - 1)
			elseif direction == "Down" then
				focus = math.min(#options, focus + 1)
			end
			refresh()
		elseif name == "MenuConfirm" then
			confirm()
		elseif name == "MenuBack" and not DroneState.cinematic then
			close()
		end
	end)
	DroneState.Changed.connect(function(key: string)
		if key == "gamepad" then
			setHint()
		end
	end)
	-- Mouse: hovering an option focuses it; the click itself is the Primary bind
	for index, label in optionLabels do
		label.MouseEnter:Connect(function()
			if DroneState.siteMenuOpen and options[index] then
				focus = index
				refresh()
			end
		end)
	end
end

return SiteSelect
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Vision</string>
              <string name="Source"><![CDATA[--!strict
-- Camera modes and screen effects, all local to this pilot.
--   NORMAL  - clean feed
--   THERMAL - world goes cold blue; heat signatures glow (through thin walls up close)
--   NIGHT   - green low-light amplification
--   CHEM    - needs the Sensor Pod; makes invisible gas clouds visible
--   LIDAR   - the spinning LiDAR puck builds a live point cloud (SLAM map),
--             rendered on black like a real survey viewer
-- Plus per-site lighting/atmosphere, a camera grade, scanlines, vignette and
-- signal static when the command link is weak.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Devices = require(ReplicatedStorage.Shared.Util.Devices)
local Units = require(ReplicatedStorage.Shared.Util.Units)
local Types = require(ReplicatedStorage.Shared.Types)
local DroneState = require(script.Parent.Parent.DroneState)
local Ui = require(script.Parent.Parent.Ui)

local THERMAL = Config.THERMAL
local player = Players.LocalPlayer

local Vision = {}

type Preset = {
	tint: Color3,
	brightness: number,
	contrast: number,
	saturation: number,
	ambient: Color3?,
	exposure: number?,
	bloom: number,
	scanlines: boolean,
}

local PRESETS: { [string]: Preset } = {
	Normal = {
		-- A real sensor: slightly flat, a touch cool, mild highlight bloom
		tint = Color3.fromRGB(246, 250, 255),
		brightness = 0.01,
		contrast = 0.12,
		saturation = -0.18,
		bloom = 0.35,
		scanlines = false,
	},
	Thermal = {
		tint = Color3.fromRGB(90, 110, 235),
		brightness = -0.02,
		contrast = 0.35,
		saturation = -1,
		ambient = Color3.fromRGB(80, 80, 95),
		exposure = 0.6,
		bloom = 0.9,
		scanlines = true,
	},
	Night = {
		tint = Color3.fromRGB(110, 255, 140),
		brightness = 0.18,
		contrast = 0.22,
		saturation = -1,
		ambient = Color3.fromRGB(105, 115, 105),
		exposure = 1.1,
		bloom = 1.3,
		scanlines = true,
	},
	Chem = {
		tint = Color3.fromRGB(220, 205, 255),
		brightness = 0.02,
		contrast = 0.15,
		saturation = -0.85,
		ambient = Color3.fromRGB(40, 40, 52),
		bloom = 0.6,
		scanlines = false,
	},
	Lidar = {
		tint = Color3.fromRGB(255, 255, 255),
		brightness = 0,
		contrast = 0,
		saturation = 0,
		bloom = 0.8,
		scanlines = false,
	},
}

local correction: ColorCorrectionEffect
local bloom: BloomEffect
local sunRays: SunRaysEffect
local atmosphere: Atmosphere
local siteLighting: Types.SiteLighting = Config.SITES[Config.DEFAULT_SITE].lighting
local scanlines: Frame
local staticLayer: Frame
local noise: { Frame } = {}
local linkLabel: TextLabel

type ThermalSlot = { highlight: Highlight, label: BillboardGui, text: TextLabel }
local slots: { ThermalSlot } = {}
local thermalFolder: Folder

---------------------------------------------------------------------------
-- Thermal
---------------------------------------------------------------------------

local RAMP: { { number } } = {
	-- temperature, r, g, b
	{ 20, 30, 0, 60 },
	{ 30, 120, 10, 70 },
	{ 34, 210, 40, 30 },
	{ 37, 255, 140, 0 },
	{ 39, 255, 235, 80 },
	{ 45, 255, 255, 255 },
}

function Vision.heatColor(temperature: number): Color3
	if temperature <= RAMP[1][1] then
		return Color3.fromRGB(RAMP[1][2], RAMP[1][3], RAMP[1][4])
	end
	for i = 2, #RAMP do
		local high = RAMP[i]
		if temperature <= high[1] then
			local low = RAMP[i - 1]
			local t = (temperature - low[1]) / (high[1] - low[1])
			return Color3.fromRGB(low[2], low[3], low[4])
				:Lerp(Color3.fromRGB(high[2], high[3], high[4]), t)
		end
	end
	return Color3.new(1, 1, 1)
end

local function hideSlot(slot: ThermalSlot)
	slot.highlight.Enabled = false
	slot.highlight.Adornee = nil
	slot.label.Enabled = false;
	(slot.label :: any).Adornee = nil
end

local function thermalStep()
	local hull = DroneState.hull
	if not hull then
		return
	end
	type Source = { instance: Instance, temperature: number, distance: number }
	local sources: { Source } = {}
	local function consider(instance: Instance)
		local temperature = instance:GetAttribute("Temperature")
		if
			typeof(temperature) == "number"
			and temperature >= 28
			and instance ~= DroneState.drone
		then
			local distance = (Devices.position(instance) - hull.Position).Magnitude
			if distance <= THERMAL.RANGE then
				table.insert(
					sources,
					{ instance = instance, temperature = temperature, distance = distance }
				)
			end
		end
	end
	for _, instance in CollectionService:GetTagged("Device") do
		consider(instance)
	end
	for _, instance in CollectionService:GetTagged("Drone") do
		consider(instance)
	end
	for _, part in CollectionService:GetTagged("Heat") do
		local temperature = part:GetAttribute("Temperature")
		if typeof(temperature) == "number" and part:IsA("BasePart") then
			local distance = (part.Position - hull.Position).Magnitude
			if distance <= THERMAL.RANGE then
				-- Background people light up as a whole body
				local target: Instance = part
				local parent = part.Parent
				if parent and parent:IsA("Model") and parent.Name == "Bystander" then
					target = parent
				end
				table.insert(
					sources,
					{ instance = target, temperature = temperature, distance = distance }
				)
			end
		end
	end
	-- People and the hottest things matter most, then distance
	table.sort(sources, function(a, b)
		local aLife = a.instance:GetAttribute("DeviceType") == "Resident"
			or a.instance.Name == "Bystander"
		local bLife = b.instance:GetAttribute("DeviceType") == "Resident"
			or b.instance.Name == "Bystander"
		if aLife ~= bLife then
			return aLife
		end
		return a.distance < b.distance
	end)

	for index, slot in slots do
		local source = sources[index]
		if not source then
			hideSlot(slot)
		else
			local color = Vision.heatColor(source.temperature)
			slot.highlight.Adornee = source.instance
			slot.highlight.FillColor = color
			slot.highlight.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.5)
			slot.highlight.DepthMode = if source.distance <= THERMAL.THROUGH_WALL_RANGE
				then Enum.HighlightDepthMode.AlwaysOnTop
				else Enum.HighlightDepthMode.Occluded
			slot.highlight.Enabled = true

			local anchor = if source.instance:IsA("Model")
				then (source.instance :: Model).PrimaryPart
				else source.instance
			if anchor and anchor:IsA("BasePart") then
				slot.label.Adornee = anchor
				slot.label.Enabled = true
				local isPerson = source.instance:GetAttribute("DeviceType") == "Resident"
				local identified = source.instance:GetAttribute("Located") == true
				slot.text.Text = ("%s%s"):format(
					Units.temp(source.temperature),
					if isPerson
						then (if identified
							then "  " .. tostring(source.instance:GetAttribute("Label"))
							else "  LIFESIGN?")
						else ""
				)
				slot.text.TextColor3 = color
			end
		end
	end
end

---------------------------------------------------------------------------
-- Modes
---------------------------------------------------------------------------

local function setGasVisible(visible: boolean)
	for _, cloud in CollectionService:GetTagged("GasCloud") do
		if cloud:IsA("BasePart") then
			cloud.Transparency = if visible then 0.78 else 1
		end
	end
end

local function apply(mode: string)
	local preset = PRESETS[mode] or PRESETS.Normal
	correction.TintColor = preset.tint
	correction.Brightness = preset.brightness
	correction.Contrast = preset.contrast
	correction.Saturation = preset.saturation
	bloom.Intensity = preset.bloom
	Lighting.Ambient = preset.ambient or siteLighting.ambient
	Lighting.ExposureCompensation = siteLighting.exposure + (preset.exposure or 0)
	scanlines.Visible = preset.scanlines
	setGasVisible(mode == "Chem")
	Vision.setLidarVisible(mode == "Lidar")
	if mode ~= "Thermal" then
		for _, slot in slots do
			hideSlot(slot)
		end
	end
end

local function cycle()
	local modes = Config.CAMERA_MODES
	local index = table.find(modes, DroneState.cameraMode) or 1
	for _ = 1, #modes do
		index = index % #modes + 1
		local candidate = modes[index]
		if candidate ~= "Chem" or DroneState.hasModule("Sensor") then
			DroneState.set("cameraMode", candidate)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Site lighting (the Hollow has a real sun far above; the range is sealed)
---------------------------------------------------------------------------

local function applySite(site: string, instant: boolean)
	local spec = Config.SITES[site] or Config.SITES[Config.DEFAULT_SITE]
	siteLighting = spec.lighting
	local info = TweenInfo.new(if instant then 0 else 1.5)
	TweenService:Create(Lighting, info, {
		Brightness = siteLighting.brightness,
		ClockTime = siteLighting.clockTime,
		OutdoorAmbient = siteLighting.outdoorAmbient,
	}):Play()
	TweenService:Create(atmosphere, info, {
		Density = siteLighting.density,
		Haze = siteLighting.haze,
		Glare = siteLighting.glare,
		Color = siteLighting.atmosphereColor,
		Decay = siteLighting.decay,
	}):Play()
	Lighting.GeographicLatitude = 0
	apply(DroneState.cameraMode)
end

---------------------------------------------------------------------------
-- LiDAR SLAM point cloud
---------------------------------------------------------------------------

local lidarGui: ScreenGui
local lidarViewport: ViewportFrame
local lidarCamera: Camera
local lidarPool: { Part } = {}
local lidarNext = 1
local lidarCount = 0
local lidarBudget = 0
local lidarParams = RaycastParams.new()
lidarParams.FilterType = Enum.RaycastFilterType.Exclude

local function buildLidar()
	lidarGui = Ui.create("ScreenGui", {
		Name = "LidarView",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 0,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	lidarViewport = Ui.create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(2, 3, 6),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(255, 255, 255),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(0, -1, 0),
		Parent = lidarGui,
	})
	lidarCamera = Instance.new("Camera")
	lidarCamera.Parent = lidarViewport
	lidarViewport.CurrentCamera = lidarCamera
	for _ = 1, Config.DRONE.LIDAR_POINTS do
		local point = Instance.new("Part")
		point.Anchored = true
		point.CanCollide = false
		point.CanQuery = false
		point.CanTouch = false
		point.CastShadow = false
		point.Material = Enum.Material.Neon
		point.Size = Vector3.new(0.2, 0.2, 0.2)
		point.CFrame = CFrame.new(0, -1e5, 0)
		point.Parent = lidarViewport
		table.insert(lidarPool, point)
	end
end

function Vision.setLidarVisible(visible: boolean)
	if lidarGui then
		lidarGui.Enabled = visible
	end
end

local function lidarStep(dt: number)
	local hull = DroneState.hull
	if not hull or DroneState.cinematic then
		return
	end
	lidarBudget += dt * Config.DRONE.LIDAR_RATE
	local count = math.floor(lidarBudget)
	lidarBudget -= count
	if count <= 0 then
		return
	end
	lidarParams.FilterDescendantsInstances = { Workspace:FindFirstChild("Drones") or hull }
	local origin = hull.Position + Vector3.new(0, 0.9, 0)
	local range = Config.DRONE.LIDAR_RANGE
	for _ = 1, math.min(count, 60) do
		local azimuth = math.random() * math.pi * 2
		local elevation = math.rad(-60 + math.random() * 100)
		local direction = (CFrame.Angles(0, azimuth, 0) * CFrame.Angles(elevation, 0, 0)).LookVector
		local hit = Workspace:Raycast(origin, direction * range, lidarParams)
		if hit then
			local point = lidarPool[lidarNext]
			point.CFrame = CFrame.new(hit.Position)
			local band = (hit.Position.Y / 36) % 1
			local closeness = 1 - math.clamp(hit.Distance / range, 0, 1) * 0.45
			point.Color = Color3.fromHSV(0.62 - band * 0.62, 0.8, closeness)
			lidarNext = lidarNext % #lidarPool + 1
			lidarCount = math.min(lidarCount + 1, #lidarPool)
		end
	end
	DroneState.lidarPoints = lidarCount
	if lidarGui.Enabled then
		local camera = Workspace.CurrentCamera
		lidarCamera.CFrame = camera.CFrame
		lidarCamera.FieldOfView = camera.FieldOfView
	end
end

---------------------------------------------------------------------------
-- Overlays
---------------------------------------------------------------------------

local function buildOverlay()
	local screen = Ui.create("ScreenGui", {
		Name = "VisionOverlay",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 1,
		Parent = player:WaitForChild("PlayerGui"),
	})

	scanlines = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = screen,
	})
	for i = 0, 59 do
		Ui.create("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0, i / 60),
			Size = UDim2.new(1, 0, 0, 1),
			Parent = scanlines,
		})
	end

	-- Vignette: four gradient edges
	local edges = {
		{ position = UDim2.fromScale(0, 0), size = UDim2.fromScale(1, 0.18), rotation = 90 },
		{ position = UDim2.fromScale(0, 0.82), size = UDim2.fromScale(1, 0.18), rotation = -90 },
		{ position = UDim2.fromScale(0, 0), size = UDim2.fromScale(0.14, 1), rotation = 0 },
		{ position = UDim2.fromScale(0.86, 0), size = UDim2.fromScale(0.14, 1), rotation = 180 },
	}
	for _, edge in edges do
		local frame = Ui.create("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Position = edge.position,
			Size = edge.size,
			Parent = screen,
		})
		Ui.create("UIGradient", {
			Rotation = edge.rotation,
			Transparency = NumberSequence.new(0.25, 1),
			Parent = frame,
		})
	end

	staticLayer = Ui.create("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = screen,
	})
	for _ = 1, 90 do
		table.insert(
			noise,
			Ui.create("Frame", { BorderSizePixel = 0, Visible = false, Parent = staticLayer })
		)
	end
	linkLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(500, 40),
		Font = Enum.Font.GothamBlack,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Ui.theme.bad,
		TextStrokeTransparency = 0.4,
		RichText = false,
		Visible = false,
		Parent = screen,
	})
end

local rng = Random.new()

local function staticStep()
	local link = DroneState.link
	local intensity = math.clamp(1 - link / Config.LINK.WEAK, 0, 1) * 0.6
	staticLayer.BackgroundTransparency = 1 - intensity * 0.3
	for _, frame in noise do
		if rng:NextNumber() < intensity * 0.7 then
			frame.Visible = true
			frame.Position = UDim2.fromScale(rng:NextNumber(-0.1, 1), rng:NextNumber())
			frame.Size = UDim2.new(rng:NextNumber(0.02, 0.3), 0, 0, rng:NextInteger(1, 4))
			local shade = rng:NextNumber(0.4, 1)
			frame.BackgroundColor3 = Color3.new(shade, shade, shade)
			frame.BackgroundTransparency = 1 - intensity * rng:NextNumber(0.3, 0.8)
		else
			frame.Visible = false
		end
	end
	if link < Config.LINK.LOST then
		linkLabel.Visible = os.clock() % 1 < 0.6
		linkLabel.Text = "LINK LOST // NO COMMAND UPLINK"
	elseif link < Config.LINK.WEAK then
		linkLabel.Visible = true
		linkLabel.Text = ("SIGNAL WEAK %d%%"):format(math.floor(link * 100))
		linkLabel.TextSize = 20
	else
		linkLabel.Visible = false
		linkLabel.TextSize = 30
	end
end

---------------------------------------------------------------------------

function Vision.init()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Offset = 0
	atmosphere.Parent = Lighting
	sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.06
	sunRays.Spread = 0.7
	sunRays.Parent = Lighting
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "VisionCorrection"
	correction.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Name = "VisionBloom"
	bloom.Threshold = 1.1
	bloom.Size = 24
	bloom.Parent = Lighting

	thermalFolder = Instance.new("Folder")
	thermalFolder.Name = "ThermalFX"
	thermalFolder.Parent = Workspace
	for _ = 1, THERMAL.MAX_HIGHLIGHTS do
		local highlight = Instance.new("Highlight")
		highlight.FillTransparency = 0.1
		highlight.OutlineTransparency = 0.4
		highlight.Enabled = false
		highlight.Parent = thermalFolder
		local label = Ui.create("BillboardGui", {
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(200, 20),
			StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
			MaxDistance = THERMAL.RANGE,
			LightInfluence = 0,
			Enabled = false,
			Parent = thermalFolder,
		})
		local text = Ui.label({
			Size = UDim2.fromScale(1, 1),
			TextSize = 14,
			Font = Ui.theme.fontBold,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 0.2,
			RichText = false,
			Parent = label,
		})
		table.insert(slots, { highlight = highlight, label = label, text = text })
	end

	buildOverlay()
	buildLidar()
	applySite(Config.DEFAULT_SITE, true)
end

function Vision.start()
	DroneState.Command.connect(function(name: string)
		if name == "CycleCamera" then
			cycle()
		end
	end)
	DroneState.Changed.connect(function(key: string)
		if key == "cameraMode" then
			apply(DroneState.cameraMode)
		elseif key == "site" then
			applySite(DroneState.site, false)
		end
	end)

	local drone = DroneState.waitForDrone()
	local function checkModules()
		if DroneState.cameraMode == "Chem" and not DroneState.hasModule("Sensor") then
			DroneState.set("cameraMode", "Normal")
		end
	end
	drone:GetAttributeChangedSignal("HardpointA"):Connect(checkModules)
	drone:GetAttributeChangedSignal("HardpointB"):Connect(checkModules)

	RunService.RenderStepped:Connect(function(dt: number)
		staticStep()
		lidarStep(dt)
	end)

	while true do
		task.wait(0.25)
		if DroneState.cameraMode == "Thermal" then
			thermalStep()
		end
	end
end

return Vision
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">DroneState</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side pilot state shared by every controller, plus a command bus so
-- input bindings (in Pilot) stay decoupled from the systems they trigger.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local player = Players.LocalPlayer

local DroneState = {
	drone = nil :: Model?,
	hull = nil :: BasePart?,

	activeHardpoint = "A",
	cameraMode = "Normal",
	headlights = true,
	boosting = false,
	gamepad = false,

	battery = 100,
	link = 1,
	speed = 0,
	docked = false,

	-- Flight telemetry (written by Pilot every frame)
	site = "Hollow",
	agl = 0, -- height above whatever is below (studs)
	verticalSpeed = 0,
	groundSpeed = 0,
	voltage = 25.2,
	current = 0, -- amps
	throttle = 0, -- 0..1
	wind = Vector3.zero,
	tilt = 0, -- degrees
	obstacles = {
		front = math.huge,
		back = math.huge,
		left = math.huge,
		right = math.huge,
		up = math.huge,
		down = math.huge,
	},
	avoiding = false,
	flightSeconds = 0,
	lidarPoints = 0,

	-- Intro cinematic / site picker owns the camera while true
	cinematic = true,

	-- What the reticle is on (device root) and how far away it is
	target = nil :: Instance?,
	targetDistance = math.huge,
	targetInRange = false,

	lastScanCount = 0,
	lastScanAt = -math.huge,

	menuOpen = false,
	siteMenuOpen = false,
	logOpen = true,
	helpOpen = true,

	-- fired(command: string, ...) e.g. "Scan", "CycleCamera", "ToggleMenu", "MenuNav"
	Command = Signal.new(),
	-- fired(key: string) when a state field changes through DroneState.set
	Changed = Signal.new(),
}

function DroneState.set(key: string, value: any)
	local state = DroneState :: any
	if state[key] ~= value then
		state[key] = value
		DroneState.Changed.fire(key)
	end
end

-- Module installed on a hardpoint ("A"/"B"); defaults to the active one.
function DroneState.module(hardpoint: string?): string?
	local drone = DroneState.drone
	if not drone then
		return nil
	end
	local value = drone:GetAttribute("Hardpoint" .. (hardpoint or DroneState.activeHardpoint))
	return if typeof(value) == "string" then value else nil
end

function DroneState.hasModule(module: string): boolean
	return DroneState.module("A") == module or DroneState.module("B") == module
end

-- Blocks until this pilot's drone exists, then caches it.
function DroneState.waitForDrone(): Model
	local folder = Workspace:WaitForChild("Drones")
	local drone = folder:WaitForChild("Drone_" .. player.UserId) :: Model
	local hull = drone:WaitForChild("Hull") :: BasePart
	DroneState.drone = drone
	DroneState.hull = hull
	return drone
end

return DroneState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client side of the remote API. The client never creates remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

type RemoteName = Remotes.RemoteName

local folder = ReplicatedStorage:WaitForChild("Remotes")

local function remote(name: RemoteName): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

local Net = {}

function Net.on(name: RemoteName, handler: (...any) -> ()): RBXScriptConnection
	return remote(name).OnClientEvent:Connect(handler)
end

function Net.fire(name: RemoteName, ...: any)
	remote(name):FireServer(...)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny declarative helper for building UI in code, plus the shared HUD theme.

local Ui = {}

Ui.theme = table.freeze({
	panel = Color3.fromRGB(4, 10, 14),
	panelAlpha = 0.35,
	stroke = Color3.fromRGB(0, 230, 255),
	text = Color3.fromRGB(200, 245, 255),
	dim = Color3.fromRGB(100, 150, 165),
	amber = Color3.fromRGB(255, 176, 0),
	cyan = Color3.fromRGB(0, 230, 255),
	magenta = Color3.fromRGB(255, 40, 140),
	good = Color3.fromRGB(90, 255, 150),
	warn = Color3.fromRGB(255, 190, 60),
	bad = Color3.fromRGB(255, 70, 90),
	info = Color3.fromRGB(140, 200, 255),
	font = Enum.Font.RobotoMono,
	fontBold = Enum.Font.GothamBold,
})

-- create("TextLabel", { Text = "hi" }, { child1, child2 })
function Ui.create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = (Instance.new :: any)(className)
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.panel(props: { [string]: any }, children: { Instance }?): Frame
	local theme = Ui.theme
	local merged: { [string]: any } = {
		BackgroundColor3 = theme.panel,
		BackgroundTransparency = theme.panelAlpha,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	local frame = Ui.create("Frame", merged, children)
	Ui.create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = frame })
	Ui.create(
		"UIStroke",
		{ Color = theme.stroke, Transparency = 0.6, Thickness = 1, Parent = frame }
	)
	Ui.create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = frame,
	})
	return frame
end

function Ui.label(props: { [string]: any }): TextLabel
	local theme = Ui.theme
	local merged: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = theme.font,
		TextColor3 = theme.text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 18),
		RichText = true,
	}
	for key, value in props do
		merged[key] = value
	end
	return Ui.create("TextLabel", merged)
end

-- Green -> amber -> red as a 0..1 "goodness" falls.
function Ui.healthColor(goodness: number): Color3
	local theme = Ui.theme
	if goodness >= 0.6 then
		return theme.good
	elseif goodness >= 0.35 then
		return theme.warn
	end
	return theme.bad
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="45">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>